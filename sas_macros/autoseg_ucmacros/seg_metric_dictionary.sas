/* ============================================================================
   seg_metric_dictionary.sas  -  GENERATED by parity/gen_dictionary.py (edit the list there).
   Data dictionary for every output column: short label + plain meaning / formula.
   seg_apply_labels uses it to attach SAS column labels to every output table so the
   tables explain themselves wherever they are opened.
   ============================================================================ */
%macro seg_metric_dictionary(out=seg_metric_dictionary);
    data &out;
        length column_name $40 label $80 meaning $500;
        column_name = "Technique"; label = "Technique"; meaning = "Which technique discovered the segment or produced the run-log row"; output;
        column_name = "Rank"; label = "Rank within technique"; meaning = "Position after ranking: statistically significant segments first then by Severity_Score. Comparable only within one technique"; output;
        column_name = "Segment_Definition"; label = "Segment definition"; meaning = "Readable rule that defines the segment. Cut-offs are rounded to 2 decimals for display - the exact values are in the rules table"; output;
        column_name = "Segment_Summary"; label = "Plain-English summary"; meaning = "One paragraph: size of the segment in development vs monitoring and how Gini KS and default rate moved and the feature that drifted most"; output;
        column_name = "Segment_Where_Clause"; label = "Executable SAS WHERE clause"; meaning = "The rule as a SAS WHERE expression with exact cut-offs. Apply with WHERE= to select the segment rows"; output;
        column_name = "Membership_Type"; label = "How membership is decided"; meaning = "EXACT_RULE: a row is in the segment exactly when it satisfies the rule. NEAREST_CENTROID: K-Means membership is the nearest cluster centre and the rule only describes it"; output;
        column_name = "Membership_Note"; label = "Missing-value treatment"; meaning = "How missing values of numeric features are treated for this technique"; output;
        column_name = "cand_id"; label = "Candidate id"; meaning = "Internal candidate number - joins the segments rules and feature_psi tables"; output;
        column_name = "Dev_Count"; label = "Rows in dev"; meaning = "Number of development rows inside the segment"; output;
        column_name = "Mon_Count"; label = "Rows in monitoring"; meaning = "Number of monitoring rows inside the segment"; output;
        column_name = "Dev_Pct"; label = "Share of dev population"; meaning = "Dev_Count divided by all development rows"; output;
        column_name = "Mon_Pct"; label = "Share of monitoring population"; meaning = "Mon_Count divided by all monitoring rows"; output;
        column_name = "x_dev"; label = "Defaults in dev"; meaning = "Number of defaults (events) in the segment - development"; output;
        column_name = "x_mon"; label = "Defaults in monitoring"; meaning = "Number of defaults (events) in the segment - monitoring"; output;
        column_name = "PSI"; label = "PSI (segment size or feature drift)"; meaning = "In the segments table: population stability index of the segment size = (Mon_Pct - Dev_Pct) x ln(Mon_Pct / Dev_Pct). In the feature_psi table: PSI of that feature inside the segment. Below 0.10 stable. 0.10 to 0.25 moderate shift. Above 0.25 significant shift"; output;
        column_name = "PSI_Interpretation"; label = "PSI reading"; meaning = "Stable / Moderate Drift / Significant Drift according to PSI"; output;
        column_name = "Dev_BR"; label = "Default rate dev"; meaning = "Defaults divided by rows in development"; output;
        column_name = "Mon_BR"; label = "Default rate monitoring"; meaning = "Defaults divided by rows in monitoring"; output;
        column_name = "Delta_BR"; label = "Default rate change"; meaning = "Mon_BR minus Dev_BR. Positive means more defaults than at development"; output;
        column_name = "br_pvalue"; label = "p-value default rate change"; meaning = "Two-sided z-test p-value that the dev and monitoring default rates are equal (small = real change)"; output;
        column_name = "BadRate_pvalue_adj"; label = "Adjusted p-value default rate"; meaning = "br_pvalue after Benjamini-Hochberg correction for the many segments tested"; output;
        column_name = "Dev_AUC"; label = "AUC dev"; meaning = "Area under the ROC curve of the model score inside the segment - development"; output;
        column_name = "Mon_AUC"; label = "AUC monitoring"; meaning = "Area under the ROC curve inside the segment - monitoring"; output;
        column_name = "Delta_AUC"; label = "AUC change"; meaning = "Mon_AUC minus Dev_AUC. Negative means the model separates defaults worse"; output;
        column_name = "Dev_Gini"; label = "Gini dev"; meaning = "2 x AUC - 1 in development"; output;
        column_name = "Mon_Gini"; label = "Gini monitoring"; meaning = "2 x AUC - 1 in monitoring"; output;
        column_name = "Delta_Gini"; label = "Gini change"; meaning = "Mon_Gini minus Dev_Gini. Negative means deterioration"; output;
        column_name = "Dev_KS"; label = "KS dev"; meaning = "Largest gap between the cumulative score distributions of defaults and non-defaults - development"; output;
        column_name = "Mon_KS"; label = "KS monitoring"; meaning = "Same measure in monitoring"; output;
        column_name = "Delta_KS"; label = "KS change"; meaning = "Mon_KS minus Dev_KS. Negative means deterioration"; output;
        column_name = "score_shift_pvalue"; label = "p-value score distribution shift"; meaning = "Two-sample Kolmogorov-Smirnov p-value that the model score distribution differs between development and monitoring inside the segment"; output;
        column_name = "ScoreShift_pvalue_adj"; label = "Adjusted p-value score shift"; meaning = "score_shift_pvalue after Benjamini-Hochberg correction"; output;
        column_name = "Calibration_Drift"; label = "Calibration drift (A/E shift)"; meaning = "Actual-to-expected default ratio in monitoring minus the same ratio in development. Expected defaults = sum of model scores"; output;
        column_name = "Dev_EAD"; label = "Exposure dev"; meaning = "Sum of the exposure column inside the segment - development"; output;
        column_name = "Mon_EAD"; label = "Exposure monitoring"; meaning = "Sum of the exposure column inside the segment - monitoring"; output;
        column_name = "Dev_Exposure_Pct"; label = "Share of dev exposure"; meaning = "Segment exposure divided by total development exposure"; output;
        column_name = "Mon_Exposure_Pct"; label = "Share of monitoring exposure"; meaning = "Segment exposure divided by total monitoring exposure"; output;
        column_name = "Exposure_Drift"; label = "Exposure share change"; meaning = "Mon_Exposure_Pct minus Dev_Exposure_Pct"; output;
        column_name = "mean_feature_psi"; label = "Average feature drift inside segment"; meaning = "Mean PSI over all features comparing the segment rows of development with the segment rows of monitoring"; output;
        column_name = "Root_Cause_Feature"; label = "Main drifting feature"; meaning = "Feature with the highest PSI inside the segment - a candidate driver and not proof of cause. For Feature Binning it is the feature that defines the bin"; output;
        column_name = "Root_Cause_PSI"; label = "PSI of main drifting feature"; meaning = "PSI of Root_Cause_Feature inside the segment. For Feature Binning the size-shift PSI of the bin"; output;
        column_name = "mean_shap_shift"; label = "Average SHAP shift"; meaning = "Mean absolute change of the average SHAP value across SHAP columns inside the segment"; output;
        column_name = "Statistically_Significant"; label = "Statistically significant"; meaning = "1 when the adjusted default-rate p-value or the adjusted score-shift p-value is at or below alpha"; output;
        column_name = "Business_Impact_Score"; label = "Business impact"; meaning = "(Mon_Pct x Mon_Exposure_Pct) x (1 + PSI + Gini drop). Used to choose between parameter settings"; output;
        column_name = "SIS_Raw"; label = "Segment Impact Score"; meaning = "AUC drop x exposure share x Mon_Pct x Confidence_Score"; output;
        column_name = "DIS_Raw"; label = "Drift Impact Score"; meaning = "(Mon_Pct - Dev_Pct) x AUC drop x exposure share x (1 + mean_feature_psi) floored at 0"; output;
        column_name = "DIS_Symmetric"; label = "Drift Impact Score symmetric"; meaning = "Like DIS_Raw but with the absolute population change so shrinking segments also count"; output;
        column_name = "Confidence_Score"; label = "Sample-size confidence"; meaning = "Square root of (Mon_Count / 100) capped at 1"; output;
        column_name = "Root_Cause_Score"; label = "Root cause score"; meaning = "0.35 x SIS + 0.30 x DIS + 0.20 x mean_feature_psi + 0.15 x mean_shap_shift each scaled 0 to 1 across the candidates of this run. Larger = more likely a main driver of the decline"; output;
        column_name = "Severity_Score"; label = "Severity score"; meaning = "Root_Cause_Score x 20. Used for ranking inside one technique only"; output;
        column_name = "Portfolio_Impact_Score"; label = "Portfolio impact"; meaning = "Mon_Pct x absolute Gini change"; output;
        column_name = "Drift_Explanation"; label = "Why it was flagged"; meaning = "Automatic reasons: size shift Gini or KS drop significant default-rate shift or hidden concept drift"; output;
        column_name = "Leaf_ID"; label = "Tree node id"; meaning = "Node number of the tree leaf the segment comes from"; output;
        column_name = "Tree_Idx"; label = "Tree number"; meaning = "Which boosted tree the segment comes from"; output;
        column_name = "Cluster_ID"; label = "Cluster number"; meaning = "K-Means cluster the segment comes from"; output;
        column_name = "Rule_Precision"; label = "Rule precision"; meaning = "Share of rows matching the rule that really belong to the cluster"; output;
        column_name = "Rule_Recall"; label = "Rule recall"; meaning = "Share of the cluster rows that match the rule"; output;
        column_name = "Feature"; label = "Feature"; meaning = "Feature a bin or condition is built on (Feature Binning segments and the rules and feature_psi tables)"; output;
        column_name = "Bin_Type"; label = "Bin type"; meaning = "numeric interval / categorical group / missing"; output;
        column_name = "Significant"; label = "Significant (bootstrap)"; meaning = "1 when the smallest Benjamini-Hochberg adjusted bootstrap p-value is at or below the Feature Binning alpha"; output;
        column_name = "Overall_Score"; label = "Overall score"; meaning = "Feature Binning ranking score (Root cause score x 20)"; output;
        column_name = "Deterioration_Score"; label = "Deterioration score"; meaning = "Average of the scaled Gini KS AUC default-rate and ECE changes - tie-break and diagnostic"; output;
        column_name = "Exposure_Pct"; label = "Share of monitoring exposure"; meaning = "Segment exposure share in monitoring"; output;
        column_name = "Mon_Default_Count"; label = "Defaults in monitoring"; meaning = "Number of defaults in the bin - monitoring"; output;
        column_name = "Dev_Calibration_Intercept"; label = "Calibration intercept dev"; meaning = "Intercept of a logistic regression of the target on the raw score - development"; output;
        column_name = "Mon_Calibration_Intercept"; label = "Calibration intercept monitoring"; meaning = "Same - monitoring"; output;
        column_name = "Delta_Calibration_Intercept"; label = "Calibration intercept change"; meaning = "Mon minus Dev intercept"; output;
        column_name = "Dev_Calibration_Slope"; label = "Calibration slope dev"; meaning = "Slope of that regression - development"; output;
        column_name = "Mon_Calibration_Slope"; label = "Calibration slope monitoring"; meaning = "Slope - monitoring"; output;
        column_name = "Delta_Calibration_Slope"; label = "Calibration slope change"; meaning = "Mon minus Dev slope"; output;
        column_name = "Dev_ECE"; label = "Expected calibration error dev"; meaning = "Weighted average gap between mean score and observed default rate across 10 score bins - development"; output;
        column_name = "Mon_ECE"; label = "Expected calibration error monitoring"; meaning = "Same - monitoring"; output;
        column_name = "Delta_ECE"; label = "ECE change"; meaning = "Mon_ECE minus Dev_ECE"; output;
        column_name = "gini_p"; label = "Bootstrap p-value Gini"; meaning = "Bootstrap p-value for the Gini change"; output;
        column_name = "ks_p"; label = "Bootstrap p-value KS"; meaning = "Bootstrap p-value for the KS change"; output;
        column_name = "auc_p"; label = "Bootstrap p-value AUC"; meaning = "Bootstrap p-value for the AUC change"; output;
        column_name = "br_p"; label = "Bootstrap p-value default rate"; meaning = "Bootstrap p-value for the default-rate change"; output;
        column_name = "ece_p"; label = "Bootstrap p-value ECE"; meaning = "Bootstrap p-value for the ECE change"; output;
        column_name = "min_p_adj"; label = "Smallest adjusted p-value"; meaning = "Smallest Benjamini-Hochberg adjusted bootstrap p-value"; output;
        column_name = "ptype"; label = "Condition type"; meaning = "N numeric interval - C feature equals value - X feature not equal value - M feature is missing"; output;
        column_name = "lower"; label = "Lower cut-off"; meaning = "Lower bound of a numeric interval (exact value)"; output;
        column_name = "upper"; label = "Upper cut-off"; meaning = "Upper bound of a numeric interval (exact value)"; output;
        column_name = "lo_inf"; label = "No lower bound"; meaning = "1 when the interval is open on the low side"; output;
        column_name = "hi_inf"; label = "No upper bound"; meaning = "1 when the interval is open on the high side"; output;
        column_name = "value"; label = "Category value"; meaning = "Category for C and X conditions"; output;
        column_name = "label"; label = "Condition text"; meaning = "Readable text of the condition (rounded)"; output;
        column_name = "condition"; label = "Condition (exact)"; meaning = "The condition with exact cut-offs as SAS WHERE text"; output;
        column_name = "Segment"; label = "Segment"; meaning = "Segment definition text"; output;
        column_name = "Population_Pct"; label = "Population share"; meaning = "Share of the monitoring population"; output;
        column_name = "Severity_PopulationXGini"; label = "Portfolio severity"; meaning = "Population share x absolute Gini change"; output;
        column_name = "Overall_Rank"; label = "Overall rank"; meaning = "Rank across all techniques by Normalized_Root_Cause_Score"; output;
        column_name = "Discovered_By"; label = "Found by"; meaning = "Every technique that independently found this same population"; output;
        column_name = "Normalized_Root_Cause_Score"; label = "Cross-technique score"; meaning = "Root_Cause_Score scaled 0 to 1 over the pooled top segments of all techniques - the only score comparable across techniques"; output;
        column_name = "column_name"; label = "Column"; meaning = "Column name in the development table"; output;
        column_name = "data_type"; label = "Data type"; meaning = "numeric or character"; output;
        column_name = "role"; label = "Role"; meaning = "TARGET SCORE WEIGHT ID TIME SHAP FEATURE_NUMERIC FEATURE_CATEGORICAL or EXCLUDED"; output;
        column_name = "reason"; label = "Reason"; meaning = "Why the column received this role"; output;
        column_name = "source"; label = "Source"; meaning = "caller = given in the trigger. auto-detected = decided by the engine. default list = built-in exclusion"; output;
        column_name = "n_distinct"; label = "Distinct values"; meaning = "Number of distinct non-missing values"; output;
        column_name = "pct_missing"; label = "Percent missing"; meaning = "Share of missing values in development"; output;
        column_name = "min_value"; label = "Minimum"; meaning = "Smallest value (numeric columns)"; output;
        column_name = "max_value"; label = "Maximum"; meaning = "Largest value (numeric columns)"; output;
        column_name = "leak_auc"; label = "Leakage screen"; meaning = "Single-feature absolute AUC minus 0.5 against the target (categories use their default rate). Values near 0 are normal - values near 0.5 mean the column predicts the target suspiciously well"; output;
        column_name = "drift_auc"; label = "Drift strength"; meaning = "Absolute AUC minus 0.5 of the column for telling development rows from monitoring rows. Higher = the column drifted more"; output;
        column_name = "feat_rank"; label = "Feature rank"; meaning = "Rank of the column by the larger of its drift and default strength. Only the top sg_cfg_max_features columns are searched"; output;
        column_name = "Period"; label = "Period"; meaning = "Monitoring period label (value of the period column)"; output;
        column_name = "Period_Index"; label = "Period number"; meaning = "0-based chronological position of the period"; output;
        column_name = "Periods_Appeared"; label = "Periods appeared"; meaning = "In how many periods the segment was among the worst segments of its technique"; output;
        column_name = "Total_Periods"; label = "Periods analysed"; meaning = "Number of monitoring periods analysed"; output;
        column_name = "Appeared_In"; label = "Appeared in"; meaning = "The periods in which the segment was among the worst"; output;
        column_name = "Frequency"; label = "Frequency"; meaning = "Periods appeared divided by periods analysed"; output;
        column_name = "Recency_Factor"; label = "Recency"; meaning = "0.5 to the power (periods since the last appearance divided by the half-life). 1 = appeared in the latest period"; output;
        column_name = "Consistency_Score"; label = "Consistency"; meaning = "Longest run of consecutive periods the segment appeared in divided by periods analysed"; output;
        column_name = "Trend_Impact_Score"; label = "Trend impact score"; meaning = "Weighted blend of Frequency Recency and Consistency (0.4 0.3 0.3 by default). 1 = worst every period and in the latest"; output;
        column_name = "SIS_Trend"; label = "SIS boosted by persistence"; meaning = "SIS_Raw multiplied by (1 + trend weight x Trend_Impact_Score). Informational"; output;
        column_name = "Root_Cause_Score_Trend"; label = "Root-cause score with persistence"; meaning = "The single-period root-cause blend recomputed over the recurring segments of one technique then boosted once by (1 + trend weight x Trend_Impact_Score) and capped at 1"; output;
        column_name = "Severity_Score_Trend"; label = "Severity with persistence"; meaning = "Root_Cause_Score_Trend x 20. Comparable only within one technique"; output;
        column_name = "Periods_Used"; label = "Periods in the forecast"; meaning = "Number of periods of history the forecast line is fitted on"; output;
        column_name = "Last_Appeared_Period"; label = "Last appeared in"; meaning = "Latest period in which the segment was among the worst"; output;
        column_name = "Current_Root_Cause_Score"; label = "Current root-cause score"; meaning = "Root_Cause_Score in the latest period the segment appeared"; output;
        column_name = "Predicted_Next_Root_Cause_Score"; label = "Forecast next score"; meaning = "Straight-line projection of Root_Cause_Score one period ahead capped to 0 to 1"; output;
        column_name = "Predicted_Next_Lower95"; label = "Forecast lower 95 pct"; meaning = "Lower end of the 95 percent prediction interval (needs 3 or more periods)"; output;
        column_name = "Predicted_Next_Upper95"; label = "Forecast upper 95 pct"; meaning = "Upper end of the 95 percent prediction interval (needs 3 or more periods)"; output;
        column_name = "Trend_Slope"; label = "Trend slope"; meaning = "Change of Root_Cause_Score per period. Positive = getting worse"; output;
        column_name = "R_Squared"; label = "R-squared"; meaning = "How well a straight line fits the segment history (needs 3 or more periods)"; output;
        column_name = "Trend_P_Value"; label = "Trend p-value"; meaning = "Probability of a slope this steep if there were no real trend (needs 3 or more periods). Small = real trend"; output;
        column_name = "Months_To_Breach"; label = "Periods to breach"; meaning = "Whole periods until the projected score crosses the alert level. Reported only within the forecast horizon"; output;
        column_name = "Confidence"; label = "Forecast confidence"; meaning = "Low with 2 periods of history and medium with 3 or more"; output;
        column_name = "Early_Warning"; label = "Early warning"; meaning = "1 when the segment is worsening and projected to cross the alert level within the horizon"; output;
        column_name = "combo"; label = "Combination number"; meaning = "Order in which the parameter combination was tried"; output;
        column_name = "parameters"; label = "Parameters tried"; meaning = "The parameter values of this combination"; output;
        column_name = "objective_score"; label = "Objective score"; meaning = "Sum of Business_Impact_Score of the segments this combination returned. Higher wins"; output;
        column_name = "rank_by_score"; label = "Rank by objective"; meaning = "1 = best combination"; output;
        column_name = "selected"; label = "Chosen"; meaning = "1 for the combination whose results are reported"; output;
        column_name = "selection_rule"; label = "Selection rule"; meaning = "How the winning combination was chosen"; output;
        column_name = "setting"; label = "Setting"; meaning = "Name of the global setting"; output;
        column_name = "description"; label = "Description"; meaning = "What the setting controls"; output;
        column_name = "status"; label = "Status"; meaning = "OK ERROR or NOT_RUN"; output;
        column_name = "message"; label = "Message"; meaning = "Details when a technique did not run"; output;
        column_name = "seconds"; label = "Run time (s)"; meaning = "Seconds the technique took"; output;
        column_name = "total_dev_n"; label = "Development rows"; meaning = "Rows in the development table"; output;
        column_name = "total_mon_n"; label = "Monitoring rows"; meaning = "Rows in the monitoring table"; output;
        column_name = "min_abs_count"; label = "Minimum rows per segment"; meaning = "Smallest allowed segment size (derived from the default rate)"; output;
        column_name = "min_support"; label = "Minimum share per segment"; meaning = "Smallest allowed segment share"; output;
        column_name = "candidates_evaluated"; label = "Candidates evaluated"; meaning = "Segments that passed the size and default-count gates and were scored"; output;
        column_name = "candidates_returned"; label = "Candidates returned"; meaning = "Segments in the output table"; output;
    run;
%mend seg_metric_dictionary;
