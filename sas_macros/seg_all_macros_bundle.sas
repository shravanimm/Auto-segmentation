/* >>>>>>>>>>>>>>>> seg_nobs.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_nobs.sas
   Function-style macro: number of observations in a dataset (0 if it does not
   exist). Usage:  %let n = %seg_nobs(work.mytable);
   ============================================================================ */
%macro seg_nobs(ds);
    %local dsid n rc;
    %let n = 0;
    %if %sysfunc(exist(&ds)) %then %do;
        %let dsid = %sysfunc(open(&ds));
        %let n    = %sysfunc(attrn(&dsid, nlobs));
        %let rc   = %sysfunc(close(&dsid));
    %end;
    &n
%mend seg_nobs;

/* >>>>>>>>>>>>>>>> seg_vartype.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_vartype.sas
   Function-style macro: returns N (numeric) or C (character) for a variable.
   Mirrors pandas is_numeric_dtype() in the Python code: AutoSlicer decides
   "numeric bins" vs "one predicate per category" from the column's physical
   type, NOT from the schema's categorical_cols list.
   Usage:  %let t = %seg_vartype(ds=work._sg_dev, var=age);
   ============================================================================ */
%macro seg_vartype(ds=, var=);
    %local dsid vnum t rc;
    %let t = ;
    %let dsid = %sysfunc(open(&ds));
    %if &dsid %then %do;
        %let vnum = %sysfunc(varnum(&dsid, &var));
        %if &vnum > 0 %then %let t = %sysfunc(vartype(&dsid, &vnum));
        %let rc = %sysfunc(close(&dsid));
    %end;
    &t
%mend seg_vartype;

/* >>>>>>>>>>>>>>>> seg_fmtnum.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_fmtnum.sas
   DATA-step statement macro: formats a numeric threshold for DISPLAY, like
   utils/preprocessing.format_number: round to 2 dp; integers get thousands
   separators ("60,810"), others drop trailing zeros ("44.5").

   DISPLAY ONLY. Exact thresholds are always stored separately in the rules
   table (seg_*_rules) - rounded text is not a faithful rule definition.
   Known tie divergence: SAS ROUND() rounds exact-binary-near-ties away from
   zero (33.005 -> 33.01), Python rounds on the exact binary value (-> 33).

   Usage inside a DATA step:   %seg_fmtnum(x=edge, into=lbl)
   ============================================================================ */
%macro seg_fmtnum(x=, into=);
    _fr = round(&x, 0.01);
    if abs(_fr - round(_fr)) < 1e-9 then &into = strip(put(round(_fr), comma32.));
    else do;
        &into = strip(put(_fr, comma32.2));
        if substr(&into, length(&into), 1) = '0' then &into = substr(&into, 1, length(&into) - 1);
    end;
%mend seg_fmtnum;

/* >>>>>>>>>>>>>>>> seg_fix_case.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_fix_case.sas
   SAS variable names are case-insensitive, so `rename psi=PSI` does nothing (or
   errors) and `PSI = psi;` is a no-op. This macro gives the variables in
   &names the exact spelling listed there (e.g. psi -> PSI, delta_br -> Delta_BR)
   by routing each through a temporary name inside one DATA step.
   Only the spelling of the output column header changes - never the values.
   ============================================================================ */
%macro seg_fix_case(ds=, names=);

    %local n i nm ren back;
    %let n = %sysfunc(countw(&names, %str( )));
    %let ren  = ;
    %let back = ;
    %do i = 1 %to &n;
        %let nm = %scan(&names, &i, %str( ));
        %let ren  = &ren &nm=_fc&i;
        %let back = &back _fc&i=&nm;
    %end;

    data &ds;
        set &ds(rename=(&ren));
        rename &back;
    run;

%mend seg_fix_case;

/* >>>>>>>>>>>>>>>> seg_f32.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_f32.sas
   DATA-step statement macro: rounds a double to IEEE single precision with
   round-to-nearest-even, exactly what numpy/scikit-learn do when they cast X to
   float32 before fitting/applying a tree.
   Do NOT use put(x, rb4.) / input(.., rb4.) for this: SAS's 4-byte real format
   TRUNCATES the mantissa instead of rounding (differs from numpy for ~48% of
   values), which moves tree thresholds by one float32 ulp and flips display
   rounding such as 40.315 -> 40.31 instead of 40.32.
   Usage inside a DATA step:   %seg_f32(x=<double expr var>, into=<result var>)
   ============================================================================ */
%macro seg_f32(x=, into=);
    if missing(&x) or &x = 0 then &into = &x;
    else do;
        _f3a = abs(&x);
        _f3e = floor(log2(_f3a));
        if 2 ** _f3e > _f3a then _f3e = _f3e - 1;
        else if 2 ** (_f3e + 1) <= _f3a then _f3e = _f3e + 1;
        _f3u = 2 ** (_f3e - 23);
        _f3y = _f3a / _f3u;
        _f3r = floor(_f3y + 0.5);
        if (_f3y + 0.5) = _f3r and mod(_f3r, 2) = 1 then _f3r = _f3r - 1;
        &into = sign(&x) * _f3r * _f3u;
    end;
%mend seg_f32;

/* >>>>>>>>>>>>>>>> seg_quantile_t7_by.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_quantile_t7_by.sas
   Group-wise quantiles that are BIT-COMPATIBLE with numpy.quantile (linear /
   "type 7") + numpy.linspace(0,1,nbins+1).

   Why not PROC MEANS/UNIVARIATE: they only offer PCTLDEF 1-5, never type 7.
   Why bit-compatible: data values sit exactly on edges (e.g. dti = 51.81), so a
   last-bit difference moves whole tie blocks between bins. numpy computes
       h = (n-1)*p ; lo = floor(h) ; g = h-lo
       q = b-(b-a)*(1-g)  if g >= 0.5  else  a+(b-a)*g        (a=x[lo], b=x[lo+1])
   with p_j = j*(1/nbins) (linspace) and p_nbins = 1.0. This macro copies that.

   in    : dataset SORTED by &by &var, no missing &var
   by    : ONE by-variable
   nbins : number of intervals (quantiles q0..q&nbins are returned)
   out   : &by, n, q0 ... q&nbins (one row per by-group)
   ============================================================================ */
%macro seg_quantile_t7_by(in=, by=, var=, nbins=, out=);

    proc sql noprint;
        create table _sg_qn as
        select &by, count(*) as _qn from &in group by &by order by &by;
    quit;

    data &out(keep=&by n q0-q&nbins);
        merge &in(keep=&by &var) _sg_qn;
        by &by;
        array q [0:&nbins] q0-q&nbins;
        array xl[0:&nbins] _xl0-_xl&nbins;
        array xh[0:&nbins] _xh0-_xh&nbins;
        array lo[0:&nbins] _lo0-_lo&nbins;
        array gm[0:&nbins] _gm0-_gm&nbins;
        retain _xl0-_xl&nbins _xh0-_xh&nbins _lo0-_lo&nbins _gm0-_gm&nbins _k;

        if first.&by then do;
            _k = 0;
            do _j = 0 to &nbins;
                _p = ifn(_j = &nbins, 1, _j * (1 / &nbins));
                _h = (_qn - 1) * _p;
                lo[_j] = floor(_h);
                gm[_j] = _h - lo[_j];
                xl[_j] = .;
                xh[_j] = .;
            end;
        end;
        else _k + 1;

        do _j = 0 to &nbins;
            if _k = lo[_j] then xl[_j] = &var;
            if _k = min(lo[_j] + 1, _qn - 1) then xh[_j] = &var;
        end;

        if last.&by then do;
            n = _qn;
            do _j = 0 to &nbins;
                _a = xl[_j];
                _b = xh[_j];
                _d = _b - _a;
                q[_j] = ifn(gm[_j] >= 0.5, _b - _d * (1 - gm[_j]), _a + _d * gm[_j]);
            end;
            output;
        end;
    run;

%mend seg_quantile_t7_by;

/* >>>>>>>>>>>>>>>> seg_prep.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_prep.sas
   Shared by every segmentation technique. Builds the two working tables the
   engine reads and derives the population-level thresholds.

   Creates (WORK):
     _sg_dev / _sg_mon : _rid (row id), _y (target 0/1), _s (model score),
                         _w (exposure; 0 when no weight_col), plus the feature
                         columns and shap columns passed in.
   Creates (global macro vars):
     sg_ndev sg_nmon        row counts
     sg_twdev sg_twmon      total exposure (0 when no weight_col)
     sg_rate                dev event rate
     sg_minabs sg_minsup    derived support gates (core/candidate_filtering.py)
     sg_maxpct sg_minev     max segment share / min events per slice
     sg_nf                  number of features
     sg_rca_feats           features used for in-segment root-cause PSI

   Missing model scores: rows are kept (as in Python) but AUC/KS need non-
   missing scores - a NOTE is written when any are found.
   ============================================================================ */
%macro seg_prep(dev=, mon=, target_col=, score_col=, weight_col=, feature_cols=, shap_cols=,
                min_abs_count=, min_support=, min_events_per_slice=30, max_segment_pct=0.35,
                rca_name_filter=Y);

    %global sg_ndev sg_nmon sg_twdev sg_twmon sg_rate sg_minabs sg_minsup sg_maxpct sg_minev
            sg_nf sg_rca_feats sg_premem;
    %local i f keep _sg_bad _sg_nmiss_d _sg_nmiss_m;

    /* sg_premem = Y : candidates' row membership is supplied in _sg_memb_dev /
       _sg_memb_mon (cand_id,_rid) by the technique (tree leaves, clusters, bins)
       instead of being derived from predicate vectors c1..cN (AutoSlicer). */
    %let sg_premem = N;

    %let sg_nf     = %sysfunc(countw(&feature_cols, %str( )));
    %let sg_maxpct = &max_segment_pct;
    %let sg_minev  = &min_events_per_slice;

    data _sg_dev;
        set &dev(keep=&target_col &score_col &weight_col &feature_cols &shap_cols);
        _rid = _n_;
        _y   = &target_col;
        _s   = &score_col;
        %if %length(&weight_col) %then %do; _w = &weight_col; %end;
        %else %do; _w = 0; %end;
    run;

    data _sg_mon;
        set &mon(keep=&target_col &score_col &weight_col &feature_cols &shap_cols);
        _rid = _n_;
        _y   = &target_col;
        _s   = &score_col;
        %if %length(&weight_col) %then %do; _w = &weight_col; %end;
        %else %do; _w = 0; %end;
    run;

    proc sql noprint;
        select count(*), sum(_w) format=best32., mean(_y) format=best32., nmiss(_s)
          into :sg_ndev trimmed, :sg_twdev trimmed, :sg_rate trimmed, :_sg_nmiss_d trimmed
          from _sg_dev;
        select count(*), sum(_w) format=best32., nmiss(_s)
          into :sg_nmon trimmed, :sg_twmon trimmed, :_sg_nmiss_m trimmed
          from _sg_mon;
    quit;
    %if %sysevalf(&_sg_nmiss_d + &_sg_nmiss_m > 0) %then
        %put NOTE: seg_prep - missing model scores found - AUC/KS are undefined for those rows.;

    /* derive_min_abs_count / derive_min_support (core/candidate_filtering.py) */
    data _null_;
        rate = &sg_rate;
        %if %length(&min_abs_count) %then %do; minabs = &min_abs_count; %end;
        %else %do; minabs = max(50, ceil(&min_events_per_slice / max(rate, 1e-4))); %end;
        %if %length(&min_support) %then %do; minsup = &min_support; %end;
        %else %do; minsup = min(0.30, max(0.02, minabs / min(&sg_ndev, &sg_nmon))); %end;
        call symputx('sg_minabs', minabs, 'G');
        call symputx('sg_minsup', put(minsup, best32.), 'G');
    run;

    /* Root-cause feature list = feature_cols minus ID/time/shap-looking names,
       as core/candidate_evaluation._sanitize_feature_columns does.
       NOTE: that Python filter is an UNANCHORED substring match, so e.g.
       "months_on_book" is dropped from root-cause analysis. rca_name_filter=N
       disables it (documented deviation switch). */
    %let sg_rca_feats = ;
    %do i = 1 %to &sg_nf;
        %let f    = %scan(&feature_cols, &i, %str( ));
        %let keep = 1;
        %if %upcase(&rca_name_filter) = Y %then %do;
            data _null_;
                length nm $64;
                nm  = "&f";
                bad = prxmatch('/(^id$|_id$|^id_|customer_?id|account_?id|application_?id|loan_?id|transaction_?id|uuid|identifier)/i', strip(nm)) > 0
                   or prxmatch('/(month|period|date|vintage|snapshot|as_of|year|timestamp)/i', strip(nm)) > 0
                   or prxmatch('/^shap[_\-]/i', strip(nm)) > 0;
                call symputx('_sg_bad', bad, 'L');
            run;
            %if &_sg_bad %then %let keep = 0;
        %end;
        %if %upcase(&f) = %upcase(&target_col) or %upcase(&f) = %upcase(&score_col) %then %let keep = 0;
        %if %length(&weight_col) %then %do;
            %if %upcase(&f) = %upcase(&weight_col) %then %let keep = 0;
        %end;
        %if &keep %then %let sg_rca_feats = &sg_rca_feats &f;
    %end;
    %let sg_rca_feats = %sysfunc(strip(&sg_rca_feats));

    %put NOTE: seg_prep - ndev=&sg_ndev nmon=&sg_nmon min_abs_count=&sg_minabs min_support=&sg_minsup;
    %put NOTE: seg_prep - root-cause features: &sg_rca_feats;

%mend seg_prep;

/* >>>>>>>>>>>>>>>> seg_membership.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_membership.sas
   Row membership of candidate segments, as a LONG table (one row per
   candidate x member row), plus the requested columns of the member rows.

   Mode 1 (sg_premem = N, AutoSlicer): a candidate row of _sg_cand carries
   c1..cN where c<i> = pred_id constrained on feature i, or 0 = unconstrained.
   A data row (with _b1.._bN from seg_as_predicates) is a member iff, for every
   i,  c<i> = 0  OR  c<i> = _b<i>.   (missing/unseen => _b = -1 => never equal)

   Mode 2 (sg_premem = Y; trees, clusters, bins): the technique has already
   written _sg_memb_dev / _sg_memb_mon (cand_id,_rid); candidates are the ones
   listed in &cand.

   side : dev | mon      cand : candidate table (cand_id [, c1..cN])
   cols : columns copied from _sg_<side> into the long table
   Requires: sg_nf (mode 1), sg_premem
   Scale note: mode 1 is a candidates x rows join - fine for the demo/5k-row
   data; for 1M-row production data run it in CAS (same logic).
   ============================================================================ */
%macro seg_membership(side=, cand=, out=, cols=_rid _y _s _w);

    %local i collist;
    %let collist = ;
    %do i = 1 %to %sysfunc(countw(&cols, %str( )));
        %let collist = &collist, r.%scan(&cols, &i, %str( ));
    %end;

    %if &sg_premem = Y %then %do;
        proc sql;
            create table &out as
            select m.cand_id &collist
            from _sg_memb_&side m, _sg_&side r
            where m._rid = r._rid
              and m.cand_id in (select cand_id from &cand);
        quit;
    %end;
    %else %do;
        proc sql;
            create table &out as
            select c.cand_id &collist
            from &cand c, _sg_&side r
            where 1 = 1
            %do i = 1 %to &sg_nf;
                and (c.c&i = 0 or c.c&i = r._b&i)
            %end;
            ;
        quit;
    %end;

%mend seg_membership;

/* >>>>>>>>>>>>>>>> seg_candidate_filter.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_candidate_filter.sas
   Cheap first-pass gates, run BEFORE the expensive per-candidate metrics:
     passes_support_filter : n_dev, n_mon >= min_abs_count ; pct_dev, pct_mon >=
                             min_support ; pct_dev, pct_mon <= max_segment_pct
     passes_event_count    : events in dev and in mon >= min_events_per_slice
   (core/candidate_filtering.py). Output = the surviving candidate rows
   (cand_id, depth, c1..cN, ...) copied from &cand.
   Requires: sg_ndev sg_nmon sg_minabs sg_minsup sg_maxpct sg_minev
   ============================================================================ */
%macro seg_candidate_filter(cand=, out=);

    %seg_membership(side=dev, cand=&cand, out=_sg_ml_dev, cols=_y);
    %seg_membership(side=mon, cand=&cand, out=_sg_ml_mon, cols=_y);

    proc sql;
        create table _sg_pass as
        select d.cand_id
        from (select cand_id, count(*) as n, sum(_y) as x from _sg_ml_dev group by cand_id) d
             inner join
             (select cand_id, count(*) as n, sum(_y) as x from _sg_ml_mon group by cand_id) m
             on d.cand_id = m.cand_id
        where d.n >= &sg_minabs and m.n >= &sg_minabs
          and d.n / &sg_ndev >= &sg_minsup and m.n / &sg_nmon >= &sg_minsup
          and d.n / &sg_ndev <= &sg_maxpct and m.n / &sg_nmon <= &sg_maxpct
          and d.x >= &sg_minev and m.x >= &sg_minev;

        create table &out as
        select * from &cand where cand_id in (select cand_id from _sg_pass)
        order by cand_id;
    quit;

%mend seg_candidate_filter;

/* >>>>>>>>>>>>>>>> seg_cand_rules.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_cand_rules.sas
   Turns candidate rows (c1..cN) into
     &out_rules : long rule table - the EXACT, machine-readable definition
                  (cand_id, feature, ptype, lower, upper, lo_inf, hi_inf, value)
                  numeric: lower <= x < upper (missing bound = open)
                  character: x = value
     &out_defs  : cand_id, Segment_Definition ("a AND b", labels ordered by
                  feature NAME, as the Python code sorts them)
   Display text is rounded (see seg_fmtnum); the rules table is authoritative.
   ============================================================================ */
%macro seg_cand_rules(cand=, out_rules=, out_defs=);

    data _sg_cr1(keep=cand_id feat_idx pred_id);
        set &cand;
        array c [&sg_nf] c1-c&sg_nf;
        do feat_idx = 1 to &sg_nf;
            if c[feat_idx] > 0 then do;
                pred_id = c[feat_idx];
                output;
            end;
        end;
    run;

    proc sql;
        create table &out_rules as
        select a.cand_id, p.feature, p.feat_idx, p.ptype, p.lower, p.upper, p.lo_inf, p.hi_inf,
               p.value, p.label
        from _sg_cr1 a inner join _sg_pred p on a.pred_id = p.pred_id
        order by a.cand_id, p.feature;
    quit;

    data &out_defs(keep=cand_id Segment_Definition);
        set &out_rules;
        by cand_id;
        length Segment_Definition $1000;
        retain Segment_Definition;
        if first.cand_id then Segment_Definition = label;
        else Segment_Definition = catx(' AND ', Segment_Definition, label);
        if last.cand_id then output;
    run;

%mend seg_cand_rules;

/* >>>>>>>>>>>>>>>> seg_auc_ks.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_auc_ks.sas
   Per-candidate AUC and KS for one side (dev or mon) from a membership table.

   AUC  : Mann-Whitney / rank-sum with mid-ranks for ties (PROC RANK
          TIES=MEAN):  (R1 - n1(n1+1)/2) / (n1*n0). Identical to
          sklearn.roc_auc_score, including tie handling (verified to 1e-16).
          Missing (.) when the segment has only one target class.
   KS   : max |cumBad/nBad - cumGood/nGood| evaluated at the END of each block
          of tied scores (the standard statistic). Python's calculate_ks scans
          row-by-row, so inside a tie block its value depends on numpy's
          arbitrary tie order; on tie-free scores the two are identical. On the
          demo data they differ by <= 2.6e-3 and produce the SAME candidate
          pool and top-10 (verified by re-running the Python with this KS).
   in : &mem with cand_id, _y, _s        out: cand_id, auc, ks
   ============================================================================ */
%macro seg_auc_ks(mem=, out=);

    proc sort data=&mem(keep=cand_id _y _s) out=_sg_ak1;
        by cand_id _s;
    run;

    proc rank data=_sg_ak1 out=_sg_ak2 ties=mean;
        by cand_id;
        var _s;
        ranks _r;
    run;

    proc sql;
        create table _sg_ak3 as
        select cand_id,
               sum(_y = 1) as n1,
               sum(_y = 0) as n0,
               sum(case when _y = 1 then _r else 0 end) as r1
        from _sg_ak2
        group by cand_id;
    quit;

    proc sort data=_sg_ak1 out=_sg_ak4;
        by cand_id descending _s;
    run;

    data _sg_ak5(keep=cand_id ks);
        if _n_ = 1 then do;
            if 0 then set _sg_ak3(keep=cand_id n1 n0);
            declare hash h(dataset: '_sg_ak3');
            h.defineKey('cand_id');
            h.defineData('n1', 'n0');
            h.defineDone();
        end;
        set _sg_ak4;
        by cand_id descending _s;
        retain cb cg ks;
        if first.cand_id then do;
            rc = h.find();
            cb = 0; cg = 0; ks = 0;
        end;
        if _y = 1 then cb + 1; else cg + 1;
        if last._s and n1 > 0 and n0 > 0 then ks = max(ks, abs(cb / n1 - cg / n0));
        if last.cand_id then do;
            if n1 = 0 or n0 = 0 then ks = .;
            output;
        end;
    run;

    proc sql;
        create table &out as
        select a.cand_id,
               case when a.n1 > 0 and a.n0 > 0 then (a.r1 - a.n1 * (a.n1 + 1) / 2) / (a.n1 * a.n0)
                    else . end as auc,
               k.ks
        from _sg_ak3 a left join _sg_ak5 k on a.cand_id = k.cand_id
        order by a.cand_id;
    quit;

%mend seg_auc_ks;

/* >>>>>>>>>>>>>>>> seg_ks_shift.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_ks_shift.sas
   Per-candidate two-sample KS test on the model SCORE, dev rows vs mon rows
   (metrics/significance.ks_score_shift_pvalue -> scipy.stats.ks_2samp).

   D = max |F_dev(x) - F_mon(x)| over the pooled distinct scores.
   p-value: asymptotic Kolmogorov distribution with Stephens' finite-sample
   correction  lambda = (sqrt(en) + 0.12 + 0.11/sqrt(en)) * D,
               p = 2 * sum_{k>=1} (-1)^(k-1) exp(-2 k^2 lambda^2),  en = n*m/(n+m).
   DEVIATION: scipy uses the EXACT p-value when max(n,m) <= 10000; this is the
   asymptotic form. On the 80-candidate demo pool the largest |difference| is
   0.019 and it flips 0 of 80 Statistically_Significant flags. The p-value only
   feeds the significance flag (BH-adjusted, alpha 0.05), never a score.
   cnt : table with cand_id, n_dev, n_mon        out: cand_id, ks_stat, score_shift_pvalue
   ============================================================================ */
%macro seg_ks_shift(mem_dev=, mem_mon=, cnt=, out=);

    data _sg_kh1;
        set &mem_dev(keep=cand_id _s) &mem_mon(keep=cand_id _s in=_im);
        src = _im;
        if not missing(_s);
    run;

    proc sort data=_sg_kh1; by cand_id _s; run;

    data &out(keep=cand_id ks_stat score_shift_pvalue);
        if _n_ = 1 then do;
            if 0 then set &cnt(keep=cand_id n_dev n_mon);
            declare hash h(dataset: "&cnt");
            h.defineKey('cand_id');
            h.defineData('n_dev', 'n_mon');
            h.defineDone();
        end;
        set _sg_kh1;
        by cand_id _s;
        retain cd cm ks_stat;
        if first.cand_id then do;
            rc = h.find();
            cd = 0; cm = 0; ks_stat = 0;
        end;
        if src = 0 then cd + 1; else cm + 1;
        if last._s then ks_stat = max(ks_stat, abs(cd / n_dev - cm / n_mon));
        if last.cand_id then do;
            if n_dev < 2 or n_mon < 2 then score_shift_pvalue = .;
            else do;
                en  = sqrt(n_dev * n_mon / (n_dev + n_mon));
                lam = (en + 0.12 + 0.11 / en) * ks_stat;
                if lam < 0.27 then p = 1;
                else do;
                    p = 0;
                    do k = 1 to 100;
                        p = p + 2 * ((-1) ** (k - 1)) * exp(-2 * k * k * lam * lam);
                    end;
                end;
                score_shift_pvalue = min(1, max(0, p));
            end;
            output;
        end;
    run;

%mend seg_ks_shift;

/* >>>>>>>>>>>>>>>> seg_feature_psi.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_feature_psi.sas
   In-segment root-cause drift: for EVERY candidate and every root-cause
   feature, PSI between the segment's dev rows and mon rows
   (core/candidate_evaluation._compute_feature_drift_within_segment).

   numeric feature (physical SAS type):
       bins = unique(numpy-linear deciles of the COMBINED dev+mon non-missing
       values of the segment), outer edges -> +-inf, intervals (a,b]
       (right-closed, as pandas.cut). pct = (count+1e-6)/(total+1e-6*nbins);
       PSI = sum (m-d)*ln(m/d), floored at 0. Constant feature => 0.
   character feature:
       union of categories, pct = (count+1e-6)/(total+1e-6), PSI as above.
   A feature is skipped for a candidate when either side has < 5 non-missing
   values. NOTE this is NOT drift_psi_one_feature.sas (that macro bins on DEV
   only and clamps with coalesce); the two differ by design in Python.

   Outputs:
     &out_long : cand_id, feat_idx, feature, psi
     &out_agg  : cand_id, mean_feature_psi (0 if no valid feature),
                 top_drift_feature (first feature on ties), top_drift_psi
   mem_dev / mem_mon must carry the feature columns (see cols= in seg_membership).
   ============================================================================ */
%macro seg_feature_psi(mem_dev=, mem_mon=, feats=, cnt=, out_long=, out_agg=);

    %local nfe i f vt;
    %let nfe = %sysfunc(countw(&feats, %str( )));

    data &out_long;
        length cand_id 8 feat_idx 8 feature $64 psi 8;
        stop;
    run;

    %do i = 1 %to &nfe;
        %let f  = %scan(&feats, &i, %str( ));
        %let vt = %seg_vartype(ds=_sg_dev, var=&f);

        data _sg_fs;
            set &mem_dev(keep=cand_id &f rename=(&f=_v))
                &mem_mon(keep=cand_id &f rename=(&f=_v) in=_im);
            src = _im;
            if not missing(_v);
        run;

        proc sql;
            create table _sg_fok as
            select cand_id from _sg_fs
            group by cand_id
            having sum(src = 0) >= 5 and sum(src = 1) >= 5;

            create table _sg_fs2 as
            select * from _sg_fs
            where cand_id in (select cand_id from _sg_fok)
            order by cand_id, _v;
        quit;

        %if %seg_nobs(_sg_fs2) > 0 %then %do;

            %if &vt = N %then %do;
                %seg_quantile_t7_by(in=_sg_fs2, by=cand_id, var=_v, nbins=10, out=_sg_fq);

                data _sg_fpn(keep=cand_id psi);
                    merge _sg_fs2(keep=cand_id _v src) _sg_fq(keep=cand_id q0-q10);
                    by cand_id;
                    array q [0:10] q0-q10;
                    array ue[11] _u1-_u11;
                    array cd[10] _cd1-_cd10;
                    array cm[10] _cm1-_cm10;
                    retain nu k nd nm _u1-_u11 _cd1-_cd10 _cm1-_cm10;
                    if first.cand_id then do;
                        nu = 0;
                        do _j = 0 to 10;
                            if nu = 0 then do; nu = 1; ue[1] = q[_j]; end;
                            else if q[_j] ne ue[nu] then do; nu + 1; ue[nu] = q[_j]; end;
                        end;
                        k = nu - 1;
                        do _j = 1 to 10; cd[_j] = 0; cm[_j] = 0; end;
                        nd = 0; nm = 0;
                    end;
                    _b = 1;
                    do _j = 2 to nu - 1;
                        if _v > ue[_j] then _b + 1;
                    end;
                    if nu >= 2 then do;
                        if src = 0 then do; cd[_b] + 1; nd + 1; end;
                        else do; cm[_b] + 1; nm + 1; end;
                    end;
                    if last.cand_id then do;
                        psi = 0;
                        if nu >= 2 then do;
                            do _j = 1 to k;
                                _pd = (cd[_j] + 1e-6) / (nd + 1e-6 * k);
                                _pm = (cm[_j] + 1e-6) / (nm + 1e-6 * k);
                                psi = psi + (_pm - _pd) * log(_pm / _pd);
                            end;
                        end;
                        psi = max(0, psi);
                        output;
                    end;
                run;
            %end;
            %else %do;
                proc sql;
                    create table _sg_fc as
                    select cand_id, _v, sum(src = 0) as cd, sum(src = 1) as cm
                    from _sg_fs2 group by cand_id, _v;

                    create table _sg_fcn as
                    select cand_id, sum(cd) as nd, sum(cm) as nm from _sg_fc group by cand_id;

                    create table _sg_fpc0 as
                    select a.cand_id,
                           sum( ((a.cm + 1e-6) / (n.nm + 1e-6) - (a.cd + 1e-6) / (n.nd + 1e-6))
                                * log( ((a.cm + 1e-6) / (n.nm + 1e-6)) / ((a.cd + 1e-6) / (n.nd + 1e-6)) ) )
                                as psi_raw
                    from _sg_fc a inner join _sg_fcn n on a.cand_id = n.cand_id
                    group by a.cand_id;
                quit;
                data _sg_fpn(keep=cand_id psi);
                    set _sg_fpc0;
                    psi = max(0, psi_raw);
                run;
            %end;

            data _sg_fp1;
                set _sg_fpn;
                length feature $64;
                feat_idx = &i;
                feature  = "&f";
            run;
            proc append base=&out_long data=_sg_fp1 force; run;
        %end;
    %end;

    proc sort data=&out_long; by cand_id descending psi feat_idx; run;

    data _sg_fagg0(keep=cand_id mean_feature_psi top_drift_feature top_drift_psi);
        set &out_long;
        by cand_id;
        length top_drift_feature $64;
        retain top_drift_feature top_drift_psi _sum _n;
        if first.cand_id then do;
            top_drift_feature = feature;
            top_drift_psi     = psi;
            _sum = 0; _n = 0;
        end;
        _sum + psi;
        _n + 1;
        if last.cand_id then do;
            mean_feature_psi = _sum / _n;
            output;
        end;
    run;

    /* candidates with no valid feature: Python returns None / 0.0 / 0.0 */
    data &out_agg;
        merge &cnt(keep=cand_id) _sg_fagg0;
        by cand_id;
        if missing(mean_feature_psi) then mean_feature_psi = 0;
        if missing(top_drift_psi)    then top_drift_psi    = 0;
    run;

%mend seg_feature_psi;

/* >>>>>>>>>>>>>>>> seg_shap_shift.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_shap_shift.sas
   mean_shap_shift per candidate = mean over shap columns of
   |mean_mon(shap) - mean_dev(shap)| inside the segment (core/candidate_
   evaluation.py; feeds the 0.15-weight SHAP term of the Root Cause Score).
   No shap columns => 0.
   NOT ported here: Top_SHAP_Feature / Top_SHAP_PSI (diagnostic output columns
   only; they do not enter any score).
   cnt : table with cand_id        out: cand_id, mean_shap_shift
   ============================================================================ */
%macro seg_shap_shift(mem_dev=, mem_mon=, shap_cols=, cnt=, out=);

    %local n i;
    %let n = %sysfunc(countw(&shap_cols, %str( )));

    %if &n = 0 %then %do;
        data &out;
            set &cnt(keep=cand_id);
            mean_shap_shift = 0;
        run;
    %end;
    %else %do;
        proc sql;
            create table _sg_shd as
            select cand_id %do i = 1 %to &n; , avg(%scan(&shap_cols, &i, %str( ))) as d&i %end;
            from &mem_dev group by cand_id order by cand_id;

            create table _sg_shm as
            select cand_id %do i = 1 %to &n; , avg(%scan(&shap_cols, &i, %str( ))) as m&i %end;
            from &mem_mon group by cand_id order by cand_id;
        quit;

        data &out(keep=cand_id mean_shap_shift);
            merge _sg_shd _sg_shm;
            by cand_id;
            array dd [&n] d1-d&n;
            array mm [&n] m1-m&n;
            _s = 0; _c = 0;
            do _i = 1 to &n;
                if not missing(dd[_i]) and not missing(mm[_i]) then do;
                    _s = _s + abs(mm[_i] - dd[_i]);
                    _c = _c + 1;
                end;
            end;
            mean_shap_shift = ifn(_c > 0, _s / _c, 0);
        run;
    %end;

%mend seg_shap_shift;

/* >>>>>>>>>>>>>>>> seg_evaluate_candidates.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_evaluate_candidates.sas
   SAS port of core/candidate_evaluation.evaluate_segment for MANY candidates
   at once (set-based: one long membership table, group-by cand_id), shared by
   all techniques. Per candidate:
     counts/shares, population-share PSI, bad rate + two-proportion z-test,
     AUC/Gini/KS (dev & mon, deltas = mon - dev), calibration drift (A/E ratio
     shift), score-shift KS p-value, exposure share + drift, in-segment feature
     PSI (mean + top feature), mean SHAP shift.
   Output column names equal the Python evaluate_segment dict keys.

   cand : surviving candidates (cand_id, c1..cN)  - see seg_candidate_filter
   out  : one row per candidate
   Side output: _sg_mem_mon_kept (cand_id,_rid) mon membership, appended by the
   caller for Jaccard de-duplication.
   Requires: sg_ndev sg_nmon sg_twdev sg_twmon sg_rca_feats
   ============================================================================ */
%macro seg_evaluate_candidates(cand=, out=, shap_cols=);

    %seg_membership(side=dev, cand=&cand, out=_sg_mem_dev, cols=_rid _y _s _w &sg_rca_feats &shap_cols);
    %seg_membership(side=mon, cand=&cand, out=_sg_mem_mon, cols=_rid _y _s _w &sg_rca_feats &shap_cols);

    proc sql;
        create table _sg_bd as
        select cand_id, count(*) as n_dev, sum(_y) as x_dev, sum(_s) as sum_s_dev, sum(_w) as w_dev
        from _sg_mem_dev group by cand_id order by cand_id;
        create table _sg_bm as
        select cand_id, count(*) as n_mon, sum(_y) as x_mon, sum(_s) as sum_s_mon, sum(_w) as w_mon
        from _sg_mem_mon group by cand_id order by cand_id;
    quit;

    data _sg_cnt;
        merge _sg_bd(keep=cand_id n_dev) _sg_bm(keep=cand_id n_mon);
        by cand_id;
    run;

    %seg_auc_ks(mem=_sg_mem_dev, out=_sg_akd);
    %seg_auc_ks(mem=_sg_mem_mon, out=_sg_akm);
    %seg_ks_shift(mem_dev=_sg_mem_dev, mem_mon=_sg_mem_mon, cnt=_sg_cnt, out=_sg_ksh);
    %seg_feature_psi(mem_dev=_sg_mem_dev, mem_mon=_sg_mem_mon, feats=&sg_rca_feats, cnt=_sg_cnt,
                     out_long=_sg_fpsi, out_agg=_sg_fagg);
    %seg_shap_shift(mem_dev=_sg_mem_dev, mem_mon=_sg_mem_mon, shap_cols=&shap_cols, cnt=_sg_cnt,
                    out=_sg_shp);

    data &out;
        merge _sg_bd _sg_bm
              _sg_akd(rename=(auc=auc_dev ks=ks_dev))
              _sg_akm(rename=(auc=auc_mon ks=ks_mon))
              _sg_ksh(keep=cand_id score_shift_pvalue)
              _sg_fagg _sg_shp;
        by cand_id;

        pct_dev = n_dev / &sg_ndev;
        pct_mon = n_mon / &sg_nmon;

        /* single-bin PSI contribution (metrics/drift_metrics.calculate_psi) */
        _d = max(pct_dev, 1e-6);
        _m = max(pct_mon, 1e-6);
        psi = (_m - _d) * log(_m / _d);

        br_dev   = x_dev / n_dev;
        br_mon   = x_mon / n_mon;
        delta_br = br_mon - br_dev;

        /* two-proportion z-test (metrics/significance.two_proportion_ztest_pvalue) */
        _pp    = (x_dev + x_mon) / (n_dev + n_mon);
        _denom = _pp * (1 - _pp) * (1 / n_dev + 1 / n_mon);
        if _denom <= 0 then br_pvalue = .;
        else br_pvalue = 2 * (1 - probnorm(abs(((x_mon / n_mon) - (x_dev / n_dev)) / sqrt(_denom))));

        gini_dev = ifn(missing(auc_dev), ., 2 * auc_dev - 1);
        gini_mon = ifn(missing(auc_mon), ., 2 * auc_mon - 1);
        if missing(auc_dev) or missing(auc_mon)   then delta_auc  = .; else delta_auc  = auc_mon  - auc_dev;
        if missing(gini_dev) or missing(gini_mon) then delta_gini = .; else delta_gini = gini_mon - gini_dev;
        if missing(ks_dev) or missing(ks_mon)     then delta_ks   = .; else delta_ks   = ks_mon   - ks_dev;

        /* A/E ratio shift (metrics/performance_metrics.calculate_calibration_drift) */
        calibration_drift = x_mon / max(sum_s_mon, 1e-6) - x_dev / max(sum_s_dev, 1e-6);

        weight_dev     = w_dev;
        weight_mon     = w_mon;
        dev_weight_pct = ifn(&sg_twdev > 0, w_dev / &sg_twdev, 0);
        mon_weight_pct = ifn(&sg_twmon > 0, w_mon / &sg_twmon, 0);
        exposure_drift = mon_weight_pct - dev_weight_pct;

        drop _d _m _pp _denom sum_s_dev sum_s_mon w_dev w_mon;
    run;

%mend seg_evaluate_candidates;

/* >>>>>>>>>>>>>>>> seg_bh.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_bh.sas
   Benjamini-Hochberg FDR adjustment (metrics/significance.adjust_p_values_bh).
   Missing p-values are excluded from the family and stay missing. Tied
   p-values all receive the adjusted value of the highest rank in the tie
   (reverse cumulative minimum), so the result does not depend on tie order.
   in : table with cand_id and &pvar     out: cand_id, &adjvar
   ============================================================================ */
%macro seg_bh(in=, pvar=, adjvar=, out=);

    %local nv;

    data _sg_bh_a(keep=cand_id p);
        set &in(keep=cand_id &pvar rename=(&pvar=p));
        if not missing(p);
    run;
    %let nv = %seg_nobs(_sg_bh_a);

    %if &nv = 0 %then %do;
        data &out; length cand_id 8 &adjvar 8; stop; run;
    %end;
    %else %do;
        proc sort data=_sg_bh_a; by p cand_id; run;

        data _sg_bh_b;
            set _sg_bh_a;
            rnk = _n_;
            v   = p * &nv / rnk;
        run;

        proc sort data=_sg_bh_b; by descending rnk; run;

        data _sg_bh_c(keep=cand_id &adjvar);
            set _sg_bh_b;
            retain cm 1e300;
            cm = min(cm, v);
            &adjvar = min(cm, 1);
        run;

        proc sort data=_sg_bh_c out=&out; by cand_id; run;
    %end;

%mend seg_bh;

/* >>>>>>>>>>>>>>>> seg_score_candidates.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_score_candidates.sas
   SAS port of core/candidate_ranking.compute_severity_scores - the scoring
   shared by AutoSlicer, Drift Tree, Gradient Boosting and K-Means.

   Over the WHOLE evaluated pool (so the pool must match Python's to match):
     * BH-adjusted p-values for bad-rate and score-shift tests
     * Business_Impact_Score, SIS, DIS, DIS_Symmetric (metrics/business_metrics)
     * min-max normalisation of SIS, DIS, mean_feature_psi, mean_shap_shift
     * root_cause_score = .35 nSIS + .30 nDIS + .20 nPSI + .15 nSHAP
     * Severity_Score = round(root_cause_score*20, 4)
     * Statistically_Significant = adj p (bad rate) <= alpha OR adj p (KS) <= alpha
     * Drift_Explanation text, Portfolio_Impact_Score
   in  : evaluated pool (seg_evaluate_candidates columns + Segment_Definition)
   out : same rows + scoring columns (names identical to the Python records)
   ============================================================================ */
%macro seg_score_candidates(in=, out=, alpha=0.05);

    %local sis_lo sis_hi dis_lo dis_hi psi_lo psi_hi shp_lo shp_hi;

    %seg_bh(in=&in, pvar=br_pvalue,          adjvar=p_br_adj, out=_sg_bh1);
    %seg_bh(in=&in, pvar=score_shift_pvalue, adjvar=p_ks_adj, out=_sg_bh2);

    proc sort data=&in out=_sg_sc0; by cand_id; run;

    data _sg_sc1;
        merge _sg_sc0 _sg_bh1 _sg_bh2;
        by cand_id;
        bus_impact = (pct_mon * mon_weight_pct) * (1 + psi + max(0, -delta_gini));
        auc_drop   = max(0, -delta_auc);
        conf       = min(1, sqrt(max(0, n_mon) / 100));
        ef         = ifn(mon_weight_pct > 0, mon_weight_pct, 1);
        popd       = pct_mon - pct_dev;
        sis        = auc_drop * ef * pct_mon * conf;
        dis        = max(0, popd * auc_drop * ef * (1 + max(0, mean_feature_psi)));
        dis_sym    = abs(popd) * auc_drop * ef * (1 + max(0, mean_feature_psi));
    run;

    proc sql noprint;
        select min(sis) format=best32., max(sis) format=best32., min(dis) format=best32., max(dis) format=best32., min(mean_feature_psi) format=best32., max(mean_feature_psi) format=best32.,
               min(mean_shap_shift) format=best32., max(mean_shap_shift) format=best32.
          into :sis_lo trimmed, :sis_hi trimmed, :dis_lo trimmed, :dis_hi trimmed,
               :psi_lo trimmed, :psi_hi trimmed, :shp_lo trimmed, :shp_hi trimmed
          from _sg_sc1;
    quit;

    data &out;
        set _sg_sc1;
        length PSI_Interpretation $60 Drift_Explanation $1000 _t $400;

        /* metrics/significance.min_max_normalize: zeros when range < 1e-9 */
        if &sis_hi - &sis_lo < 1e-9 then n_sis = 0; else n_sis = (sis - &sis_lo) / (&sis_hi - &sis_lo);
        if &dis_hi - &dis_lo < 1e-9 then n_dis = 0; else n_dis = (dis - &dis_lo) / (&dis_hi - &dis_lo);
        if &psi_hi - &psi_lo < 1e-9 then n_psi = 0; else n_psi = (mean_feature_psi - &psi_lo) / (&psi_hi - &psi_lo);
        if &shp_hi - &shp_lo < 1e-9 then n_shp = 0; else n_shp = (mean_shap_shift - &shp_lo) / (&shp_hi - &shp_lo);

        rcs = 0.35 * n_sis + 0.30 * n_dis + 0.20 * n_psi + 0.15 * n_shp;

        BadRate_pvalue_adj    = ifn(missing(p_br_adj), 1, p_br_adj);
        ScoreShift_pvalue_adj = ifn(missing(p_ks_adj), 1, p_ks_adj);
        Statistically_Significant = (BadRate_pvalue_adj <= &alpha) or (ScoreShift_pvalue_adj <= &alpha);

        Business_Impact_Score = round(bus_impact, 0.0001);
        SIS_Raw         = round(sis, 0.000001);
        DIS_Raw         = round(dis, 0.000001);
        DIS_Symmetric   = round(dis_sym, 0.000001);
        Confidence_Score = round(conf, 0.0001);
        root_cause_score = round(rcs, 0.000001);
        Severity_Score   = round(rcs * 20, 0.0001);
        Portfolio_Impact_Score = round(ifn(missing(delta_gini), 0, pct_mon * abs(delta_gini)), 0.000001);

        if psi < 0.1 then PSI_Interpretation = 'Population Share: Stable';
        else if psi <= 0.25 then PSI_Interpretation = 'Population Share: Moderate Drift';
        else PSI_Interpretation = 'Population Share: Significant Drift';

        /* _build_drift_reasons() */
        Drift_Explanation = '';
        if psi > 0.10 then do;
            _t = 'Population shift (Dev ' || strip(put(100 * pct_dev, 8.1)) || '% -> Mon '
                 || strip(put(100 * pct_mon, 8.1)) || '%, PSI ' || strip(put(psi, 12.4)) || ')';
            Drift_Explanation = catx(' | ', Drift_Explanation, _t);
        end;
        if not missing(delta_gini) and delta_gini < -0.05 then do;
            _t = 'Gini drop ' || strip(put(abs(delta_gini), 12.4)) || ' (Dev ' || strip(put(gini_dev, 12.4))
                 || ' -> Mon ' || strip(put(gini_mon, 12.4)) || ')';
            Drift_Explanation = catx(' | ', Drift_Explanation, _t);
        end;
        if not missing(delta_ks) and delta_ks < -0.05 then do;
            _t = 'KS drop ' || strip(put(abs(delta_ks), 12.4)) || ' (Dev ' || strip(put(ks_dev, 12.4))
                 || ' -> Mon ' || strip(put(ks_mon, 12.4)) || ')';
            Drift_Explanation = catx(' | ', Drift_Explanation, _t);
        end;
        if not missing(delta_br) and abs(delta_br) > 0.03 and BadRate_pvalue_adj <= &alpha then do;
            _t = 'Significant bad-rate shift (Dev ' || strip(put(100 * br_dev, 8.2)) || '% -> Mon '
                 || strip(put(100 * br_mon, 8.2)) || '%, p_adj=' || strip(put(BadRate_pvalue_adj, 12.4)) || ')';
            Drift_Explanation = catx(' | ', Drift_Explanation, _t);
        end;
        if psi < 0.10 and not missing(delta_gini) and abs(delta_gini) >= 0.05 then do;
            _t = 'Population share stable (low PSI) but the score no longer separates risk inside this segment -- concept drift, not exposure drift';
            Drift_Explanation = catx(' | ', Drift_Explanation, _t);
        end;
        if missing(Drift_Explanation) then Drift_Explanation = 'Segment performance stable';

        drop p_br_adj p_ks_adj bus_impact auc_drop conf ef popd sis dis dis_sym n_sis n_dis n_psi n_shp rcs _t;
    run;

%mend seg_score_candidates;

/* >>>>>>>>>>>>>>>> seg_rank_dedup.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_rank_dedup.sas
   Significance-first ranking + Jaccard/containment de-duplication
   (core/candidate_ranking.rank_records_significance_first and
    core/candidate_deduplication.deduplicate_by_jaccard).

   Order: Statistically_Significant desc, Severity_Score desc, then original
   evaluation order (cand_id asc) - the same as Python's stable sort.
   A candidate is dropped when, against any already-kept candidate (monitoring
   rows), jaccard >= overlap OR containment(cand in kept) >= 0.90 OR
   containment(kept in cand) >= 0.90. Selection stops at pool_size kept.
   Pairwise monitoring-row intersections come from one self-join on _rid.

   in      : scored pool (cand_id, n_mon, Statistically_Significant, Severity_Score)
   sortby  : ranking key; Feature Binning ranks by its own final score instead
   mem_mon : cand_id, _rid for every pool candidate
   out     : kept candidates, in rank order, with column dedup_rank (1..)
   ============================================================================ */
%macro seg_rank_dedup(in=, mem_mon=, out=, overlap=0.70, containment=0.90, pool_size=30, dedup=Y,
                      sortby=%str(descending Statistically_Significant descending Severity_Score cand_id));

    proc sort data=&in out=_sg_rk1;
        by &sortby;
    run;

    /* dedup=N (Drift Tree, K-Means): ranking only - Python never de-duplicates there */
    %if %upcase(&dedup) ne Y %then %do;
        data &out;
            set _sg_rk1;
            dedup_rank = _n_;
        run;
        %return;
    %end;

    proc sql;
        create table _sg_pairs as
        select a.cand_id as ca, b.cand_id as cb, count(*) as inter
        from &mem_mon a inner join &mem_mon b
             on a._rid = b._rid and a.cand_id < b.cand_id
        group by a.cand_id, b.cand_id;
    quit;

    data &out;
        if _n_ = 1 then do;
            if 0 then set _sg_pairs;
            declare hash hp(dataset: '_sg_pairs');
            hp.defineKey('ca', 'cb');
            hp.defineData('inter');
            hp.defineDone();
        end;
        set _sg_rk1;
        array kc [&pool_size] _temporary_;
        array kn [&pool_size] _temporary_;
        retain nk 0;
        redundant = 0;
        do _k = 1 to nk;
            ca = min(cand_id, kc[_k]);
            cb = max(cand_id, kc[_k]);
            if hp.find() ne 0 then inter = 0;
            _union = n_mon + kn[_k] - inter;
            _jac   = ifn(_union > 0, inter / _union, 0);
            _cc    = ifn(n_mon > 0, inter / n_mon, 0);
            _ck    = ifn(kn[_k] > 0, inter / kn[_k], 0);
            if _jac >= &overlap or _cc >= &containment or _ck >= &containment then do;
                redundant = 1;
                leave;
            end;
        end;
        if redundant = 0 and nk < &pool_size then do;
            nk + 1;
            kc[nk] = cand_id;
            kn[nk] = n_mon;
            dedup_rank = nk;
            output;
        end;
        drop ca cb inter redundant _k _union _jac _cc _ck nk;
    run;

%mend seg_rank_dedup;

/* >>>>>>>>>>>>>>>> seg_eval_pool.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_eval_pool.sas
   Evaluation step for techniques whose candidates are known up front (tree
   leaves, clusters, boosted-tree leaves): gate -> evaluate -> append to the
   accumulating tables read by seg_publish. Needs sg_premem = Y and the
   membership tables _sg_memb_dev / _sg_memb_mon.

   cand  : table with cand_id (all candidates, in Python evaluation order)
   defs  : cand_id, Segment_Definition [, extra technique columns, e.g. Leaf_ID]
   rules : cand_id, feature, feat_idx, ptype, lower, upper, lo_inf, hi_inf, value, label
   Appends to: _sg_pool _sg_memmon_all _sg_rules_all _sg_fpsi_all
   ============================================================================ */
%macro seg_eval_pool(cand=, defs=, rules=, shap_cols=);

    proc datasets lib=work nolist nowarn;
        delete _sg_pool _sg_memmon_all _sg_rules_all _sg_fpsi_all;
    quit;

    %seg_candidate_filter(cand=&cand, out=_sg_surv);

    %if %seg_nobs(_sg_surv) = 0 %then %do;
        %put NOTE: seg_eval_pool - no candidate passed the support/event gates.;
    %end;
    %else %do;
        %seg_evaluate_candidates(cand=_sg_surv, out=_sg_ev, shap_cols=&shap_cols);

        proc sort data=&defs out=_sg_defs_s; by cand_id; run;
        data _sg_pool;
            merge _sg_ev(in=_a) _sg_defs_s;
            by cand_id;
            if _a;
        run;

        proc sql;
            create table _sg_rules_all as
            select * from &rules where cand_id in (select cand_id from _sg_surv);
        quit;

        data _sg_fpsi_all; set _sg_fpsi; run;
        data _sg_memmon_all(keep=cand_id _rid); set _sg_mem_mon; run;
    %end;

%mend seg_eval_pool;

/* >>>>>>>>>>>>>>>> seg_publish.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_publish.sas
   Shared tail of AutoSlicer / Drift Tree / Gradient Boosting / K-Means:
   score the whole evaluated pool (seg_score_candidates), significance-first
   rank, optional Jaccard de-dup, keep top_n, and write the public tables.

   Reads : _sg_pool _sg_memmon_all _sg_rules_all _sg_fpsi_all (may not exist =
           no candidate survived)
   Writes: &out_prefix._segments _rules _portfolio _feature_psi _pool _log
   dedup : Y (AutoSlicer, Gradient Boosting) | N (Drift Tree, K-Means)
   dropvars : internal columns to drop from the public segments table
   Column names follow the Python public output (Dev_Count ... Root_Cause_Score).
   ============================================================================ */
%macro seg_publish(technique=, out_prefix=, top_n=10, dedup=Y, overlap=0.70, pool_size=30,
                   alpha=0.05, dropvars=, portfolio_n=);

    %if not %length(&portfolio_n) %then %let portfolio_n = &top_n;

    %if not %sysfunc(exist(_sg_pool)) %then %do;
        %put NOTE: seg_publish - &technique produced no candidates.;
        data &out_prefix._segments; length Technique $40 Rank 8 Segment_Definition $1000; stop; run;
        data &out_prefix._rules;    length Rank 8 cand_id 8 feature $64; stop; run;
        data &out_prefix._portfolio; length Rank 8 Segment $1000; stop; run;
        data &out_prefix._feature_psi; length Rank 8 cand_id 8 feature $64 psi 8; stop; run;
        data &out_prefix._pool; length cand_id 8 Segment_Definition $1000; stop; run;
    %end;
    %else %do;
        %seg_score_candidates(in=_sg_pool, out=_sg_scored, alpha=&alpha);
        %seg_rank_dedup(in=_sg_scored, mem_mon=_sg_memmon_all, out=_sg_dd,
                        overlap=&overlap, pool_size=&pool_size, dedup=&dedup);

        data _sg_top;
            length Technique $40;
            set _sg_dd(obs=&top_n);
            Rank = dedup_rank;
            Technique = "&technique";
        run;

        data &out_prefix._pool; set _sg_scored; run;

        data &out_prefix._segments;
            length Technique $40 Rank 8 Segment_Definition $1000;
            set _sg_top(drop=dedup_rank &dropvars
                        rename=(n_dev=Dev_Count n_mon=Mon_Count pct_dev=Dev_Pct pct_mon=Mon_Pct
                                br_dev=Dev_BR br_mon=Mon_BR
                                auc_dev=Dev_AUC auc_mon=Mon_AUC
                                gini_dev=Dev_Gini gini_mon=Mon_Gini
                                ks_dev=Dev_KS ks_mon=Mon_KS
                                weight_dev=Dev_EAD weight_mon=Mon_EAD
                                dev_weight_pct=Dev_Exposure_Pct mon_weight_pct=Mon_Exposure_Pct
                                exposure_drift=Exposure_Drift calibration_drift=Calibration_Drift
                                top_drift_feature=Root_Cause_Feature top_drift_psi=Root_Cause_PSI
                                root_cause_score=Root_Cause_Score));
        run;

        /* case-only renames (SAS names are case-insensitive) */
        %seg_fix_case(ds=&out_prefix._segments, names=PSI Delta_BR Delta_AUC Delta_Gini Delta_KS);

        proc sql;
            create table &out_prefix._rules as
            select t.Rank, t.cand_id, r.feature, r.ptype, r.lower, r.upper, r.lo_inf, r.hi_inf,
                   r.value, r.label
            from _sg_top t inner join _sg_rules_all r on t.cand_id = r.cand_id
            order by t.Rank, r.feat_idx;

            create table &out_prefix._feature_psi as
            select t.Rank, f.cand_id, f.feature, f.psi
            from _sg_top t inner join _sg_fpsi_all f on t.cand_id = f.cand_id
            order by t.Rank, f.feat_idx;
        quit;

        proc sort data=_sg_top(where=(Statistically_Significant = 1)) out=_sg_pf;
            by descending Portfolio_Impact_Score cand_id;
        run;
        data &out_prefix._portfolio;
            set _sg_pf(obs=&portfolio_n);
            Rank = _n_;
            Segment = Segment_Definition;
            Population_Pct = pct_mon;
            Severity_PopulationXGini = Portfolio_Impact_Score;
            Delta_Gini = delta_gini;
            Delta_KS   = delta_ks;
            Delta_BR   = delta_br;
            keep Rank Segment Population_Pct Delta_Gini Delta_KS Delta_BR Severity_PopulationXGini
                 SIS_Raw Statistically_Significant;
        run;
    %end;

    data &out_prefix._log;
        technique            = "&technique";
        total_dev_n          = &sg_ndev;
        total_mon_n          = &sg_nmon;
        min_abs_count        = &sg_minabs;
        min_support          = &sg_minsup;
        candidates_evaluated = %seg_nobs(&out_prefix._pool);
        candidates_returned  = %seg_nobs(&out_prefix._segments);
        run_datetime         = datetime();
        format run_datetime datetime20.;
    run;

%mend seg_publish;

/* >>>>>>>>>>>>>>>> seg_tree_matrix.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_tree_matrix.sas
   SAS port of utils/preprocessing.build_feature_matrix for the tree techniques
   (Drift Tree, Gradient Boosting), applied to the COMBINED dev+mon rows:
     * numeric columns: missing -> median of the combined column, then rounded
       to float32 (scikit-learn casts X to float32 before fitting/applying)
     * categorical columns: one 0/1 column per distinct value of the combined
       data in sorted order (missing -> the string 'nan', as astype(str) does; K-Means passes
       miss=__MISSING__ and scope=DEV)
   Column order = numeric_cols then categorical_cols, as in Python.

   in  : _sg_dev / _sg_mon (from seg_prep)
   out : &out  (_tid 1..ndev+nmon [dev first], y = 1 for monitoring, x1..xp)
         &map  (fidx, kind N|C, src_idx, srcname, val)  maps x<fidx> back to its
               source feature (and category) - used to render/canonicalise rules
   Global: sg_tr_p = number of generated columns p
   Requires: sg_ndev sg_nmon
   ============================================================================ */
%macro seg_tree_matrix(numeric_cols=, categorical_cols=, out=_tr_x, map=_tr_map, scope=COMBINED, miss=nan);

    %global sg_tr_p;
    %local nn nc j c v p med;

    %let nn = %sysfunc(countw(&numeric_cols, %str( )));
    %let nc = %sysfunc(countw(&categorical_cols, %str( )));

    %if %upcase(&scope) = DEV %then %do;
        /* K-Means rule distillation: dev rows only, _tid = dev row id */
        data _tr_stk;
            set _sg_dev(keep=&numeric_cols &categorical_cols);
            y    = 0;
            _tid = _n_;
        run;
    %end;
    %else %do;
        data _tr_stk;
            set _sg_dev(in=_a keep=&numeric_cols &categorical_cols)
                _sg_mon(keep=&numeric_cols &categorical_cols);
            y    = (_a = 0);
            _tid = _n_;
        run;
    %end;

    /* ---- map: numeric columns first, then categories of each categorical column ---- */
    data &map;
        length fidx 8 kind $1 src_idx 8 srcname $64 val $200;
        stop;
    run;
    %do j = 1 %to &nn;
        %let v = %scan(&numeric_cols, &j, %str( ));
        data _tr_m1; length kind $1 srcname $64 val $200; kind = 'N'; src_idx = &j; srcname = "&v"; val = ''; run;
        proc append base=&map data=_tr_m1 force; run;
    %end;
    %do c = 1 %to &nc;
        %let v = %scan(&categorical_cols, &c, %str( ));
        proc sql;
            create table _tr_m2 as
            select distinct 'C' as kind length=1, %eval(&nn + &c) as src_idx, "&v" as srcname length=64,
                   coalescec(strip(&v), "&miss") as val length=200
            from _tr_stk
            order by val;
        quit;
        proc append base=&map data=_tr_m2 force; run;
    %end;
    data &map; set &map; fidx = _n_; run;
    proc sql noprint; select count(*) into :p trimmed from &map; quit;
    %let sg_tr_p = &p;

    /* ---- medians of the combined numeric columns ---- */
    %if &nn > 0 %then %do;
        proc means data=_tr_stk noprint;
            var &numeric_cols;
            output out=_tr_med(drop=_type_ _freq_) median=;
        run;
        data _null_;
            set _tr_med;
            %do j = 1 %to &nn;
                call symputx("med&j", put(%scan(&numeric_cols, &j, %str( )), best32.), 'L');
            %end;
        run;
    %end;

    /* ---- matrix: float32-rounded numeric values + one-hot indicators ---- */
    data &out(keep=_tid y x1-x&p);
        array x [&p] x1-x&p;
        array mval  [&p] $200 _temporary_;
        array msrc  [&p] _temporary_;
        array mkind [&p] $1 _temporary_;
        if _n_ = 1 then do;
            do until(_e);
                set &map(keep=fidx kind src_idx val) end=_e;
                mval[fidx] = val; msrc[fidx] = src_idx; mkind[fidx] = kind;
            end;
        end;
        set _tr_stk;
        %do j = 1 %to &nn;
            %let v = %scan(&numeric_cols, &j, %str( ));
            _t = coalesce(&v, &&med&j);
            %seg_f32(x=_t, into=_t32)
            x[&j] = _t32;
        %end;
        %do c = 1 %to &nc;
            %let v = %scan(&categorical_cols, &c, %str( ));
            _v = coalescec(strip(&v), "&miss");
            do _k = %eval(&nn + 1) to &p;
                if mkind[_k] = 'C' and msrc[_k] = %eval(&nn + &c) then x[_k] = (mval[_k] = _v);
            end;
        %end;
    run;

%mend seg_tree_matrix;

/* >>>>>>>>>>>>>>>> seg_tree_presort.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_tree_presort.sas
   Sorts the tree matrix once per feature: _trs<j>(_tid, x<j>) ascending in x<j>.
   Reused by every node/level of seg_tree_fit - and by every one of the 50-150
   trees of Gradient Boosting, because the features never change between trees.
   ============================================================================ */
%macro seg_tree_presort(data=, p=);
    %local j;
    %do j = 1 %to &p;
        proc sort data=&data(keep=_tid x&j) out=_trs&j;
            by x&j _tid;
        run;
    %end;
%mend seg_tree_presort;

/* >>>>>>>>>>>>>>>> seg_tree_fit.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_tree_fit.sas
   A CART tree in plain Base SAS that reproduces scikit-learn's greedy "best"
   splitter (DecisionTreeClassifier gini / DecisionTreeRegressor friedman_mse),
   so Drift Tree / Gradient Boosting / K-Means-rule leaves are the SAME
   partitions as Python's (verified: Drift Tree 15/15 leaves, multiclass 15/15,
   20/20 boosted trees identical to sklearn on the demo data).

   Why not PROC TREESPLIT/HPSPLIT/GRADBOOST: they bin interval inputs, prune
   and use different defaults, so their leaves cannot match sklearn's; this also
   needs no VDMML licence. Cost: one pass per feature per level (rows are
   pre-sorted once by seg_tree_presort). Leaf values for boosting are computed by
   the caller.

   Split search (level by level; node ids are heap ids: root 1, children 2k,2k+1):
     for every feature in column order, stream the rows in ascending x; for each
     node keep running left-side counts; a split point lies between two
     consecutive rows whose x differ by > 1e-7; both sides need >= min_leaf rows;
     the threshold is the midpoint (x_prev/2 + x/2, as sklearn);
     the best split per node maximises
        GINI : sum_k left_k^2/n_left + sum_k right_k^2/n_right      (min gini)
        FMSE : n_l n_r (mean_l - mean_r)^2 / (n_l + n_r)            (friedman)
     a strictly better split replaces the incumbent, so ties go to the earlier
     feature / smaller threshold. (sklearn visits features in random order, so
     exact ties between DIFFERENT features - e.g. the two complementary one-hot
     columns of a binary categorical - may resolve differently; membership is
     identical, only the rule text can differ.)
   A node is a leaf if depth = max_depth, n < 2 or n < 2*min_leaf, or it is pure
   (gini: one class; fmse: variance <= 2.2e-16), or no valid split exists.

   data   : _tid, x1..xp (float32-rounded), &tvar
            (GINI: integer class 0..ncls-1;  FMSE: real target)
   Needs  : _trs1.._trs<p> from seg_tree_presort
   out_nodes: node_id depth feat thr n is_leaf path preorder
              (path = L/R bits as 0/1; preorder = sklearn node_id numbering)
   out_rows : _tid, node (leaf id of every row)
   ============================================================================ */
%macro seg_tree_fit(data=, p=, tvar=, kind=GINI, ncls=2, max_depth=, min_leaf=,
                    out_nodes=, out_rows=);

    %local n maxnode d j k go nsplit nspl km1;
    %let kind  = %upcase(&kind);
    %let km1   = %eval(&ncls - 1);

    proc sql noprint; select count(*) into :n trimmed from &data; quit;
    %let maxnode = %eval(2 ** (&max_depth + 1));

    data _tr_row;
        set &data(keep=_tid x1-x&p &tvar);
        node = 1;
        _tt  = &tvar;
    run;

    data &out_nodes;
        length node_id 8 depth 8 feat 8 thr 8 n 8 is_leaf 8;
        stop;
    run;

    %let go = 1;
    %do d = 0 %to &max_depth;
      %if &go %then %do;

        /* ---- node statistics for this level ---- */
        proc sql;
            create table _tr_stat as
            select node, count(*) as n, sum(_tt) as s, sum(_tt * _tt) as ss
                   %if &kind = GINI %then %do k = 0 %to &km1; , sum(_tt = &k) as k&k %end;
            from _tr_row group by node;
        quit;

        data _tr_stat2;
            set _tr_stat;
            %if &kind = GINI %then %do;
                array kk [0:&km1] k0-k&km1;
                _mx = max(of k0-k&km1);
                pure = (_mx = n);
            %end;
            %else %do;
                pure = ((ss / n - (s / n) ** 2) <= 2.220446049250313e-16);
            %end;
            splittable = (&d < &max_depth) and (n >= 2) and (n >= 2 * &min_leaf) and (not pure);
        run;

        %let nspl = 0;
        proc sql noprint; select count(*) into :nspl trimmed from _tr_stat2 where splittable = 1; quit;

        data _tr_split; length node 8 feat 8 thr 8; stop; run;

        %if &nspl > 0 %then %do;

            data _tr_bestprev;
                set _tr_stat2(where=(splittable = 1) keep=node splittable);
                prox = -1e300; feat = 0; thr = .;
                keep node prox feat thr;
            run;

            %do j = 1 %to &p;
                data _tr_bestnew(keep=node prox feat thr);
                    array nd   [&n]       _temporary_;
                    array tv   [&n]       _temporary_;
                    array sp   [&maxnode] _temporary_;
                    array tn   [&maxnode] _temporary_;
                    array tsum [&maxnode] _temporary_;
                    array bprx [&maxnode] _temporary_;
                    array bft  [&maxnode] _temporary_;
                    array bth  [&maxnode] _temporary_;
                    array ln   [&maxnode] _temporary_;
                    array ls   [&maxnode] _temporary_;
                    array lx   [&maxnode] _temporary_;
                    %if &kind = GINI %then %do;
                        array tcl [&maxnode, &ncls] _temporary_;
                        array lcl [&maxnode, &ncls] _temporary_;
                    %end;
                    if _n_ = 1 then do;
                        do until(_e1);
                            set _tr_row(keep=_tid node _tt rename=(_tid=_i node=_nd _tt=_tv)) end=_e1;
                            nd[_i] = _nd; tv[_i] = _tv;
                        end;
                        do until(_e2);
                            set _tr_stat2(where=(splittable = 1) rename=(node=_nd n=_nn s=_ss)) end=_e2;
                            sp[_nd] = 1; tn[_nd] = _nn; tsum[_nd] = _ss;
                            %if &kind = GINI %then %do;
                                %do k = 0 %to &km1; tcl[_nd, %eval(&k + 1)] = k&k; %end;
                            %end;
                        end;
                        do until(_e3);
                            set _tr_bestprev(rename=(node=_nd prox=_px feat=_ft thr=_th)) end=_e3;
                            bprx[_nd] = _px; bft[_nd] = _ft; bth[_nd] = _th;
                        end;
                    end;

                    set _trs&j end=_last;
                    _nd = nd[_tid];
                    if _nd > 0 then if sp[_nd] = 1 then do;
                        _x = x&j;
                        if lx[_nd] ne . then if _x > lx[_nd] + 1e-7 then do;
                            _nl = ln[_nd];
                            _nr = tn[_nd] - _nl;
                            if _nl >= &min_leaf and _nr >= &min_leaf then do;
                                %if &kind = GINI %then %do;
                                    _a = 0; _b = 0;
                                    do _k = 1 to &ncls;
                                        _a = _a + sum(lcl[_nd, _k], 0) ** 2;
                                        _b = _b + (tcl[_nd, _k] - sum(lcl[_nd, _k], 0)) ** 2;
                                    end;
                                    _prox = _a / _nl + _b / _nr;
                                %end;
                                %else %do;
                                    _dd = ls[_nd] / _nl - (tsum[_nd] - ls[_nd]) / _nr;
                                    _prox = _nl * _nr * _dd * _dd / (_nl + _nr);
                                %end;
                                if _prox > bprx[_nd] then do;
                                    bprx[_nd] = _prox;
                                    bft[_nd]  = &j;
                                    _thr = lx[_nd] / 2 + _x / 2;
                                    if _thr = _x then _thr = lx[_nd];
                                    bth[_nd]  = _thr;
                                end;
                            end;
                        end;
                        ln[_nd] = sum(ln[_nd], 1);
                        lx[_nd] = _x;
                        %if &kind = GINI %then %do;
                            lcl[_nd, tv[_tid] + 1] = sum(lcl[_nd, tv[_tid] + 1], 1);
                        %end;
                        %else %do;
                            ls[_nd] = sum(ls[_nd], tv[_tid]);
                        %end;
                    end;
                    if _last then do;
                        do node = 1 to &maxnode - 1;
                            if sp[node] = 1 then do;
                                prox = bprx[node]; feat = bft[node]; thr = bth[node];
                                output;
                            end;
                        end;
                    end;
                run;
                data _tr_bestprev; set _tr_bestnew; run;
            %end;

            data _tr_split;
                set _tr_bestprev;
                where feat > 0;
                keep node feat thr;
            run;
        %end;

        %let nsplit = %seg_nobs(_tr_split);

        /* ---- record this level's nodes ---- */
        proc sql;
            insert into &out_nodes
            select s.node, &d, p.feat, p.thr, s.n, 0
            from _tr_stat2 s inner join _tr_split p on s.node = p.node;

            insert into &out_nodes
            select s.node, &d, 0, ., s.n, 1
            from _tr_stat2 s
            where s.node not in (select node from _tr_split);
        quit;

        /* ---- route rows of split nodes to their children ---- */
        %if &nsplit = 0 %then %let go = 0;
        %else %do;
            data _tr_row;
                if _n_ = 1 then do;
                    declare hash hs(dataset: '_tr_split');
                    hs.defineKey('node');
                    hs.defineData('feat', 'thr');
                    hs.defineDone();
                    call missing(feat, thr);
                end;
                set _tr_row;
                array x [&p] x1-x&p;
                if hs.find() = 0 then node = 2 * node + (x[feat] > thr);
                drop feat thr;
            run;
        %end;

      %end;
    %end;

    /* ---- outputs ---- */
    data &out_rows(keep=_tid node);
        set _tr_row;
    run;

    data &out_nodes;
        set &out_nodes;
        length path $64 _b $64;
        _b = put(node_id, binary32.);
        _b = strip(substr(_b, indexc(_b, '1')));
        if length(_b) > 1 then path = substr(_b, 2);   /* drop the leading 1: root = '' */
        else path = '';
    run;
    proc sort data=&out_nodes; by path; run;       /* '' < '0..' < '1..' => preorder */
    data &out_nodes;
        set &out_nodes;
        preorder = _n_ - 1;
        drop _b;
    run;

%mend seg_tree_fit;

/* >>>>>>>>>>>>>>>> seg_tree_rules.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_tree_rules.sas
   Turns the leaves of one or more fitted trees into human-readable rules and
   exact rule rows - the SAS port of utils/preprocessing.extract_tree_rules +
   canonicalize_path_conditions + simplify_rule_list.

   For each leaf (gid = tree id, 0 for single trees; leaf = heap node id):
     * walk root -> leaf collecting (feature, threshold, <= | >) conditions
       ('<=' goes left, '>' goes right; a one-hot column splits at 0.5)
     * canonicalise per SOURCE feature, in order of first appearance:
         numeric : lower = max of '>' thresholds, upper = min of '<=' thresholds
                   -> "f >= lower" then "f < upper";  lower >= upper => the
                   path is contradictory and the leaf is dropped (ok = 0)
         category: a positive "= v" wins over any "!= x"; otherwise the "!= x"
                   list sorted alphabetically
       categorical parts are listed before numeric parts
     * mode SIMPLIFY (Drift Tree, Gradient Boosting): equality parts first
       (simplify_rule_list); mode PLAIN (K-Means rules): canonical order
     * a leaf with no conditions gets &root_label

   nodes : gid, node_id, feat, thr, is_leaf ... (seg_tree_fit out_nodes + gid)
   map   : seg_tree_matrix map (fidx, kind, src_idx, srcname, val)
   Outputs
     &out_defs  : gid, leaf, ok, Segment_Definition
     &out_rules : gid, leaf, feature, feat_idx, ptype (N | C | X for "!="),
                  lower, upper, lo_inf, hi_inf, value, label     (EXACT thresholds)
   Display thresholds are rounded to 2 dp (seg_fmtnum); the rule rows carry the
   full-precision values - rounded text is NOT a faithful definition.
   ============================================================================ */
%macro seg_tree_rules(nodes=, map=, nsrc=, mode=SIMPLIFY, root_label=All Customers (Root),
                      out_defs=, out_rules=);

    /* ---- 1. conditions along every root->leaf path ---- */
    data _tr_cond(keep=gid leaf seq feat thr dir);
        length dir $2;
        if _n_ = 1 then do;
            declare hash hn(dataset: "&nodes(where=(is_leaf = 0) keep=gid node_id feat thr depth is_leaf)");
            hn.defineKey('gid', 'node_id');
            hn.defineData('feat', 'thr', 'depth');
            hn.defineDone();
        end;
        set &nodes(where=(is_leaf = 1) keep=gid node_id is_leaf rename=(node_id=leaf));
        call missing(feat, thr, depth);
        cur = leaf;
        do while(cur > 1);
            par = floor(cur / 2);
            node_id = par;
            if hn.find() = 0 then do;
                seq = depth;
                dir = ifc(mod(cur, 2) = 0, '<=', '>');
                output;
            end;
            cur = par;
        end;
    run;
    proc sort data=_tr_cond; by gid leaf seq; run;

    /* ---- 2. canonicalise ---- */
    data &out_defs(keep=gid leaf ok Segment_Definition)
         &out_rules(keep=gid leaf feature feat_idx ptype lower upper lo_inf hi_inf value label);
        array mkind [&sg_tr_p] $1   _temporary_;
        array msrc  [&sg_tr_p]      _temporary_;
        array mval  [&sg_tr_p] $200 _temporary_;
        array skind [&nsrc] $1  _temporary_;
        array sname [&nsrc] $64 _temporary_;
        array lo    [&nsrc]     _temporary_;
        array up    [&nsrc]     _temporary_;
        array fseq  [&nsrc]     _temporary_;
        array posv  [&nsrc] $200  _temporary_;
        array negs  [&nsrc] $2000 _temporary_;
        array ng    [60] $200 _ng1-_ng60;
        length feature $64 ptype $1 value $200 label $400 Segment_Definition $1000
               cat_text eq_text neg_text num_text $1000 part part2 $400 _v1 _v2 $40;

        if _n_ = 1 then do;
            do until(_e);
                set &map(keep=fidx kind src_idx srcname val) end=_e;
                mkind[fidx] = kind; msrc[fidx] = src_idx; mval[fidx] = val;
                skind[src_idx] = kind; sname[src_idx] = srcname;
            end;
        end;

        set _tr_cond;
        by gid leaf;

        if first.leaf then do;
            do _s = 1 to &nsrc; lo[_s] = .; up[_s] = .; fseq[_s] = .; posv[_s] = ''; negs[_s] = ''; end;
            fcount = 0;
        end;

        _s = msrc[feat];
        if fseq[_s] = . then do; fcount + 1; fseq[_s] = fcount; end;
        if mkind[feat] = 'N' then do;
            if dir = '<=' then up[_s] = min(up[_s], thr);
            else lo[_s] = max(lo[_s], thr);
        end;
        else do;
            if dir = '<=' then negs[_s] = catx('|', negs[_s], mval[feat]);
            else posv[_s] = mval[feat];
        end;

        if last.leaf then do;
            ok = 1;
            cat_text = ''; eq_text = ''; neg_text = ''; num_text = '';

            /* categorical sources, first-appearance order */
            do _f = 1 to fcount;
                do _s = 1 to &nsrc;
                    if fseq[_s] = _f and skind[_s] = 'C' then do;
                        feature = sname[_s]; feat_idx = _s; lower = .; upper = .; lo_inf = 0; hi_inf = 0;
                        if posv[_s] ne '' then do;
                            part = catx(' ', sname[_s], '=', posv[_s]);
                            cat_text = catx(' AND ', cat_text, part);
                            eq_text  = catx(' AND ', eq_text, part);
                            ptype = 'C'; value = posv[_s]; label = part; output &out_rules;
                        end;
                        else do;
                            _nn = countw(negs[_s], '|');
                            do _q = 1 to 60; ng[_q] = repeat('~', 4); end;
                            do _q = 1 to _nn; ng[_q] = scan(negs[_s], _q, '|'); end;
                            call sortc(of ng[*]);
                            do _q = 1 to _nn;
                                part = catx(' ', sname[_s], '!=', ng[_q]);
                                cat_text = catx(' AND ', cat_text, part);
                                neg_text = catx(' AND ', neg_text, part);
                                ptype = 'X'; value = ng[_q]; label = part; output &out_rules;
                            end;
                        end;
                    end;
                end;
            end;

            /* numeric sources, first-appearance order */
            do _f = 1 to fcount;
                do _s = 1 to &nsrc;
                    if fseq[_s] = _f and skind[_s] = 'N' then do;
                        if lo[_s] ne . and up[_s] ne . then if lo[_s] >= up[_s] then ok = 0;
                        feature = sname[_s]; feat_idx = _s; ptype = 'N'; value = '';
                        lower = lo[_s]; upper = up[_s]; lo_inf = (lo[_s] = .); hi_inf = (up[_s] = .);
                        part = ''; part2 = '';
                        if lo[_s] ne . then do;
                            %seg_fmtnum(x=lo[_s], into=_v1)
                            part = catx(' ', sname[_s], '>=', _v1);
                        end;
                        if up[_s] ne . then do;
                            %seg_fmtnum(x=up[_s], into=_v2)
                            part2 = catx(' ', sname[_s], '<', _v2);
                        end;
                        label = catx(' AND ', part, part2);
                        num_text = catx(' AND ', num_text, part, part2);
                        output &out_rules;
                    end;
                end;
            end;

            %if %upcase(&mode) = SIMPLIFY %then %do;
                Segment_Definition = catx(' AND ', eq_text, neg_text, num_text);
            %end;
            %else %do;
                Segment_Definition = catx(' AND ', cat_text, num_text);
            %end;
            if missing(Segment_Definition) then Segment_Definition = "&root_label";
            output &out_defs;
        end;
    run;

%mend seg_tree_rules;

/* >>>>>>>>>>>>>>>> seg_as_pred_num.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_as_pred_num.sas
   AutoSlicer predicates for ONE numeric feature (techniques/autoslicer.py:
   build_feature_bins). Quantile bins are fit on DEV non-missing values:
     edges = unique(numpy-linear quantiles at linspace(0,1,nbins+1));
     first/last edge -> -inf/+inf; bin j = [edge_j, edge_j+1).
   Appends predicates to _sg_pred and adds column _b&i (matched pred_id, or -1
   for missing) to _sg_dev and _sg_mon. Missing never matches a numeric bin
   (SAS would otherwise treat missing as smaller than every number).
   Requires: sg_npred (running pred counter), seg_quantile_t7_by, seg_fmtnum
   ============================================================================ */
%macro seg_as_pred_num(f=, i=, nbins=);

    %local base knew side tab;
    %let base = &sg_npred;

    data _sg_x;
        set _sg_dev(keep=&f);
        where not missing(&f);
        _g = 1;
    run;
    proc sort data=_sg_x; by _g &f; run;

    %if %seg_nobs(_sg_x) = 0 %then %do;
        data _sg_ed&i; k = 0; array e[30] e1-e30; run;
    %end;
    %else %do;
        %seg_quantile_t7_by(in=_sg_x, by=_g, var=&f, nbins=&nbins, out=_sg_q);

        data _sg_ed&i(keep=k e1-e30)
             _sg_predtmp(keep=pred_id feat_idx feature ptype lower upper lo_inf hi_inf value label);
            set _sg_q;
            array q [0:&nbins] q0-q&nbins;
            array ue[%eval(&nbins + 1)] _u1-_u%eval(&nbins + 1);
            array e [30] e1-e30;
            length feature $64 ptype $1 value $200 label $400 _lo $40 _hi $40;
            nu = 0;
            do _j = 0 to &nbins;                       /* numpy.unique on sorted quantiles */
                if nu = 0 then do; nu = 1; ue[1] = q[_j]; end;
                else if q[_j] ne ue[nu] then do; nu + 1; ue[nu] = q[_j]; end;
            end;
            k = max(nu - 1, 0);                        /* number of bins */
            do _j = 2 to nu - 1; e[_j - 1] = ue[_j]; end;      /* interior edges */
            output _sg_ed&i;

            do _j = 1 to k;
                pred_id  = &base + _j;
                feat_idx = &i;
                feature  = "&f";
                ptype    = 'N';
                value    = '';
                lo_inf   = (_j = 1);
                hi_inf   = (_j = k);
                lower    = ifn(lo_inf, ., ue[_j]);
                upper    = ifn(hi_inf, ., ue[_j + 1]);
                if lo_inf and hi_inf then label = catx(' ', "&f", '<', 'inf');
                else if lo_inf then do;
                    %seg_fmtnum(x=ue[_j + 1], into=_hi)
                    label = catx(' ', "&f", '<', _hi);
                end;
                else if hi_inf then do;
                    %seg_fmtnum(x=ue[_j], into=_lo)
                    label = catx(' ', "&f", '>=', _lo);
                end;
                else do;
                    %seg_fmtnum(x=ue[_j], into=_lo)
                    %seg_fmtnum(x=ue[_j + 1], into=_hi)
                    label = catx(' ', _lo, '<=', "&f", '<', _hi);
                end;
                output _sg_predtmp;
            end;
        run;

        proc append base=_sg_pred data=_sg_predtmp force; run;
    %end;

    proc sql noprint; select k into :knew trimmed from _sg_ed&i; quit;
    %let sg_npred = %eval(&sg_npred + &knew);

    %do side = 1 %to 2;
        %if &side = 1 %then %let tab = _sg_dev; %else %let tab = _sg_mon;
        data &tab;
            if _n_ = 1 then set _sg_ed&i;
            set &tab;
            array e [30] e1-e30;
            _b&i = -1;
            if not missing(&f) and k >= 1 then do;
                _b&i = &base + k;
                do _j = 1 to k - 1;
                    if &f < e[_j] then do; _b&i = &base + _j; leave; end;
                end;
            end;
            drop k e1-e30 _j;
        run;
    %end;

%mend seg_as_pred_num;

/* >>>>>>>>>>>>>>>> seg_as_pred_cat.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_as_pred_cat.sas
   AutoSlicer predicates for ONE character feature: one predicate per distinct
   non-missing DEV value, in order of first appearance, only when the feature
   has between 2 and 20 distinct values (generate_single_feature_predicates).
   Rows are mapped to pred_id through a CNTLIN-built character format; unseen
   or missing values map to -1 (never match).
   ============================================================================ */
%macro seg_as_pred_cat(f=, i=);

    %local n base mode side tab;
    %let base = &sg_npred;

    proc sql noprint;
        create table _sg_cv as
        select &f as value length=200, min(_rid) as first_obs
        from _sg_dev
        where not missing(&f)
        group by &f
        order by first_obs;
    quit;
    %let n = %seg_nobs(_sg_cv);

    %if &n > 1 and &n <= 20 %then %do;
        data _sg_predtmp(keep=pred_id feat_idx feature ptype lower upper lo_inf hi_inf value label)
             _sg_cntlin(keep=fmtname type start label hlo);
            set _sg_cv;
            length feature $64 ptype $1 label $400 fmtname $32 type $1 start $200 hlo $1;
            pred_id  = &base + _n_;
            feat_idx = &i;
            feature  = "&f";
            ptype    = 'C';
            lower = .; upper = .; lo_inf = 0; hi_inf = 0;
            label = catx(' ', "&f", '=', value);
            output _sg_predtmp;
            fmtname = "_sgf&i.x"; type = 'C'; start = value; hlo = ' ';
            label = strip(put(pred_id, best12.));
            output _sg_cntlin;
            if _n_ = &n then do;
                start = ''; hlo = 'O'; label = '-1';
                output _sg_cntlin;
            end;
        run;
        proc format cntlin=_sg_cntlin; run;
        proc append base=_sg_pred data=_sg_predtmp force; run;
        %let sg_npred = %eval(&sg_npred + &n);
        %let mode = F;
    %end;
    %else %let mode = X;

    %do side = 1 %to 2;
        %if &side = 1 %then %let tab = _sg_dev; %else %let tab = _sg_mon;
        data &tab;
            set &tab;
            %if &mode = F %then %do;
                _b&i = input(put(&f, $_sgf&i.x.), best12.);
            %end;
            %else %do;
                _b&i = -1;
            %end;
        run;
    %end;

%mend seg_as_pred_cat;

/* >>>>>>>>>>>>>>>> seg_as_predicates.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_as_predicates.sas
   Builds the AutoSlicer atomic predicate catalogue.
   Output _sg_pred: pred_id (global, 1..n, feature order then bin order),
     feat_idx, feature, ptype (N|C), lower, upper (missing = open end),
     lo_inf, hi_inf, value, label.
   Side effect: adds _b1.._bN to _sg_dev and _sg_mon (N = number of features);
   _b&i = pred_id of the (single) predicate of feature i that the row satisfies.
   Because the predicates of one feature are mutually exclusive, a row matches
   a conjunction iff _b&i equals the conjunction's pred_id for every feature it
   constrains - which turns mask evaluation into an integer join.
   ============================================================================ */
%macro seg_as_predicates(feature_cols=, numeric_bins=4);

    %global sg_npred;
    %local i f vt;
    %let sg_npred = 0;

    data _sg_pred;
        length pred_id 8 feat_idx 8 feature $64 ptype $1 lower 8 upper 8 lo_inf 8 hi_inf 8
               value $200 label $400;
        stop;
    run;

    %do i = 1 %to &sg_nf;
        %let f  = %scan(&feature_cols, &i, %str( ));
        %let vt = %seg_vartype(ds=_sg_dev, var=&f);
        %if &vt = N %then %seg_as_pred_num(f=&f, i=&i, nbins=&numeric_bins);
        %else %seg_as_pred_cat(f=&f, i=&i);
    %end;

    %put NOTE: seg_as_predicates - &sg_npred atomic predicates over &sg_nf features.;

%mend seg_as_predicates;

/* >>>>>>>>>>>>>>>> seg_as_step.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_as_step.sas
   One beam-search level of AutoSlicer: gate -> evaluate -> heuristic.
   Takes a candidate table (cand_id, depth, c1..cN), keeps the survivors of the
   support/event gates, evaluates them fully (seg_evaluate_candidates) and
   appends to the accumulating tables:
       _sg_pool        evaluated candidates (+ Segment_Definition, h, depth, c*)
       _sg_memmon_all  cand_id,_rid  monitoring-row membership (for dedup)
       _sg_rules_all   exact rule rows
       _sg_fpsi_all    per-feature in-segment PSI
   Leaves the new beam (survivors sorted by heuristic desc, then cand_id asc =
   Python's stable sort) in _sg_beam_new and the survivor count in sg_step_n.

   heuristic_score (techniques/autoslicer.py) - beam prioritisation ONLY:
     psi*.30 + mon_weight_pct*.25 + max(0,-d_gini)*.20 + max(0,-d_ks)*.15 + |d_br|*.10
   ============================================================================ */
%macro seg_as_step(cand=, shap_cols=);

    %global sg_step_n;

    %seg_candidate_filter(cand=&cand, out=_sg_surv);
    %let sg_step_n = %seg_nobs(_sg_surv);

    %if &sg_step_n = 0 %then %do;
        data _sg_beam_new; length cand_id 8 h 8; stop; run;
    %end;
    %else %do;
        %seg_evaluate_candidates(cand=_sg_surv, out=_sg_ev, shap_cols=&shap_cols);
        %seg_cand_rules(cand=_sg_surv, out_rules=_sg_rl, out_defs=_sg_df);

        data _sg_evx;
            merge _sg_ev _sg_df _sg_surv(keep=cand_id depth c1-c&sg_nf);
            by cand_id;
            h = psi * 0.30
              + mon_weight_pct * 0.25
              + max(0, -delta_gini) * 0.20
              + max(0, -delta_ks) * 0.15
              + abs(delta_br) * 0.10;
        run;

        proc append base=_sg_pool data=_sg_evx force; run;
        proc append base=_sg_rules_all data=_sg_rl force; run;
        proc append base=_sg_fpsi_all data=_sg_fpsi force; run;

        data _sg_mm(keep=cand_id _rid);
            set _sg_mem_mon;
        run;
        proc append base=_sg_memmon_all data=_sg_mm force; run;

        proc sort data=_sg_evx(keep=cand_id h depth c1-c&sg_nf) out=_sg_beam_new;
            by descending h cand_id;
        run;
    %end;

%mend seg_as_step;

/* >>>>>>>>>>>>>>>> seg_autoslicer.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_autoslicer.sas
   SAS port of techniques/autoslicer.py (AutoSlicerTechnique.run): adaptive
   beam search over conjunctions of single-feature predicates, scored by the
   shared engine.

   Algorithm (same order of operations as Python):
     1  seg_prep, derive gates; seg_as_predicates (quantile bins / categories)
     2  depth 1 = every atomic predicate  -> gate -> evaluate -> heuristic
     3  for depth 2..max_combo_depth:
          retain beam rows with h >= top_h*beam_retain_ratio; if fewer than
          min_beam_width take the first min_beam_width; cap at beam_width;
          expand each retained parent (in beam order) with every predicate of
          every feature it does not yet use (feature order, then bin order);
          skip duplicate conjunctions (first occurrence wins);
          gate -> evaluate -> heuristic; stop if no survivors or if
          (best_h_this_depth - best_h_so_far)/max(|best_so_far|,1e-6) <
          depth_improvement_tolerance (the level just evaluated is KEPT).
     4  seg_score_candidates over the whole pool, significance-first rank,
        Jaccard de-dup (pool 30), keep top_n.

   Outputs (WORK, prefix = &out_prefix):
     _segments   top-N, public column names (Dev_Count ... Root_Cause_Score)
     _rules      exact rule rows for the top-N (use these, not the label text)
     _portfolio  significant top-N re-ranked by Portfolio_Impact_Score
     _feature_psi in-segment per-feature PSI for the top-N
     _pool       every evaluated candidate with internal metric names (parity)
     _log        one row: thresholds, pool size, depth reached

   Defaults equal models/config.SlicerConfig. Not ported: Top_SHAP_Feature /
   Top_SHAP_PSI columns (diagnostic only).
   ============================================================================ */
%macro seg_autoslicer(dev=, mon=, target_col=, score_col=, weight_col=, feature_cols=, shap_cols=,
                      max_combo_depth=6, beam_width=30, min_beam_width=8, beam_retain_ratio=0.5,
                      depth_improvement_tolerance=0.05, numeric_bins=4, top_n=10,
                      min_events_per_slice=30, min_abs_count=, min_support=,
                      significance_alpha=0.05, max_segment_pct=0.35,
                      overlap_jaccard_threshold=0.70, rca_name_filter=Y, out_prefix=seg_as);

    %local nextid d go top_h cutoff nr best_so_far best_this rel stop depth_done nnew;

    proc datasets lib=work nolist nowarn;
        delete _sg_pool _sg_memmon_all _sg_rules_all _sg_fpsi_all;
    quit;

    %seg_prep(dev=&dev, mon=&mon, target_col=&target_col, score_col=&score_col,
              weight_col=&weight_col, feature_cols=&feature_cols, shap_cols=&shap_cols,
              min_abs_count=&min_abs_count, min_support=&min_support,
              min_events_per_slice=&min_events_per_slice, max_segment_pct=&max_segment_pct,
              rca_name_filter=&rca_name_filter);

    %seg_as_predicates(feature_cols=&feature_cols, numeric_bins=&numeric_bins);

    /* ---------------- depth 1: every atomic predicate ---------------- */
    %let nextid = 1;
    data _sg_cand;
        set _sg_pred;
        array c [&sg_nf] c1-c&sg_nf;
        do _i = 1 to &sg_nf; c[_i] = 0; end;
        c[feat_idx] = pred_id;
        cand_id = &nextid + _n_ - 1;
        depth   = 1;
        keep cand_id depth c1-c&sg_nf;
    run;
    %let nextid = %eval(&nextid + %seg_nobs(_sg_cand));

    %seg_as_step(cand=_sg_cand, shap_cols=&shap_cols);
    %let depth_done = 1;
    %let go = %sysevalf(&sg_step_n > 0);

    %if &go %then %do;
        data _sg_beam; set _sg_beam_new; run;
        proc sql noprint; select max(h) format=best32. into :best_so_far trimmed from _sg_beam; quit;
    %end;

    /* ---------------- depth 2..max: expand the beam ---------------- */
    %do d = 2 %to &max_combo_depth;
        %if &go %then %do;

            proc sql noprint; select max(h) format=best32. into :top_h trimmed from _sg_beam; quit;
            data _null_; call symputx('cutoff', put(&top_h * &beam_retain_ratio, best32.), 'L'); run;

            data _sg_ret; set _sg_beam; if h >= &cutoff; run;
            %let nr = %seg_nobs(_sg_ret);
            %if &nr < &min_beam_width %then %do;
                data _sg_ret; set _sg_beam(obs=&min_beam_width); run;
                %let nr = %seg_nobs(_sg_ret);
            %end;
            %if &nr > &beam_width %then %do;
                data _sg_ret; set _sg_ret(obs=&beam_width); run;
            %end;

            data _sg_exp(keep=seq key c1-c&sg_nf);
                set _sg_ret(keep=c1-c&sg_nf);
                array c [&sg_nf] c1-c&sg_nf;
                length key $200;
                do _p = 1 to &sg_npred;
                    set _sg_pred(keep=pred_id feat_idx) point=_p;
                    if c[feat_idx] = 0 then do;
                        c[feat_idx] = pred_id;
                        seq + 1;
                        key = catx('-', of c1-c&sg_nf);
                        output;
                        c[feat_idx] = 0;
                    end;
                end;
            run;
            proc sort data=_sg_exp nodupkey; by key; run;      /* keeps first occurrence */
            proc sort data=_sg_exp; by seq; run;

            data _sg_cand;
                set _sg_exp;
                cand_id = &nextid + _n_ - 1;
                depth   = &d;
                keep cand_id depth c1-c&sg_nf;
            run;
            %let nnew   = %seg_nobs(_sg_cand);
            %let nextid = %eval(&nextid + &nnew);

            %if &nnew = 0 %then %let go = 0;
            %else %do;
                %seg_as_step(cand=_sg_cand, shap_cols=&shap_cols);
                %let depth_done = &d;
                %if &sg_step_n = 0 %then %let go = 0;
                %else %do;
                    proc sql noprint; select max(h) format=best32. into :best_this trimmed from _sg_beam_new; quit;
                    data _null_;
                        rel = (&best_this - &best_so_far) / max(abs(&best_so_far), 1e-6);
                        call symputx('rel', put(rel, best32.), 'L');
                        call symputx('stop', rel < &depth_improvement_tolerance, 'L');
                        call symputx('best_so_far', put(max(&best_so_far, &best_this), best32.), 'L');
                    run;
                    %if &stop %then %let go = 0;
                    %else %do;
                        data _sg_beam; set _sg_beam_new; run;
                    %end;
                %end;
            %end;
        %end;
    %end;

    /* ---------------- final scoring, ranking, de-dup, publish ---------------- */
    %seg_publish(technique=AutoSlicer, out_prefix=&out_prefix, top_n=&top_n, dedup=Y,
                 overlap=&overlap_jaccard_threshold, pool_size=30, alpha=&significance_alpha,
                 dropvars=h depth c1-c&sg_nf);

    /* AutoSlicer-specific log columns */
    data &out_prefix._log;
        set &out_prefix._log;
        n_predicates  = &sg_npred;
        depth_reached = &depth_done;
    run;

%mend seg_autoslicer;

/* >>>>>>>>>>>>>>>> seg_autoslicer_grid.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_autoslicer_grid.sas
   Port of core/parameter_optimization.optimize_parameters for AutoSlicer: run
   every combination of depth_list x beam_list x bins_list, score each run by
   the SUM of Business_Impact_Score over its returned top-N segments, keep the
   first run with the strictly highest sum (Python: `score > best_score`).
   Combination order = itertools.product (bins varies fastest).
   A list left empty falls back to the single-value parameter, so one combination
   means a plain run. Writes the winner to &out_prefix._* plus
   &out_prefix._selected_params (the chosen values and the optimisation score).
   ============================================================================ */
%macro seg_autoslicer_grid(dev=, mon=, target_col=, score_col=, weight_col=, feature_cols=, shap_cols=,
                           depth_list=, beam_list=, bins_list=,
                           max_combo_depth=6, beam_width=30, numeric_bins=4,
                           min_beam_width=8, beam_retain_ratio=0.5, depth_improvement_tolerance=0.05,
                           top_n=10, min_events_per_slice=30, min_abs_count=, min_support=,
                           significance_alpha=0.05, max_segment_pct=0.35,
                           overlap_jaccard_threshold=0.70, rca_name_filter=Y, out_prefix=seg_as);

    %local na nb nc a b c k best bestk sc da db dc s sfx bd bb bn;
    %let bd = &max_combo_depth; %let bb = &beam_width; %let bn = &numeric_bins;

    %if not %length(&depth_list) %then %let depth_list = &max_combo_depth;
    %if not %length(&beam_list)  %then %let beam_list  = &beam_width;
    %if not %length(&bins_list)  %then %let bins_list  = &numeric_bins;
    %let na = %sysfunc(countw(&depth_list, %str( )));
    %let nb = %sysfunc(countw(&beam_list,  %str( )));
    %let nc = %sysfunc(countw(&bins_list,  %str( )));
    %let k = 0;
    %let best = -1E30;
    %let bestk = 0;

    %do a = 1 %to &na;
      %do b = 1 %to &nb;
        %do c = 1 %to &nc;
            %let k  = %eval(&k + 1);
            %let da = %scan(&depth_list, &a, %str( ));
            %let db = %scan(&beam_list,  &b, %str( ));
            %let dc = %scan(&bins_list,  &c, %str( ));

            %seg_autoslicer(dev=&dev, mon=&mon, target_col=&target_col, score_col=&score_col,
                weight_col=&weight_col, feature_cols=&feature_cols, shap_cols=&shap_cols,
                max_combo_depth=&da, beam_width=&db, numeric_bins=&dc,
                min_beam_width=&min_beam_width, beam_retain_ratio=&beam_retain_ratio,
                depth_improvement_tolerance=&depth_improvement_tolerance, top_n=&top_n,
                min_events_per_slice=&min_events_per_slice, min_abs_count=&min_abs_count,
                min_support=&min_support, significance_alpha=&significance_alpha,
                max_segment_pct=&max_segment_pct,
                overlap_jaccard_threshold=&overlap_jaccard_threshold,
                rca_name_filter=&rca_name_filter, out_prefix=sgr&k);

            %let sc = 0;
            %if %seg_nobs(sgr&k._segments) > 0 %then %do;
                proc sql noprint;
                    select sum(Business_Impact_Score) format=best32. into :sc trimmed from sgr&k._segments;
                quit;
            %end;
            %put NOTE: seg_autoslicer_grid - combo &k (depth=&da beam=&db bins=&dc) score=&sc;

            %if %sysevalf(&sc > &best) %then %do;
                %let best  = &sc;
                %let bestk = &k;
                %let bd = &da; %let bb = &db; %let bn = &dc;
            %end;
        %end;
      %end;
    %end;

    %do s = 1 %to 6;
        %let sfx = %scan(segments rules portfolio feature_psi pool log, &s, %str( ));
        data &out_prefix._&sfx; set sgr&bestk._&sfx; run;
    %end;

    data &out_prefix._selected_params;
        max_combo_depth = &bd; beam_width = &bb; numeric_bins = &bn;
        params_evaluated = &k; optimization_score = &best;
    run;

    proc datasets lib=work nolist nowarn; delete sgr: ; quit;

%mend seg_autoslicer_grid;

/* >>>>>>>>>>>>>>>> seg_drift_tree.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_drift_tree.sas
   SAS port of techniques/drift_tree.py (Drift Localization Tree).

   A classification tree is trained to tell DEVELOPMENT rows (0) from
   MONITORING rows (1) on the combined data; each leaf is a candidate segment.
     tree : gini, max_depth, min_samples_leaf (fraction => ceil(frac * N), the
            same integer sklearn derives), no class weights
     rules: canonicalised path conditions, equality parts first
     leaves are evaluated in depth-first order; contradictory paths are dropped
     NO de-duplication (leaves are disjoint), top_n by significance-first rank
   The split search is seg_tree_fit (verified identical to sklearn's partition).
   Output tables (prefix &out_prefix): _segments _rules _portfolio _feature_psi
   _pool _log. Segment extra column: Leaf_ID (sklearn preorder node id).
   Defaults equal models/config.DLTConfig.
   ============================================================================ */
%macro seg_drift_tree(dev=, mon=, target_col=, score_col=, weight_col=, feature_cols=,
                      numeric_cols=, categorical_cols=, shap_cols=,
                      max_depth=3, min_samples_leaf=0.05, top_n=10,
                      min_events_per_slice=30, min_abs_count=, min_support=,
                      significance_alpha=0.05, max_segment_pct=0.35, rca_name_filter=Y,
                      out_prefix=seg_dt);

    %local nn nc p minleaf;

    %seg_prep(dev=&dev, mon=&mon, target_col=&target_col, score_col=&score_col,
              weight_col=&weight_col, feature_cols=&feature_cols, shap_cols=&shap_cols,
              min_abs_count=&min_abs_count, min_support=&min_support,
              min_events_per_slice=&min_events_per_slice, max_segment_pct=&max_segment_pct,
              rca_name_filter=&rca_name_filter);
    %let sg_premem = Y;

    %let nn = %sysfunc(countw(&numeric_cols, %str( )));
    %let nc = %sysfunc(countw(&categorical_cols, %str( )));

    %seg_tree_matrix(numeric_cols=&numeric_cols, categorical_cols=&categorical_cols,
                     out=_tr_x, map=_tr_map);
    %let p = &sg_tr_p;

    /* min_samples_leaf as a fraction => ceil(frac*N) computed WITHOUT SAS's fuzzy CEIL */
    data _null_;
        x = &min_samples_leaf * (&sg_ndev + &sg_nmon);
        call symputx('minleaf', int(x) + (x > int(x)), 'L');
    run;
    %put NOTE: seg_drift_tree - rows=%eval(&sg_ndev + &sg_nmon) min_samples_leaf=&minleaf features=&p;

    %seg_tree_presort(data=_tr_x, p=&p);
    %seg_tree_fit(data=_tr_x, p=&p, tvar=y, kind=GINI, ncls=2, max_depth=&max_depth,
                  min_leaf=&minleaf, out_nodes=_dt_nodes0, out_rows=_dt_rows);

    data _dt_nodes; set _dt_nodes0; gid = 0; run;
    %seg_tree_rules(nodes=_dt_nodes, map=_tr_map, nsrc=%eval(&nn + &nc), mode=SIMPLIFY,
                    root_label=All Customers (Root), out_defs=_dt_defs, out_rules=_dt_rules);

    /* candidates: usable leaves, depth-first order */
    proc sql;
        create table _dt_c0 as
        select n.node_id as leaf, n.preorder as Leaf_ID, d.Segment_Definition
        from _dt_nodes n inner join _dt_defs d on n.node_id = d.leaf
        where n.is_leaf = 1 and d.ok = 1
        order by n.path;
    quit;
    data _dt_cand; set _dt_c0; cand_id = _n_; run;

    proc sql;
        create table _sg_memb_dev as
        select c.cand_id, r._tid as _rid from _dt_rows r, _dt_cand c
        where r.node = c.leaf and r._tid <= &sg_ndev;
        create table _sg_memb_mon as
        select c.cand_id, r._tid - &sg_ndev as _rid from _dt_rows r, _dt_cand c
        where r.node = c.leaf and r._tid > &sg_ndev;
        create table _dt_rl as
        select c.cand_id, r.feature, r.feat_idx, r.ptype, r.lower, r.upper, r.lo_inf, r.hi_inf,
               r.value, r.label
        from _dt_cand c inner join _dt_rules r on c.leaf = r.leaf;
    quit;

    %seg_eval_pool(cand=_dt_cand, defs=_dt_cand, rules=_dt_rl, shap_cols=&shap_cols);
    %seg_publish(technique=Drift Localization Tree, out_prefix=&out_prefix, top_n=&top_n,
                 dedup=N, alpha=&significance_alpha, dropvars=leaf);

    data &out_prefix._log; set &out_prefix._log; tree_leaves = %seg_nobs(_dt_c0); run;
    %let sg_premem = N;

%mend seg_drift_tree;

/* >>>>>>>>>>>>>>>> seg_gradient_boosting.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_gradient_boosting.sas
   SAS port of techniques/gradient_boosting.py.

   Gradient boosting (log-loss) is trained to tell DEV rows (0) from MONITORING
   rows (1); the leaves of EVERY tree are candidate segments.
     init      : log-odds of the monitoring share
     each tree : regression tree (friedman_mse, max_depth, min_samples_leaf as
                 ceil(frac*N)) on the residuals y - sigmoid(F) - seg_tree_fit
                 FMSE; leaf value = sum(residual)/sum(p(1-p)) (Newton step);
                 F += learning_rate * value
     leaves are scanned tree by tree, depth-first; a rule already seen in an
     earlier tree is skipped; then gates -> shared evaluation -> scoring ->
     significance-first rank -> Jaccard de-dup (pool 30) -> top_n
   Because tree t depends only on trees < t, only the first max_trees_scanned
   trees are fitted when that option is set (same result as Python, which fits
   all but scans the first M).
   Feature order for the matrix and root-cause PSI is numeric_cols then
   categorical_cols (as Python builds feature_cols for this technique).
   Extra segment columns: Tree_Idx, Leaf_ID. Defaults = models/config.GBConfig.
   ============================================================================ */
%macro seg_gradient_boosting(dev=, mon=, target_col=, score_col=, weight_col=,
                      numeric_cols=, categorical_cols=, shap_cols=,
                      n_estimators=100, max_depth=3, learning_rate=0.1, min_samples_leaf=0.05,
                      max_trees_scanned=, top_n=10,
                      min_events_per_slice=30, min_abs_count=, min_support=,
                      significance_alpha=0.05, max_segment_pct=0.35,
                      overlap_jaccard_threshold=0.70, rca_name_filter=Y, out_prefix=seg_gb);

    %local nn nc p minleaf ntree t fcols;

    %let fcols = &numeric_cols &categorical_cols;
    %seg_prep(dev=&dev, mon=&mon, target_col=&target_col, score_col=&score_col,
              weight_col=&weight_col, feature_cols=&fcols, shap_cols=&shap_cols,
              min_abs_count=&min_abs_count, min_support=&min_support,
              min_events_per_slice=&min_events_per_slice, max_segment_pct=&max_segment_pct,
              rca_name_filter=&rca_name_filter);
    %let sg_premem = Y;

    %let nn = %sysfunc(countw(&numeric_cols, %str( )));
    %let nc = %sysfunc(countw(&categorical_cols, %str( )));

    %seg_tree_matrix(numeric_cols=&numeric_cols, categorical_cols=&categorical_cols,
                     out=_tr_x, map=_tr_map);
    %let p = &sg_tr_p;

    data _null_;
        x = &min_samples_leaf * (&sg_ndev + &sg_nmon);
        call symputx('minleaf', int(x) + (x > int(x)), 'L');
    run;
    %let ntree = &n_estimators;
    %if %length(&max_trees_scanned) %then %do;
        %if &max_trees_scanned > 0 and &max_trees_scanned < &ntree %then %let ntree = &max_trees_scanned;
    %end;
    %put NOTE: seg_gradient_boosting - trees=&ntree depth=&max_depth min_samples_leaf=&minleaf features=&p;

    %seg_tree_presort(data=_tr_x, p=&p);

    /* ---- boosting loop ---- */
    proc datasets lib=work nolist nowarn; delete _gb_nodes _gb_lr; quit;

    data _gb_work;
        set _tr_x;
        retain _f0;
        if _n_ = 1 then do;
            do until(_e); set _tr_x(keep=y rename=(y=_yy)) end=_e; _s1 + _yy; _cnt + 1; end;
            _pri = _s1 / _cnt;
            _f0 = log(_pri / (1 - _pri));
        end;
        F = _f0;
        drop _f0 _yy _s1 _cnt _pri _e;
    run;

    %do t = 0 %to %eval(&ntree - 1);
        data _gb_work;
            set _gb_work;
            _p = 1 / (1 + exp(-F));
            res = y - _p;
        run;

        %seg_tree_fit(data=_gb_work, p=&p, tvar=res, kind=FMSE, ncls=1, max_depth=&max_depth,
                      min_leaf=&minleaf, out_nodes=_gb_n1, out_rows=_gb_r1);

        /* Newton leaf values and prediction update */
        proc sql;
            create table _gb_val as
            select r.node, sum(w.res) as num, sum(w._p * (1 - w._p)) as den
            from _gb_r1 r inner join _gb_work w on r._tid = w._tid
            group by r.node;
        quit;
        data _gb_work;
            if _n_ = 1 then do;
                declare hash hv(dataset: '_gb_val');
                hv.defineKey('node');
                hv.defineData('num', 'den');
                hv.defineDone();
                call missing(num, den);
            end;
            merge _gb_work _gb_r1(keep=_tid node);
            by _tid;
            if hv.find() = 0 then F = F + &learning_rate * ifn(abs(den) < 1e-150, 0, num / den);
            drop node num den _p res;
        run;

        data _gb_n1; set _gb_n1; gid = &t; run;
        data _gb_r1; set _gb_r1; gid = &t; run;
        proc append base=_gb_nodes data=_gb_n1 force; run;
        proc append base=_gb_lr    data=_gb_r1 force; run;
    %end;

    /* ---- rules, first-seen de-duplication across trees, membership ---- */
    %seg_tree_rules(nodes=_gb_nodes, map=_tr_map, nsrc=%eval(&nn + &nc), mode=SIMPLIFY,
                    root_label=All Customers (Root), out_defs=_gb_defs, out_rules=_gb_rules);

    proc sql;
        create table _gb_c0 as
        select n.gid as Tree_Idx, n.node_id as leaf, n.preorder as Leaf_ID, d.Segment_Definition
        from _gb_nodes n inner join _gb_defs d on n.gid = d.gid and n.node_id = d.leaf
        where n.is_leaf = 1 and d.ok = 1
        order by n.gid, n.path;
    quit;

    data _gb_cand;
        if _n_ = 1 then do;
            declare hash seen();
            seen.defineKey('Segment_Definition');
            seen.defineDone();
        end;
        set _gb_c0;
        if seen.check() = 0 then delete;
        rc = seen.add();
        cand_id + 1;
        drop rc;
    run;

    proc sql;
        create table _sg_memb_dev as
        select c.cand_id, r._tid as _rid from _gb_lr r, _gb_cand c
        where r.gid = c.Tree_Idx and r.node = c.leaf and r._tid <= &sg_ndev;
        create table _sg_memb_mon as
        select c.cand_id, r._tid - &sg_ndev as _rid from _gb_lr r, _gb_cand c
        where r.gid = c.Tree_Idx and r.node = c.leaf and r._tid > &sg_ndev;
        create table _gb_rl as
        select c.cand_id, r.feature, r.feat_idx, r.ptype, r.lower, r.upper, r.lo_inf, r.hi_inf,
               r.value, r.label
        from _gb_cand c inner join _gb_rules r on c.Tree_Idx = r.gid and c.leaf = r.leaf;
    quit;

    %seg_eval_pool(cand=_gb_cand, defs=_gb_cand, rules=_gb_rl, shap_cols=&shap_cols);
    %seg_publish(technique=Gradient Boosting, out_prefix=&out_prefix, top_n=&top_n, dedup=Y,
                 overlap=&overlap_jaccard_threshold, pool_size=30, alpha=&significance_alpha,
                 dropvars=leaf);

    data &out_prefix._log; set &out_prefix._log; trees_fitted = &ntree; run;
    %let sg_premem = N;

%mend seg_gradient_boosting;

/* >>>>>>>>>>>>>>>> seg_km_encode.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_km_encode.sas
   Port of techniques/kmeans.fit_encoder + transform. Fit on DEVELOPMENT only,
   applied unchanged to monitoring:
     numeric     : missing -> dev median, then (x - mean) / std
                   (StandardScaler: population std, ddof = 0; std 0 -> 1)
     categorical : missing -> '__MISSING__'; one 0/1 column per distinct DEV
                   value in sorted order (unseen monitoring values -> all zeros)
   Column order: numeric cols, then each categorical col's values.
   out: _km_xd (dev) and _km_xm (mon): _rid, d1..dD ;  _km_map: fidx kind
        src_idx srcname val med mean std (scaler stats, also published)
   Global: sg_km_d = D
   Outlier treatment (OutlierConfig) is off by default in Python and is not ported.
   ============================================================================ */
%macro seg_km_encode(numeric_cols=, categorical_cols=);

    %global sg_km_d;
    %local nn nc j c v d side tab out;

    %let nn = %sysfunc(countw(&numeric_cols, %str( )));
    %let nc = %sysfunc(countw(&categorical_cols, %str( )));

    %if &nn > 0 %then %do;
        proc means data=_sg_dev noprint;
            var &numeric_cols;
            output out=_km_med(drop=_type_ _freq_) median=;
        run;
        data _null_;
            set _km_med;
            %do j = 1 %to &nn;
                call symputx("km_med&j", put(%scan(&numeric_cols, &j, %str( )), best32.), 'L');
            %end;
        run;
        data _km_imp;
            set _sg_dev(keep=&numeric_cols);
            %do j = 1 %to &nn;
                %let v = %scan(&numeric_cols, &j, %str( ));
                &v = coalesce(&v, &&km_med&j);
            %end;
        run;
        proc means data=_km_imp noprint vardef=n;
            var &numeric_cols;
            output out=_km_mean(drop=_type_ _freq_) mean=;
            output out=_km_std(drop=_type_ _freq_) std=;
        run;
        data _null_;
            merge _km_mean _km_std(rename=(%do j = 1 %to &nn; %scan(&numeric_cols, &j, %str( ))=s&j %end;));
            %do j = 1 %to &nn;
                call symputx("km_mean&j", put(%scan(&numeric_cols, &j, %str( )), best32.), 'L');
                call symputx("km_std&j", put(ifn(s&j = 0 or missing(s&j), 1, s&j), best32.), 'L');
            %end;
        run;
    %end;

    data _km_map;
        length fidx 8 kind $1 src_idx 8 srcname $64 val $200 med 8 mean 8 std 8;
        stop;
    run;
    %do j = 1 %to &nn;
        %let v = %scan(&numeric_cols, &j, %str( ));
        data _km_m1;
            length kind $1 srcname $64 val $200;
            kind = 'N'; src_idx = &j; srcname = "&v"; val = '';
            med = &&km_med&j; mean = &&km_mean&j; std = &&km_std&j;
        run;
        proc append base=_km_map data=_km_m1 force; run;
    %end;
    %do c = 1 %to &nc;
        %let v = %scan(&categorical_cols, &c, %str( ));
        proc sql;
            create table _km_m2 as
            select distinct 'C' as kind length=1, %eval(&nn + &c) as src_idx,
                   "&v" as srcname length=64, coalescec(strip(&v), '__MISSING__') as val length=200
            from _sg_dev order by val;
        quit;
        proc append base=_km_map data=_km_m2 force; run;
    %end;
    data _km_map; set _km_map; fidx = _n_; run;
    proc sql noprint; select count(*) into :d trimmed from _km_map; quit;
    %let sg_km_d = &d;

    %do side = 1 %to 2;
        %if &side = 1 %then %do; %let tab = _sg_dev; %let out = _km_xd; %end;
        %else %do; %let tab = _sg_mon; %let out = _km_xm; %end;
        data &out(keep=_rid d1-d&d);
            array dd [&d] d1-d&d;
            array mval  [&d] $200 _temporary_;
            array msrc  [&d]      _temporary_;
            array mkind [&d] $1   _temporary_;
            if _n_ = 1 then do;
                do until(_e);
                    set _km_map(keep=fidx kind src_idx val) end=_e;
                    mval[fidx] = val; msrc[fidx] = src_idx; mkind[fidx] = kind;
                end;
            end;
            set &tab;
            %do j = 1 %to &nn;
                %let v = %scan(&numeric_cols, &j, %str( ));
                dd[&j] = (coalesce(&v, &&km_med&j) - &&km_mean&j) / &&km_std&j;
            %end;
            %do c = 1 %to &nc;
                %let v = %scan(&categorical_cols, &c, %str( ));
                _v = coalescec(strip(&v), '__MISSING__');
                do _k = %eval(&nn + 1) to &d;
                    if mkind[_k] = 'C' and msrc[_k] = %eval(&nn + &c) then dd[_k] = (mval[_k] = _v);
                end;
            %end;
        run;
    %end;

%mend seg_km_encode;

/* >>>>>>>>>>>>>>>> seg_km_fit.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_km_fit.sas
   K-Means in Base SAS, following sklearn.cluster.KMeans:
     * n_init independent runs, keep the lowest inertia
     * k-means++ seeding (D^2-weighted; the greedy multi-trial variant of
       sklearn is simplified to one trial)
     * Lloyd iterations until the summed squared centre shift <=
       tol * mean(column variance)   (sklearn's tolerance rule), max maxiter
     * empty cluster -> its centre moves to the point farthest from its centre
     * final labels = nearest final centre (lowest index on ties)
   WHAT IS NOT REPRODUCIBLE: sklearn's random stream. Different seeds/streams
   give different local optima, so cluster identities (and everything derived,
   incl. the chosen k) are statistically equivalent to Python, not identical.
   PROC FASTCLUS/KCLUS were deliberately not used: their seeding and
   convergence rules differ from sklearn's and are harder to reason about.

   Size limit: the matrix is held in memory (n*d*8 bytes) and the cost is
   O(n*k*d*iters*n_init). Python switches to MiniBatchKMeans above 200,000 rows;
   above that use CAS (PROC KCLUS) - this macro stops with an ERROR above 5e7 cells.
   data : _rid, d1..dD            out_lab: _rid, lab (0..k-1)   out_cen: cid, c1..cD
   ============================================================================ */
%macro seg_km_fit(data=, n=, d=, k=, seed=, n_init=10, maxiter=300, tol=0.0001,
                  out_lab=, out_cen=);

    %if %sysevalf(&n * &d > 5e7) %then %do;
        %put ERROR: seg_km_fit - &n x &d matrix too large for the in-memory K-Means - use CAS PROC KCLUS.;
        %return;
    %end;

    data &out_lab(keep=_rid lab) &out_cen(keep=cid c1-c&d);
        array X    [&n, &d]  _temporary_;
        array rid  [&n]      _temporary_;
        array cen  [&k, &d]  _temporary_;
        array nsum [&k, &d]  _temporary_;
        array bcen [&k, &d]  _temporary_;
        array cnt  [&k]      _temporary_;
        array lb   [&n]      _temporary_;
        array blb  [&n]      _temporary_;
        array dmin [&n]      _temporary_;
        array dv   [&d]      d1-d&d;
        array oc   [&d]      c1-c&d;

        i = 0;
        do until(_e);
            set &data end=_e;
            i + 1;
            rid[i] = _rid;
            do j = 1 to &d; X[i, j] = dv[j]; end;
        end;

        /* tolerance = tol * mean over columns of the population variance */
        tv = 0;
        do j = 1 to &d;
            m = 0; do i = 1 to &n; m + X[i, j]; end; m = m / &n;
            v = 0; do i = 1 to &n; v + (X[i, j] - m) ** 2; end; tv + v / &n;
        end;
        tolabs = &tol * tv / &d;

        call streaminit(&seed);
        bestin = 1e300;

        do r = 1 to &n_init;
            /* ---- k-means++ ---- */
            c1i = max(1, ceil(rand('uniform') * &n));
            do j = 1 to &d; cen[1, j] = X[c1i, j]; end;
            do i = 1 to &n;
                dd = 0; do j = 1 to &d; dd + (X[i, j] - cen[1, j]) ** 2; end;
                dmin[i] = dd;
            end;
            do c = 2 to &k;
                tot = 0; do i = 1 to &n; tot + dmin[i]; end;
                u = rand('uniform') * tot; cum = 0; pick = &n;
                do i = 1 to &n;
                    cum + dmin[i];
                    if cum >= u then do; pick = i; leave; end;
                end;
                do j = 1 to &d; cen[c, j] = X[pick, j]; end;
                do i = 1 to &n;
                    dd = 0; do j = 1 to &d; dd + (X[i, j] - cen[c, j]) ** 2; end;
                    if dd < dmin[i] then dmin[i] = dd;
                end;
            end;

            /* ---- Lloyd ---- */
            do it = 1 to &maxiter;
                do c = 1 to &k; cnt[c] = 0; do j = 1 to &d; nsum[c, j] = 0; end; end;
                do i = 1 to &n;
                    bd = 1e300; bc = 1;
                    do c = 1 to &k;
                        dd = 0; do j = 1 to &d; dd + (X[i, j] - cen[c, j]) ** 2; end;
                        if dd < bd then do; bd = dd; bc = c; end;
                    end;
                    lb[i] = bc; dmin[i] = bd; cnt[bc] + 1;
                    do j = 1 to &d; nsum[bc, j] + X[i, j]; end;
                end;
                shift = 0;
                do c = 1 to &k;
                    if cnt[c] = 0 then do;                   /* empty cluster: farthest point */
                        far = 1; fd = -1;
                        do i = 1 to &n; if dmin[i] > fd then do; fd = dmin[i]; far = i; end; end;
                        do j = 1 to &d; nsum[c, j] = X[far, j]; end;
                        cnt[c] = 1; dmin[far] = 0;
                    end;
                    do j = 1 to &d;
                        nw = nsum[c, j] / cnt[c];
                        shift + (nw - cen[c, j]) ** 2;
                        cen[c, j] = nw;
                    end;
                end;
                if shift <= tolabs then leave;
            end;

            /* ---- final labels + inertia ---- */
            inertia = 0;
            do i = 1 to &n;
                bd = 1e300; bc = 1;
                do c = 1 to &k;
                    dd = 0; do j = 1 to &d; dd + (X[i, j] - cen[c, j]) ** 2; end;
                    if dd < bd then do; bd = dd; bc = c; end;
                end;
                lb[i] = bc; inertia + bd;
            end;
            if inertia < bestin then do;
                bestin = inertia;
                do i = 1 to &n; blb[i] = lb[i]; end;
                do c = 1 to &k; do j = 1 to &d; bcen[c, j] = cen[c, j]; end; end;
            end;
        end;

        do i = 1 to &n; _rid = rid[i]; lab = blb[i] - 1; output &out_lab; end;
        do c = 1 to &k;
            cid = c - 1;
            do j = 1 to &d; oc[j] = bcen[c, j]; end;
            output &out_cen;
        end;
        stop;
    run;

%mend seg_km_fit;

/* >>>>>>>>>>>>>>>> seg_km_predict.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_km_predict.sas
   Nearest-centre assignment (KMeans.predict): lowest cluster index on ties.
   data: _rid, d1..dD     cen: cid (0..k-1), c1..cD     out: _rid, lab
   ============================================================================ */
%macro seg_km_predict(data=, cen=, d=, k=, out=);

    data &out(keep=_rid lab);
        array cc [&k, &d] _temporary_;
        array dv [&d] d1-d&d;
        array oc [&d] c1-c&d;
        if _n_ = 1 then do;
            do until(_e);
                set &cen end=_e;
                do j = 1 to &d; cc[cid + 1, j] = oc[j]; end;
            end;
        end;
        set &data;
        bd = 1e300; bc = 0;
        do c = 1 to &k;
            dd = 0; do j = 1 to &d; dd + (dv[j] - cc[c, j]) ** 2; end;
            if dd < bd then do; bd = dd; bc = c - 1; end;
        end;
        lab = bc;
    run;

%mend seg_km_predict;

/* >>>>>>>>>>>>>>>> seg_km_metrics.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_km_metrics.sas
   Internal validity metrics of a clustering (sklearn.metrics definitions,
   centroids recomputed as the mean of each label's rows):
     silhouette_score  (Euclidean; all points when n <= 10000, otherwise a
                        random 10000-point sample as sample_size=10000 does)
     calinski_harabasz_score
     davies_bouldin_score
   Verified against sklearn on a 1500x6, k=5 case to ~1e-17.
   x: _rid, d1..dD (sorted by _rid)   lab: _rid, lab (0..k-1)
   out: one row (silhouette, calinski_harabasz, davies_bouldin)
   ============================================================================ */
%macro seg_km_metrics(x=, lab=, n=, d=, k=, seed=42, out=);

    data _km_mx; merge &x &lab; by _rid; run;

    data &out(keep=silhouette calinski_harabasz davies_bouldin);
        array X  [&n, &d] _temporary_;
        array lb [&n]     _temporary_;
        array cn [&k]     _temporary_;
        array cm [&k, &d] _temporary_;
        array gm [&d]     _temporary_;
        array sc [&k]     _temporary_;
        array dm [&k, &k] _temporary_;
        array sums [&k]   _temporary_;
        array scnt [&k]   _temporary_;
        array idx [&n]    _temporary_;
        array dv [&d] d1-d&d;

        i = 0;
        do until(_e);
            set _km_mx end=_e;
            i + 1; lb[i] = lab + 1;
            do j = 1 to &d; X[i, j] = dv[j]; end;
        end;

        do c = 1 to &k; cn[c] = 0; do j = 1 to &d; cm[c, j] = 0; end; end;
        do j = 1 to &d; gm[j] = 0; end;
        do i = 1 to &n;
            cn[lb[i]] + 1;
            do j = 1 to &d; cm[lb[i], j] + X[i, j]; gm[j] + X[i, j]; end;
        end;
        do j = 1 to &d; gm[j] = gm[j] / &n; end;
        do c = 1 to &k; if cn[c] > 0 then do j = 1 to &d; cm[c, j] = cm[c, j] / cn[c]; end; end;

        /* Calinski-Harabasz */
        bss = 0; wss = 0;
        do c = 1 to &k;
            dd = 0; do j = 1 to &d; dd + (cm[c, j] - gm[j]) ** 2; end;
            bss + cn[c] * dd;
        end;
        do i = 1 to &n;
            do j = 1 to &d; wss + (X[i, j] - cm[lb[i], j]) ** 2; end;
        end;
        if wss = 0 then calinski_harabasz = 1;
        else calinski_harabasz = (bss / (&k - 1)) / (wss / (&n - &k));

        /* Davies-Bouldin */
        do c = 1 to &k; sc[c] = 0; end;
        do i = 1 to &n;
            dd = 0; do j = 1 to &d; dd + (X[i, j] - cm[lb[i], j]) ** 2; end;
            sc[lb[i]] + sqrt(dd);
        end;
        do c = 1 to &k; if cn[c] > 0 then sc[c] = sc[c] / cn[c]; end;
        do a = 1 to &k; do b = 1 to &k;
            dd = 0; do j = 1 to &d; dd + (cm[a, j] - cm[b, j]) ** 2; end;
            dm[a, b] = sqrt(dd);
        end; end;
        dbsum = 0;
        do a = 1 to &k;
            mx = 0;
            do b = 1 to &k;
                if b ne a and dm[a, b] > 0 then mx = max(mx, (sc[a] + sc[b]) / dm[a, b]);
            end;
            dbsum + mx;
        end;
        davies_bouldin = dbsum / &k;

        /* silhouette (sample when n > 10000) */
        m = min(&n, 10000);
        do i = 1 to &n; idx[i] = i; end;
        if &n > 10000 then do;
            call streaminit(&seed);
            do s = 1 to m;
                t = s + floor(rand('uniform') * (&n - s + 1));
                tmp = idx[s]; idx[s] = idx[t]; idx[t] = tmp;
            end;
        end;
        do c = 1 to &k; scnt[c] = 0; end;
        do s = 1 to m; scnt[lb[idx[s]]] + 1; end;
        nclu = 0; do c = 1 to &k; if scnt[c] > 0 then nclu + 1; end;
        if nclu < 2 then silhouette = .;
        else do;
            tot = 0;
            do s = 1 to m;
                i = idx[s]; own = lb[i];
                do c = 1 to &k; sums[c] = 0; end;
                do t = 1 to m;
                    j2 = idx[t];
                    dd = 0; do j = 1 to &d; dd + (X[i, j] - X[j2, j]) ** 2; end;
                    sums[lb[j2]] + sqrt(dd);
                end;
                if scnt[own] > 1 then do;
                    av = sums[own] / (scnt[own] - 1);
                    bv = 1e300;
                    do c = 1 to &k;
                        if c ne own and scnt[c] > 0 then bv = min(bv, sums[c] / scnt[c]);
                    end;
                    mxab = max(av, bv);
                    if mxab > 0 then tot + (bv - av) / mxab;
                end;
            end;
            silhouette = tot / m;
        end;
        output;
        stop;
    run;

%mend seg_km_metrics;

/* >>>>>>>>>>>>>>>> seg_km_select_k.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_km_select_k.sas
   Port of techniques/kmeans.select_optimal_k. For each k in [k_min, k_max]
   (k >= 2, k < n):
     * fit with the configured seed; reject k if its smallest cluster is below
       min_cluster_pct of the dev rows
     * stability = adjusted Rand index vs a second fit with seed 777
     * silhouette, Calinski-Harabasz, Davies-Bouldin on the first fit
     * max relative cluster drift = max_c |mon_share_c - dev_share_c| /
       max(dev_share_c, 1e-6), monitoring assigned to the dev centres
   Scores (over the accepted k): min-max normalise each metric (constant column
   -> 1.0), internal = mean(sil_n, ch_n, 1 - db_n);
     drift_aware : composite = (1-w)*(0.5*internal + 0.5*stab_n) + w*drift_n
     otherwise   : composite =  0.5*internal + 0.5*stab_n
   best k = first maximum. NOTE (design property carried over from Python): in
   the drift-aware mode monitoring data influences the choice of k, and the
   relative-drift term tends to grow with k.
   Needs _km_xd / _km_xm. Leaves for every k: _km_la<k> _km_ca<k> (fit A).
   Outputs: _km_diag (diagnostics) and global sg_km_bestk.
   ============================================================================ */
%macro seg_km_select_k(k_min=, k_max=, min_cluster_pct=, seed=, drift_aware=Y, drift_weight=0.4,
                       n_init=10, d=, n=, nmon=);

    %global sg_km_bestk;
    %local k ngrp minfrac ari sil ch db drift s_lo s_hi c_lo c_hi d_lo d_hi t_lo t_hi m_lo m_hi sij sa sb;

    data _km_diag;
        length k 8 silhouette 8 calinski_harabasz 8 davies_bouldin 8 stability_ari 8
               max_cluster_drift 8 min_cluster_pct 8 composite 8 rejected_reason $100;
        stop;
    run;

    %do k = &k_min %to &k_max;
      %if &k >= 2 and &k < &n %then %do;

        %seg_km_fit(data=_km_xd, n=&n, d=&d, k=&k, seed=&seed, n_init=&n_init,
                    out_lab=_km_la&k, out_cen=_km_ca&k);

        proc sql noprint;
            create table _km_sz as select lab, count(*) as cnt from _km_la&k group by lab;
            select count(*), min(cnt) / &n format=best32. into :ngrp trimmed, :minfrac trimmed from _km_sz;
        quit;
        %if &ngrp < &k %then %let minfrac = 0;

        %if %sysevalf(&minfrac < &min_cluster_pct) %then %do;
            data _km_row;
                k = &k; min_cluster_pct = &minfrac; composite = .;
                length rejected_reason $100;
                rejected_reason = cats('smallest cluster ', put(100 * &minfrac, 8.1), '% < floor ',
                                       put(100 * &min_cluster_pct, 8.0), '%');
            run;
            proc append base=_km_diag data=_km_row force; run;
        %end;
        %else %do;
            /* stability: second fit, fixed seed 777 */
            %seg_km_fit(data=_km_xd, n=&n, d=&d, k=&k, seed=777, n_init=&n_init,
                        out_lab=_km_lb&k, out_cen=_km_cb&k);
            proc sql;
                create table _km_ct as
                select a.lab as la, b.lab as lb, count(*) as nij
                from _km_la&k a inner join _km_lb&k b on a._rid = b._rid group by a.lab, b.lab;
                create table _km_ra as select la, sum(nij) as ni from _km_ct group by la;
                create table _km_rb as select lb, sum(nij) as nj from _km_ct group by lb;
            quit;
            data _null_;
                set _km_ct end=_e; sij + nij * (nij - 1) / 2;
                if _e then call symputx('sij', sij, 'L');
            run;
            data _null_;
                set _km_ra end=_e; sa + ni * (ni - 1) / 2;
                if _e then call symputx('sa', sa, 'L');
            run;
            data _null_;
                set _km_rb end=_e; sb + nj * (nj - 1) / 2;
                if _e then call symputx('sb', sb, 'L');
            run;
            data _null_;
                ex  = &sa * &sb / (&n * (&n - 1) / 2);
                den = 0.5 * (&sa + &sb) - ex;
                ari = ifn(den = 0, 1, (&sij - ex) / den);
                call symputx('ari', put(ari, best32.), 'L');
            run;

            %seg_km_metrics(x=_km_xd, lab=_km_la&k, n=&n, d=&d, k=&k, seed=&seed, out=_km_mt);

            %let drift = .;
            %if %upcase(&drift_aware) = Y %then %do;
                %seg_km_predict(data=_km_xm, cen=_km_ca&k, d=&d, k=&k, out=_km_pm);
                proc sql noprint;
                    create table _km_dp as select lab, count(*) / &n as dp from _km_la&k group by lab;
                    create table _km_mp as select lab, count(*) / &nmon as mp from _km_pm group by lab;
                    select max(abs(coalesce(m.mp, 0) - d.dp) / (case when d.dp > 1e-6 then d.dp else 1e-6 end)) format=best32. into :drift trimmed
                    from _km_dp d left join _km_mp m on d.lab = m.lab;
                quit;
            %end;

            data _km_row;
                set _km_mt;
                length rejected_reason $100;
                k = &k; stability_ari = &ari; max_cluster_drift = &drift;
                min_cluster_pct = &minfrac; composite = .; rejected_reason = '';
            run;
            proc append base=_km_diag data=_km_row force; run;
        %end;

      %end;
    %end;

    /* ---- composite score over the accepted ks ---- */
    proc sql noprint;
        select min(silhouette) format=best32., max(silhouette) format=best32., min(calinski_harabasz) format=best32., max(calinski_harabasz) format=best32.,
               min(davies_bouldin) format=best32., max(davies_bouldin) format=best32., min(stability_ari) format=best32., max(stability_ari) format=best32.,
               min(max_cluster_drift) format=best32., max(max_cluster_drift) format=best32.
          into :s_lo trimmed, :s_hi trimmed, :c_lo trimmed, :c_hi trimmed, :d_lo trimmed, :d_hi trimmed,
               :t_lo trimmed, :t_hi trimmed, :m_lo trimmed, :m_hi trimmed
          from _km_diag where missing(rejected_reason);
    quit;

    data _km_diag;
        set _km_diag;
        if missing(rejected_reason) then do;
            if &s_hi > &s_lo then sil_n = (silhouette - &s_lo) / (&s_hi - &s_lo); else sil_n = 1;
            if &c_hi > &c_lo then ch_n  = (calinski_harabasz - &c_lo) / (&c_hi - &c_lo); else ch_n = 1;
            if &d_hi > &d_lo then db_n  = 1 - (davies_bouldin - &d_lo) / (&d_hi - &d_lo); else db_n = 0;
            if &t_hi > &t_lo then stb_n = (stability_ari - &t_lo) / (&t_hi - &t_lo); else stb_n = 1;
            internal = mean(sil_n, ch_n, db_n);
            %if %upcase(&drift_aware) = Y %then %do;
                if &m_hi > &m_lo then drf_n = (max_cluster_drift - &m_lo) / (&m_hi - &m_lo); else drf_n = 1;
                composite = (1 - &drift_weight) * (0.5 * internal + 0.5 * stb_n) + &drift_weight * drf_n;
            %end;
            %else %do;
                composite = 0.5 * internal + 0.5 * stb_n;
            %end;
        end;
        drop sil_n ch_n db_n stb_n internal drf_n;
    run;

    proc sql outobs=1 noprint;
        select k into :sg_km_bestk trimmed from _km_diag where missing(rejected_reason)
        order by composite desc, k;
    quit;
    %if not %length(&sg_km_bestk) %then %put ERROR: seg_km_select_k - no k satisfied the minimum cluster-size floor.;
    %else %put NOTE: seg_km_select_k - selected k=&sg_km_bestk;

%mend seg_km_select_k;

/* >>>>>>>>>>>>>>>> seg_kmeans.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_kmeans.sas
   SAS port of techniques/kmeans.py (K-Means Clustering).

   1  encode (dev-fit scaler / one-hot)            seg_km_encode
   2  choose k (validity + stability + drift)       seg_km_select_k
   3  dev clusters = fit with the configured seed; monitoring rows -> nearest
      DEV centre
   4  explain: a shallow multiclass tree (gini, max_tree_depth, min_samples_leaf =
      max(20, int(1% of dev))) is trained on the raw dev features to predict the
      cluster; each cluster's rule is the path to the leaf holding most of its
      rows (PLAIN canonical order). Rule_Precision / Rule_Recall report how well
      that rule describes the cluster. IMPORTANT: real membership is the nearest
      centre - the rule is only a description (as in Python). The centres and the
      encoding statistics are published (&out_prefix._centroids / _encoding) so
      consumers can apply the segmentation exactly.
   5  each cluster is a candidate: gates -> shared evaluation -> scoring ->
      significance-first rank (NO de-dup) -> top_n
   NOT reproducible bit-for-bit: k-means randomness (see seg_km_fit) - compare
   with the Python run statistically (similar k, similar top segments).
   Defaults equal models/config.KMeansConfig. Extra segment columns: Cluster_ID,
   Rule_Precision, Rule_Recall.
   ============================================================================ */
%macro seg_kmeans(dev=, mon=, target_col=, score_col=, weight_col=, feature_cols=,
                  numeric_cols=, categorical_cols=, shap_cols=,
                  k_min=2, k_max=12, min_cluster_pct=0.03, seed=42, max_tree_depth=4,
                  drift_aware=Y, drift_weight=0.4, n_init=10, top_n=10,
                  min_events_per_slice=30, min_abs_count=, min_support=,
                  significance_alpha=0.05, max_segment_pct=0.35, rca_name_filter=Y,
                  out_prefix=seg_km);

    %local nn nc d k n nmon minleaf p;

    %seg_prep(dev=&dev, mon=&mon, target_col=&target_col, score_col=&score_col,
              weight_col=&weight_col, feature_cols=&feature_cols, shap_cols=&shap_cols,
              min_abs_count=&min_abs_count, min_support=&min_support,
              min_events_per_slice=&min_events_per_slice, max_segment_pct=&max_segment_pct,
              rca_name_filter=&rca_name_filter);
    %let sg_premem = Y;
    %let n    = &sg_ndev;
    %let nmon = &sg_nmon;
    %let nn   = %sysfunc(countw(&numeric_cols, %str( )));
    %let nc   = %sysfunc(countw(&categorical_cols, %str( )));

    %seg_km_encode(numeric_cols=&numeric_cols, categorical_cols=&categorical_cols);
    %let d = &sg_km_d;

    %seg_km_select_k(k_min=&k_min, k_max=&k_max, min_cluster_pct=&min_cluster_pct, seed=&seed,
                     drift_aware=&drift_aware, drift_weight=&drift_weight, n_init=&n_init,
                     d=&d, n=&n, nmon=&nmon);
    %if not %length(&sg_km_bestk) %then %do;
        %let sg_premem = N;
        %return;
    %end;
    %let k = &sg_km_bestk;

    /* ---- final assignment ---- */
    %seg_km_predict(data=_km_xm, cen=_km_ca&k, d=&d, k=&k, out=_km_lm);
    data _km_ld; set _km_la&k; run;

    /* ---- rule distillation on raw dev features ---- */
    %seg_tree_matrix(numeric_cols=&numeric_cols, categorical_cols=&categorical_cols,
                     out=_tr_x, map=_tr_map, scope=DEV, miss=__MISSING__);
    %let p = &sg_tr_p;
    data _km_tx;
        merge _tr_x _km_ld(rename=(_rid=_tid));
        by _tid;
    run;
    data _null_;
        m = int(0.01 * &n);
        call symputx('minleaf', max(20, m), 'L');
    run;
    %seg_tree_presort(data=_km_tx, p=&p);
    %seg_tree_fit(data=_km_tx, p=&p, tvar=lab, kind=GINI, ncls=&k, max_depth=&max_tree_depth,
                  min_leaf=&minleaf, out_nodes=_km_n0, out_rows=_km_rows);
    data _km_nodes; set _km_n0; gid = 0; run;
    %seg_tree_rules(nodes=_km_nodes, map=_tr_map, nsrc=%eval(&nn + &nc), mode=PLAIN,
                    root_label=, out_defs=_km_defs, out_rules=_km_rules);

    /* leaf holding most of each cluster (ties: depth-first first) */
    proc sql;
        create table _km_lc as
        select l.lab, r.node, count(*) as cnt
        from _km_rows r inner join _km_ld l on r._tid = l._rid
        group by l.lab, r.node;
        create table _km_ln as select node, count(*) as lsize from _km_rows group by node;
        create table _km_cs as select lab, count(*) as csize from _km_ld group by lab;
        create table _km_bl0 as
        select c.lab, c.node as leaf, c.cnt, n.lsize, s.csize, p.path
        from _km_lc c, _km_ln n, _km_cs s, _km_nodes p
        where c.node = n.node and c.lab = s.lab and c.node = p.node_id
        order by c.lab, c.cnt desc, p.path;
    quit;
    data _km_bl;
        set _km_bl0;
        by lab;
        if first.lab;
        Rule_Precision = cnt / lsize;
        Rule_Recall    = cnt / csize;
    run;

    proc sql;
        create table _km_cand as
        select b.lab + 1 as cand_id, b.lab as Cluster_ID,
               ('Cluster_' || strip(put(b.lab, best12.)) || ': ' ||
                    case when d.ok = 1 and d.Segment_Definition ne '' then strip(d.Segment_Definition)
                         else ('Cluster_' || strip(put(b.lab, best12.)) || ' (centroid)') end)
                    as Segment_Definition length=1000,
               b.Rule_Precision, b.Rule_Recall, b.leaf
        from _km_bl b left join _km_defs d on b.leaf = d.leaf
        order by b.lab;

        create table _km_rl as
        select c.cand_id, r.feature, r.feat_idx, r.ptype, r.lower, r.upper, r.lo_inf, r.hi_inf,
               r.value, r.label
        from _km_cand c inner join _km_rules r on c.leaf = r.leaf;

        create table _sg_memb_dev as select lab + 1 as cand_id, _rid from _km_ld;
        create table _sg_memb_mon as select lab + 1 as cand_id, _rid from _km_lm;
    quit;

    %seg_eval_pool(cand=_km_cand, defs=_km_cand, rules=_km_rl, shap_cols=&shap_cols);
    %seg_publish(technique=K-Means Clustering, out_prefix=&out_prefix, top_n=&top_n, dedup=N,
                 alpha=&significance_alpha, dropvars=leaf);

    /* ---- extras: diagnostics + what a consumer needs to apply the clusters ---- */
    data &out_prefix._k_diagnostics; set _km_diag; run;
    data &out_prefix._centroids;     set _km_ca&k; run;
    data &out_prefix._encoding;      set _km_map; run;
    data &out_prefix._log; set &out_prefix._log; optimal_k = &k; run;
    %let sg_premem = N;

%mend seg_kmeans;

/* >>>>>>>>>>>>>>>> seg_fb_strength.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_fb_strength.sas
   Feature Binning step 1 (techniques/feature_binning.py: get_candidate_features,
   feature_strength, select_top_features): keep legitimate features and rank them
   by how strongly they separate the target on DEV data.
     numeric     : |AUC(target, value over non-missing rows) - 0.5|
     categorical : |AUC(target, bad-rate-encoded value) - 0.5|, missing = '__MISSING__'
   (AUC with mid-rank ties = sklearn.roc_auc_score; <2 usable rows or a single
   target class => strength 0). The top max_features by strength are returned in
   strength order (ties: original feature order).
   Name guard (as get_candidate_features): drops shap_*, *_id, id_*, and names
   containing customer_id / account_id / application_id.
   Global result: sg_fb_sel (space-separated feature list)
   ============================================================================ */
%macro seg_fb_strength(feature_cols=, max_features=30);

    %global sg_fb_sel;
    %local nf i f vt ok;
    %let nf = %sysfunc(countw(&feature_cols, %str( )));

    data _fb_str;
        length feat_idx 8 feature $64 strength 8;
        stop;
    run;

    %do i = 1 %to &nf;
        %let f = %scan(&feature_cols, &i, %str( ));
        data _null_;
            length nm $64;
            nm  = lowcase("&f");
            bad = prxmatch('/^shap_|^id_|_id$|customer_id|account_id|application_id/', strip(nm)) > 0;
            call symputx('ok', not bad, 'L');
        run;
        %if &ok %then %do;
            %let vt = %seg_vartype(ds=_sg_dev, var=&f);
            %if &vt = N %then %do;
                data _fb_s1; set _sg_dev(keep=_y &f); where not missing(&f); _x = &f; run;
            %end;
            %else %do;
                proc sql;
                    create table _fb_s1 as
                    select a._y, b.enc as _x
                    from (select _y, coalescec(strip(&f), '__MISSING__') as v from _sg_dev) a
                    inner join (select coalescec(strip(&f), '__MISSING__') as v, mean(_y) as enc
                                from _sg_dev group by calculated v) b on a.v = b.v;
                quit;
            %end;

            data _fb_s0; strength = 0; run;
            %if %seg_nobs(_fb_s1) >= 2 %then %do;
                proc rank data=_fb_s1 out=_fb_s2 ties=mean; var _x; ranks _r; run;
                proc sql noprint;
                    select sum(_y = 1), sum(_y = 0), sum(case when _y = 1 then _r else 0 end) format=best32.
                      into :n1 trimmed, :n0 trimmed, :r1 trimmed from _fb_s2;
                quit;
                data _fb_s0;
                    n1 = &n1; n0 = &n0; r1 = &r1;
                    if n1 > 0 and n0 > 0 then strength = abs((r1 - n1 * (n1 + 1) / 2) / (n1 * n0) - 0.5);
                    else strength = 0;
                run;
            %end;
            data _fb_s3; set _fb_s0(keep=strength); length feature $64; feat_idx = &i; feature = "&f"; run;
            proc append base=_fb_str data=_fb_s3 force; run;
        %end;
    %end;

    proc sort data=_fb_str; by descending strength feat_idx; run;
    data _fb_str2; set _fb_str(obs=&max_features); run;
    proc sql noprint;
        select feature into :sg_fb_sel separated by ' ' from _fb_str2;
    quit;
    %put NOTE: seg_fb_strength - selected features: &sg_fb_sel;

%mend seg_fb_strength;

/* >>>>>>>>>>>>>>>> seg_fb_bins_num.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_fb_bins_num.sas
   Feature Binning bins for ONE numeric feature (build_numeric_bins):
     * a "<f> is Missing" bin if the missing share of dev >= min_bin_pct
     * supervised bins from a best-first CART on the non-missing dev rows
       (DecisionTreeClassifier(max_leaf_nodes=max_bins,
        min_samples_leaf=max(int(N*min_bin_pct), 20)), gini):
         - only attempted when #non-missing >= 2*min_samples_leaf
         - rows enter as float32; thresholds are midpoints of float32 values
         - repeatedly split the leaf with the largest impurity improvement until
           max_bins leaves (verified identical to sklearn on the demo features)
       Bin j = (t_j-1, t_j] (lower exclusive, upper INCLUSIVE); labels use the
       thresholds rounded to 3 dp like Python ("f <= 61.885", "a < f <= b").
   Appends to _fb_bin (bin_id, feat_idx, feature, btype, lower, upper, lo_inf,
   hi_inf, label). Requires global sg_fb_nbin (running bin counter).
   ============================================================================ */
%macro seg_fb_bins_num(f=, i=, max_bins=8, min_bin_pct=0.01);

    %local nmiss nn minleaf m k;

    proc sql noprint; select sum(missing(&f)) into :nmiss trimmed from _sg_dev; quit;
    %if %sysevalf(&nmiss / &sg_ndev >= &min_bin_pct) %then %do;
        %let sg_fb_nbin = %eval(&sg_fb_nbin + 1);
        data _fb_b1;
            length feature $64 btype $10 label $400;
            bin_id = &sg_fb_nbin; feat_idx = &i; feature = "&f"; btype = 'missing';
            lower = .; upper = .; lo_inf = 0; hi_inf = 0; label = "&f is Missing";
        run;
        proc append base=_fb_bin data=_fb_b1 force; run;
    %end;

    data _fb_x;
        set _sg_dev(keep=&f _y);
        where not missing(&f);
        _t = &f;
        %seg_f32(x=_t, into=_v)
    run;
    %let nn = %seg_nobs(_fb_x);
    data _null_; call symputx('minleaf', max(int(&sg_ndev * &min_bin_pct), 20), 'L'); run;

    %if &nn >= %eval(2 * &minleaf) %then %do;

        proc sql;
            create table _fb_d as
            select _v as v, count(*) as ni, sum(_y) as pi from _fb_x group by _v order by _v;
        quit;
        %let m = %seg_nobs(_fb_d);

        /* ---- best-first splitting over the distinct values ---- */
        data _fb_thr(keep=thr);
            array vv [&m] _temporary_;
            array cn [0:&m] _temporary_;
            array cp [0:&m] _temporary_;
            array lo [&max_bins] _temporary_;
            array hi [&max_bins] _temporary_;
            array im [&max_bins] _temporary_;
            array sp [&max_bins] _temporary_;
            cn[0] = 0; cp[0] = 0; ix = 0;
            do until(_e);
                set _fb_d end=_e;
                ix + 1; vv[ix] = v; cn[ix] = cn[ix - 1] + ni; cp[ix] = cp[ix - 1] + pi;
            end;
            nl = 1; lo[1] = 1; hi[1] = &m; L = 1; link ev;
            do while(nl < &max_bins);
                pick = 0; bimp = -1e300;
                do q = 1 to nl;
                    if sp[q] > 0 then if im[q] > bimp then do; bimp = im[q]; pick = q; end;
                end;
                if pick = 0 then leave;
                s = sp[pick];
                thr = vv[s] / 2 + vv[s + 1] / 2;
                output;
                hb = hi[pick];
                hi[pick] = s; nl + 1; lo[nl] = s + 1; hi[nl] = hb;
                L = pick; link ev;
                L = nl;   link ev;
            end;
            stop;
        ev:
            a = lo[L]; b = hi[L];
            nt = cn[b] - cn[a - 1]; pt = cp[b] - cp[a - 1];
            im[L] = .; sp[L] = 0;
            if nt >= 2 * &minleaf and pt > 0 and pt < nt then do;
                par = (pt ** 2 + (nt - pt) ** 2) / nt; bp = -1e300; bs = 0;
                do ii = a to b - 1;
                    if vv[ii + 1] > vv[ii] + 1e-7 then do;
                        nl_ = cn[ii] - cn[a - 1]; nr_ = nt - nl_;
                        if nl_ >= &minleaf and nr_ >= &minleaf then do;
                            pl = cp[ii] - cp[a - 1]; pr = pt - pl;
                            prox = (pl ** 2 + (nl_ - pl) ** 2) / nl_ + (pr ** 2 + (nr_ - pr) ** 2) / nr_;
                            if prox > bp then do; bp = prox; bs = ii; end;
                        end;
                    end;
                end;
                if bs > 0 then do; im[L] = bp - par; sp[L] = bs; end;
            end;
            return;
        run;
        proc sort data=_fb_thr; by thr; run;
        %let k = %seg_nobs(_fb_thr);

        /* ---- thresholds -> intervals (lower, upper] ---- */
        %if &k = 0 %then %do;
            data _fb_b2;
                length feature $64 btype $10 label $400;
                bin_id = &sg_fb_nbin + 1; feat_idx = &i; feature = "&f"; btype = 'numeric';
                lower = .; upper = .; lo_inf = 1; hi_inf = 1; label = "&f (all non-missing values)";
            run;
        %end;
        %else %do;
            data _fb_b2(keep=bin_id feat_idx feature btype lower upper lo_inf hi_inf label);
                array tt [&k] _temporary_;
                length feature $64 btype $10 label $400 _a _b $40;
                ix = 0;
                do until(_e);
                    set _fb_thr end=_e;
                    ix + 1; tt[ix] = thr;
                end;
                do j = 1 to &k + 1;
                    bin_id = &sg_fb_nbin + j; feat_idx = &i; feature = "&f"; btype = 'numeric';
                    lo_inf = (j = 1); hi_inf = (j = &k + 1);
                    /* NOT ifn(): it evaluates both arguments, so tt[0] / tt[k+1] would be read */
                    if lo_inf then lower = .; else lower = tt[j - 1];
                    if hi_inf then upper = .; else upper = tt[j];
                    if not lo_inf then do;
                        _a = strip(put(round(lower, 0.001), best15.));
                        if index(_a, '.') = 0 and index(upcase(_a), 'E') = 0 then _a = cats(_a, '.0');
                    end;
                    if not hi_inf then do;
                        _b = strip(put(round(upper, 0.001), best15.));
                        if index(_b, '.') = 0 and index(upcase(_b), 'E') = 0 then _b = cats(_b, '.0');
                    end;
                    if lo_inf then label = catx(' ', "&f", '<=', _b);
                    else if hi_inf then label = catx(' ', "&f", '>', _a);
                    else label = catx(' ', _a, '<', "&f", '<=', _b);
                    output;
                end;
                stop;
            run;
        %end;
        proc append base=_fb_bin data=_fb_b2 force; run;
        %let sg_fb_nbin = %eval(&sg_fb_nbin + &k + 1);
    %end;

%mend seg_fb_bins_num;

/* >>>>>>>>>>>>>>>> seg_fb_bins_cat.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_fb_bins_cat.sas
   Feature Binning bins for ONE character feature (build_categorical_bins):
     * categories (missing -> '__MISSING__') ordered by dev bad rate ascending
       (ties: alphabetical, which is what pandas' stable sort on the
       alphabetically grouped counts gives)
     * <= max_bins distinct values : one bin per category with dev share >=
       min_bin_pct; the '__MISSING__' category becomes btype 'missing'
       ("<f> is Missing"), the others "<f> = value"
     * more than max_bins values   : equal-count groups of the bad-rate-ordered
       categories (pd.qcut on the ranks into max_bins groups); a group whose dev
       share is below min_bin_pct is dropped; label "<f> IN (a, b, ...)"
   Appends to _fb_bin and to _fb_cat (bin_id, value) which lists the categories
   of every categorical bin. Requires global sg_fb_nbin.
   ============================================================================ */
%macro seg_fb_bins_cat(f=, i=, max_bins=8, min_bin_pct=0.01);

    %local m;

    proc sql;
        create table _fb_c0 as
        select coalescec(strip(&f), '__MISSING__') as value length=200,
               count(*) as cnt, mean(_y) as bad
        from _sg_dev
        group by calculated value
        order by bad, value;
    quit;
    %let m = %seg_nobs(_fb_c0);

    %if &m > 0 %then %do;

        data _fb_c1;
            set _fb_c0;
            r = _n_;
            share = cnt / &sg_ndev;
            %if &m <= &max_bins %then %do;
                grp = r;
            %end;
            %else %do;
                /* pd.qcut(rank, q=max_bins): numpy-linear edges of ranks 1..m, right-closed bins */
                array e [0:&max_bins] _e0-_e&max_bins;
                retain _e0-_e&max_bins;
                if _n_ = 1 then do;
                    do _j = 0 to &max_bins;
                        _p = ifn(_j = &max_bins, 1, _j * (1 / &max_bins));
                        _h = (&m - 1) * _p; _lo = floor(_h); _g = _h - _lo;
                        _a = _lo + 1; _b = min(_lo + 1, &m - 1) + 1; _d = _b - _a;
                        e[_j] = ifn(_g >= 0.5, _b - _d * (1 - _g), _a + _d * _g);
                    end;
                end;
                grp = 0;
                do _j = 1 to &max_bins - 1;
                    if e[_j] < r then grp = grp + 1;
                end;
                grp = grp + 1;
            %end;
        run;

        proc sql;
            create table _fb_g as
            select grp, sum(cnt) / &sg_ndev as gshare, min(r) as r0
            from _fb_c1 group by grp
            having sum(cnt) / &sg_ndev >= &min_bin_pct
            order by grp;
        quit;
        data _fb_g; set _fb_g; bin_ord = _n_; run;

        data _fb_b3(keep=bin_id feat_idx feature btype lower upper lo_inf hi_inf label);
            length feature $64 btype $10 label $400 _list $1000;
            set _fb_g;
            _list = '';
            _single = 0;
            %if &m <= &max_bins %then %do;
                /* one category per bin */
                _rr = r0;
                set _fb_c1(keep=r value rename=(r=_r2 value=_val)) point=_rr;
                _list = _val;
                _single = 1;
            %end;
            bin_id = &sg_fb_nbin + _n_; feat_idx = &i; feature = "&f";
            lower = .; upper = .; lo_inf = 0; hi_inf = 0;
            %if &m <= &max_bins %then %do;
                if _val = '__MISSING__' then do; btype = 'missing'; label = "&f is Missing"; end;
                else do; btype = 'categorical'; label = catx(' ', "&f", '=', _val); end;
            %end;
            %else %do;
                btype = 'categorical'; label = "&f IN (...)";
            %end;
            output;
        run;

        /* category membership of every categorical bin */
        proc sql;
            create table _fb_cm as
            select &sg_fb_nbin + g.bin_ord as bin_id, c.value
            from _fb_g g
                 inner join _fb_c1 c on c.grp = g.grp
            order by bin_id, c.r;
        quit;
        proc append base=_fb_cat data=_fb_cm force; run;

        /* multi-category labels: "f IN (a, b, ...)" in bad-rate order */
        %if &m > &max_bins %then %do;
            data _fb_lab(keep=bin_id _lab);
                set _fb_cm; by bin_id;
                length _lab $400;
                retain _lab;
                if first.bin_id then _lab = value; else _lab = catx(', ', _lab, value);
                if last.bin_id then output;
            run;
            proc sql;
                update _fb_b3 b set label =
                    (select case when l._lab = '__MISSING__' then "&f is Missing"
                                 else cats("&f", ' IN (', strip(l._lab), ')') end
                     from _fb_lab l where l.bin_id = b.bin_id);
            quit;
        %end;

        proc append base=_fb_bin data=_fb_b3 force; run;
        proc sql noprint; select count(*) into :m trimmed from _fb_g; quit;
        %let sg_fb_nbin = %eval(&sg_fb_nbin + &m);
    %end;

%mend seg_fb_bins_cat;

/* >>>>>>>>>>>>>>>> seg_fb_membership.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_fb_membership.sas
   Writes _sg_memb_dev / _sg_memb_mon (cand_id = bin_id, _rid) for every Feature
   Binning bin (bin_mask / _single_condition_mask):
     missing     : the feature is missing
     numeric     : not missing and lower < x <= upper   (open ends = infinite)
     categorical : value (missing -> '__MISSING__') is one of the bin's categories
   Bins of one feature are disjoint, so a row matches at most one bin per feature.
   Needs _fb_bin and _fb_cat; feature types are read from the data.
   ============================================================================ */
%macro seg_fb_membership(feature_cols=);

    %local nf i f vt side tab out nb;

    data _sg_memb_dev; length cand_id 8 _rid 8; stop; run;
    data _sg_memb_mon; length cand_id 8 _rid 8; stop; run;

    %let nf = %sysfunc(countw(&feature_cols, %str( )));
    %do i = 1 %to &nf;
        %let f = %scan(&feature_cols, &i, %str( ));
        %let vt = %seg_vartype(ds=_sg_dev, var=&f);

        proc sql noprint; select count(*) into :nb trimmed from _fb_bin where feature = "&f"; quit;
        %if &nb > 0 %then %do;
            %do side = 1 %to 2;
                %if &side = 1 %then %do; %let tab = _sg_dev; %let out = _sg_memb_dev; %end;
                %else %do; %let tab = _sg_mon; %let out = _sg_memb_mon; %end;

                %if &vt = N %then %do;
                    data _fb_mm(keep=cand_id _rid);
                        array bid [40] _temporary_;
                        array blo [40] _temporary_;
                        array bhi [40] _temporary_;
                        array bli [40] _temporary_;
                        array bhn [40] _temporary_;
                        array bty [40] $10 _temporary_;
                        if _n_ = 1 then do;
                            nb = 0;
                            do until(_e);
                                set _fb_bin(where=(feature = "&f")) end=_e;
                                nb + 1;
                                bid[nb] = bin_id; blo[nb] = lower; bhi[nb] = upper;
                                bli[nb] = lo_inf; bhn[nb] = hi_inf; bty[nb] = btype;
                            end;
                        end;
                        set &tab(keep=_rid &f);
                        do _k = 1 to nb;
                            if bty[_k] = 'missing' then do;
                                if missing(&f) then do; cand_id = bid[_k]; output; end;
                            end;
                            else if not missing(&f) then do;
                                if (bli[_k] or &f > blo[_k]) and (bhn[_k] or &f <= bhi[_k]) then do;
                                    cand_id = bid[_k]; output;
                                end;
                            end;
                        end;
                    run;
                %end;
                %else %do;
                    proc sql;
                        create table _fb_cat1 as
                        select c.bin_id, c.value from _fb_cat c, _fb_bin b
                        where c.bin_id = b.bin_id and b.feature = "&f";
                    quit;
                    data _fb_mm(keep=cand_id _rid);
                        length value $200;
                        if _n_ = 1 then do;
                            declare hash hc(dataset: "_fb_cat1");
                            hc.defineKey('value');
                            hc.defineData('bin_id');
                            hc.defineDone();
                            call missing(bin_id);
                        end;
                        set &tab(keep=_rid &f);
                        value = coalescec(strip(&f), '__MISSING__');
                        if hc.find() = 0 then do; cand_id = bin_id; output; end;
                    run;
                %end;
                proc append base=&out data=_fb_mm force; run;
            %end;
        %end;
    %end;

%mend seg_fb_membership;

/* >>>>>>>>>>>>>>>> seg_fb_calib.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_fb_calib.sas
   Feature Binning's own calibration diagnostics per candidate and side
   (compute_calibration_stats):
     ECE       : scores clipped to [1e-6, 1-1e-6], cut into 10 quantile bins
                 (pd.qcut, numpy-linear edges, duplicates dropped, right-closed);
                 ECE = sum_b (n_b/n) * |mean(score_b) - mean(target_b)|
                 (means use the UNclipped score, as Python does)
     intercept / slope : unregularised logistic regression of target on the
                 clipped RAW score (not on logit(score)) - PROC LOGISTIC MLE.
                 Python fits sklearn LogisticRegression(C=1e9, lbfgs,
                 max_iter=200), which approximates the same MLE; small
                 differences are expected where lbfgs stops early. Missing if
                 the segment has a single target class.
   NOTE: FB's "Calibration_Drift" in the combined output is the intercept shift,
   a different quantity from the A/E-ratio shift the other four techniques call
   Calibration_Drift (the A/E shift is also produced by the shared engine).
   mem_dev / mem_mon : cand_id, _y, _s        out: one row per candidate
   ============================================================================ */
%macro seg_fb_calib(mem_dev=, mem_mon=, out=);

    %local side tab sfx;

    %do side = 1 %to 2;
        %if &side = 1 %then %do; %let tab = &mem_dev; %let sfx = dev; %end;
        %else %do; %let tab = &mem_mon; %let sfx = mon; %end;

        /* ---- ECE ---- */
        data _fc_s;
            set &tab(keep=cand_id _y _s);
            sc = min(max(_s, 1e-6), 1 - 1e-6);
        run;
        proc sort data=_fc_s; by cand_id sc; run;
        %seg_quantile_t7_by(in=_fc_s, by=cand_id, var=sc, nbins=10, out=_fc_q);

        data _fc_e&sfx(keep=cand_id ece_&sfx);
            merge _fc_s _fc_q(keep=cand_id q0-q10);
            by cand_id;
            array q [0:10] q0-q10;
            array ue[11] _u1-_u11;
            array bn[10] _bn1-_bn10;
            array bs[10] _bs1-_bs10;
            array by_[10] _by1-_by10;
            retain nu ntot _u1-_u11 _bn1-_bn10 _bs1-_bs10 _by1-_by10;
            if first.cand_id then do;
                nu = 0;
                do _j = 0 to 10;
                    if nu = 0 then do; nu = 1; ue[1] = q[_j]; end;
                    else if q[_j] ne ue[nu] then do; nu + 1; ue[nu] = q[_j]; end;
                end;
                do _j = 1 to 10; bn[_j] = 0; bs[_j] = 0; by_[_j] = 0; end;
                ntot = 0;
            end;
            _b = 1;
            do _j = 2 to nu - 1;
                if sc > ue[_j] then _b + 1;
            end;
            bn[_b] + 1; bs[_b] + _s; by_[_b] + _y; ntot + 1;
            if last.cand_id then do;
                ece_&sfx = 0;
                do _j = 1 to nu - 1;
                    if bn[_j] > 0 then ece_&sfx = ece_&sfx + (bn[_j] / ntot) * abs(bs[_j] / bn[_j] - by_[_j] / bn[_j]);
                end;
                output;
            end;
        run;

        /* ---- logistic intercept / slope (candidates with both classes) ---- */
        proc sql;
            create table _fc_l as
            select cand_id, _y, min(max(_s, 1e-6), 1 - 1e-6) as sc
            from &tab
            where cand_id in (select cand_id from &tab group by cand_id
                              having min(_y) = 0 and max(_y) = 1)
            order by cand_id;
        quit;
        %if %seg_nobs(_fc_l) > 0 %then %do;
            ods select none;
            proc logistic data=_fc_l;
                by cand_id;
                model _y(event='1') = sc;
                ods output ParameterEstimates=_fc_pe;
            run;
            ods select all;
            proc sql;
                create table _fc_c&sfx as
                select cand_id,
                       max(case when upcase(Variable) = 'INTERCEPT' then Estimate else . end) as cal_&sfx._intercept,
                       max(case when upcase(Variable) = 'SC' then Estimate else . end) as cal_&sfx._slope
                from _fc_pe group by cand_id;
            quit;
        %end;
        %else %do;
            data _fc_c&sfx; length cand_id 8 cal_&sfx._intercept 8 cal_&sfx._slope 8; stop; run;
        %end;
    %end;

    data &out;
        merge _fc_edev _fc_emon _fc_cdev _fc_cmon;
        by cand_id;
        if missing(cal_dev_intercept) or missing(cal_mon_intercept) then delta_intercept = .;
        else delta_intercept = cal_mon_intercept - cal_dev_intercept;
        if missing(cal_dev_slope) or missing(cal_mon_slope) then delta_slope = .;
        else delta_slope = cal_mon_slope - cal_dev_slope;
        if missing(ece_dev) or missing(ece_mon) then delta_ece = .;
        else delta_ece = ece_mon - ece_dev;
    run;

%mend seg_fb_calib;

/* >>>>>>>>>>>>>>>> seg_fb_bootstrap.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_fb_bootstrap.sas
   Feature Binning significance (bootstrap_signed_difference / add_significance).
   For each candidate: n_iter times, resample the dev rows and the mon rows of
   the segment WITH replacement (independently) and record mon - dev for
     gini, ks, auc, br (bad rate), ece (fast_ece with 10 score bins whose edges
     are the deciles of the segment's combined clipped scores; unclipped means)
   Replicates where a metric is undefined (single class) are skipped for that
   metric. Per metric: 95% CI = 2.5/97.5 percentiles (numpy-linear), point =
   mean, p = min(1, 2*min(P(diff<=0), P(diff>=0))); no valid replicate => p = 1,
   CI missing. RNG: SAS RAND (streaminit seed) - NOT numpy's stream, so p-values
   and CIs agree with Python statistically, not draw-for-draw. With n_iter = 50
   the p-value resolution is coarse (0.04 steps) in BOTH implementations.
   Scale note: the replicate table has ~ n_iter * (n_dev+n_mon) rows per
   candidate; fine for bootstrap_top_n=40 on 5k-row data, use CAS or batching
   for very large data.
   cand : cand_id table (the candidates to bootstrap, premem mode)
   out  : cand_id, <m>_ci_low, <m>_ci_high, <m>_p for m in gini ks auc br ece
   ============================================================================ */
%macro seg_fb_bootstrap(cand=, n_iter=50, seed=42, out=);

    %local side mx m nm;

    %seg_membership(side=dev, cand=&cand, out=_fb_bd, cols=_rid _y _s);
    %seg_membership(side=mon, cand=&cand, out=_fb_bm, cols=_rid _y _s);
    proc sort data=_fb_bd; by cand_id; run;
    proc sort data=_fb_bm; by cand_id; run;

    /* decile edges of the segment's combined clipped scores (for ECE) */
    data _fb_sc;
        set _fb_bd(keep=cand_id _s) _fb_bm(keep=cand_id _s);
        sc = min(max(_s, 1e-6), 1 - 1e-6);
    run;
    proc sort data=_fb_sc; by cand_id sc; run;
    %seg_quantile_t7_by(in=_fb_sc, by=cand_id, var=sc, nbins=10, out=_fb_ed);

    %do side = 0 %to 1;
        %if &side = 0 %then %let m = _fb_bd; %else %let m = _fb_bm;
        proc sql noprint;
            select max(cnt) into :mx trimmed from (select count(*) as cnt from &m group by cand_id);
        quit;

        /* resample every candidate n_iter times (gid = cand_id*1000 + replicate) */
        data _fb_r&side(keep=gid cand_id _y _s);
            array ya [&mx] _temporary_;
            array sa [&mx] _temporary_;
            retain _init 0;
            if not _init then do; call streaminit(&seed + &side); _init = 1; end;
            n = 0;
            do until(last.cand_id);
                set &m(keep=cand_id _y _s);
                by cand_id;
                n + 1; ya[n] = _y; sa[n] = _s;
            end;
            do rep = 1 to &n_iter;
                gid = cand_id * 1000 + rep;
                do i = 1 to n;
                    pick = ceil(rand('uniform') * n);
                    _y = ya[pick]; _s = sa[pick];
                    output;
                end;
            end;
        run;

        /* AUC / KS per replicate */
        data _fb_rk&side(keep=cand_id _y _s);
            set _fb_r&side(keep=gid _y _s rename=(gid=cand_id));
        run;
        %seg_auc_ks(mem=_fb_rk&side, out=_fb_ak&side);

        /* bad rate and ECE (common decile edges) per replicate */
        data _fb_re&side(keep=gid br ece);
            array bn [10] _bn1-_bn10;
            array bs [10] _bs1-_bs10;
            array by_ [10] _by1-_by10;
            if _n_ = 1 then do;
                declare hash he(dataset: '_fb_ed');
                he.defineKey('cand_id');
                he.defineData('q0','q1','q2','q3','q4','q5','q6','q7','q8','q9','q10');
                he.defineDone();
                call missing(q0,q1,q2,q3,q4,q5,q6,q7,q8,q9,q10);
            end;
            set _fb_r&side(keep=gid cand_id _y _s);
            by gid notsorted;
            retain n ysum _bn1-_bn10 _bs1-_bs10 _by1-_by10;
            if first.gid then do;
                rc = he.find();
                n = 0; ysum = 0;
                do j = 1 to 10; bn[j] = 0; bs[j] = 0; by_[j] = 0; end;
            end;
            /* np.digitize on the UNCLIPPED score against edges built from clipped scores */
            b = 1;
            if _s >= q1 then b = 2; if _s >= q2 then b = 3; if _s >= q3 then b = 4;
            if _s >= q4 then b = 5; if _s >= q5 then b = 6; if _s >= q6 then b = 7;
            if _s >= q7 then b = 8; if _s >= q8 then b = 9; if _s >= q9 then b = 10;
            n + 1; ysum + _y; bn[b] + 1; bs[b] + _s; by_[b] + _y;
            if last.gid then do;
                br = ysum / n; ece = 0;
                do j = 1 to 10;
                    if bn[j] > 0 then ece = ece + (bn[j] / n) * abs(bs[j] / bn[j] - by_[j] / bn[j]);
                end;
                output;
            end;
        run;
        proc sort data=_fb_re&side; by gid; run;
    %end;

    /* per-replicate signed differences (mon - dev) */
    data _fb_diff(keep=cand_id gini ks auc br ece);
        merge _fb_ak0(rename=(cand_id=gid auc=auc0 ks=ks0))
              _fb_ak1(rename=(cand_id=gid auc=auc1 ks=ks1))
              _fb_re0(rename=(br=br0 ece=ece0))
              _fb_re1(rename=(br=br1 ece=ece1));
        by gid;
        cand_id = floor(gid / 1000);
        gini = ifn(missing(auc0) or missing(auc1), ., (2 * auc1 - 1) - (2 * auc0 - 1));
        ks   = ifn(missing(ks0) or missing(ks1), ., ks1 - ks0);
        auc  = ifn(missing(auc0) or missing(auc1), ., auc1 - auc0);
        br   = br1 - br0;
        ece  = ece1 - ece0;
    run;

    /* long form -> per candidate/metric summary */
    data _fb_long(keep=key cand_id mi v);
        set _fb_diff;
        array mm [5] gini ks auc br ece;
        do mi = 1 to 5;
            if not missing(mm[mi]) then do; v = mm[mi]; key = cand_id * 10 + mi; output; end;
        end;
    run;
    proc sort data=_fb_long; by key v; run;
    %seg_quantile_t7_by(in=_fb_long, by=key, var=v, nbins=40, out=_fb_lq);   /* q1 = 2.5%, q39 = 97.5% */
    proc sql;
        create table _fb_ls as
        select key, max(cand_id) as cand_id, max(mi) as mi, count(*) as nrep, mean(v) as point,
               sum(v <= 0) / count(*) as p_le, sum(v >= 0) / count(*) as p_ge
        from _fb_long group by key;
        create table _fb_lm as
        select s.cand_id, s.mi, q.q1 as ci_low, q.q39 as ci_high,
               min(1, 2 * min(s.p_le, s.p_ge)) as p
        from _fb_ls s inner join _fb_lq q on s.key = q.key;
    quit;

    /* every candidate x metric, defaults where no valid replicate */
    data _fb_mi; do mi = 1 to 5; output; end; run;
    proc sql;
        create table _fb_grid as
        select c.cand_id, m.mi from &cand c, _fb_mi m;
    quit;
    proc sql;
        create table _fb_all as
        select g.cand_id, g.mi, l.ci_low, l.ci_high, coalesce(l.p, 1) as p
        from _fb_grid g left join _fb_lm l on g.cand_id = l.cand_id and g.mi = l.mi;
    quit;

    proc sql;
        create table &out as
        select cand_id,
               max(case when mi = 1 then ci_low  end) as gini_ci_low,
               max(case when mi = 1 then ci_high end) as gini_ci_high,
               max(case when mi = 1 then p       end) as gini_p,
               max(case when mi = 2 then ci_low  end) as ks_ci_low,
               max(case when mi = 2 then ci_high end) as ks_ci_high,
               max(case when mi = 2 then p       end) as ks_p,
               max(case when mi = 3 then ci_low  end) as auc_ci_low,
               max(case when mi = 3 then ci_high end) as auc_ci_high,
               max(case when mi = 3 then p       end) as auc_p,
               max(case when mi = 4 then ci_low  end) as br_ci_low,
               max(case when mi = 4 then ci_high end) as br_ci_high,
               max(case when mi = 4 then p       end) as br_p,
               max(case when mi = 5 then ci_low  end) as ece_ci_low,
               max(case when mi = 5 then ci_high end) as ece_ci_high,
               max(case when mi = 5 then p       end) as ece_p
        from _fb_all group by cand_id order by cand_id;
    quit;

%mend seg_fb_bootstrap;

/* >>>>>>>>>>>>>>>> seg_fb_score.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_fb_score.sas
   Feature Binning's own scoring (techniques/feature_binning.score_segments).
   Differs from the shared seg_score_candidates:
     * significance = Benjamini-Hochberg over the five BOOTSTRAP p-values
       (gini, ks, auc, br, ece); significant = smallest adjusted p <= alpha;
       confidence = mean(1 - adjusted p)  (unadjusted pool: 0.5 / not significant)
     * Business_Impact_Score = exposure share clipped to [0,1]
     * deterioration_score = mean of the min-max normalised gini/ks/auc drops,
       |bad-rate shift| and |ECE shift| (diagnostic / tie-break only)
     * SIS, DIS and Root_Cause_Score use the same formulas as the shared engine
       but are normalised WITHIN THE POOL passed in.
   FB's deltas are dev - mon (positive = worse); the shared engine's are
   mon - dev, so fb_delta = -delta for gini/ks/auc.
   KNOWN PROPERTY OF THE PYTHON CODE (ported faithfully): the bootstrapped
   candidates and the remainder are scored by two SEPARATE calls, so their
   normalised scores are not on a common scale yet get ranked together.
   in  : cand_id + engine metrics (n_dev ... mean_shap_shift, delta_br,
         delta_ece, mon_weight_pct) + gini_p ks_p auc_p br_p ece_p
   out : in + fb_delta_*, deterioration_score, confidence_score, min_p_adj,
         significant, sis_raw, dis_raw, business_impact_score, psi_interpretation,
         root_cause_score_raw, final_score
   ============================================================================ */
%macro seg_fb_score(in=, out=, apply_bh=Y, alpha=0.10);

    %local m nmx;

    data _fs_a;
        set &in;
        fb_delta_gini = ifn(missing(delta_gini), ., -delta_gini);
        fb_delta_ks   = ifn(missing(delta_ks),   ., -delta_ks);
        fb_delta_auc  = ifn(missing(delta_auc),  ., -delta_auc);
        abs_delta_br  = abs(delta_br);
        abs_delta_ece = abs(delta_ece);
        auc_drop = ifn(missing(fb_delta_auc), 0, max(0, fb_delta_auc));
        conf     = min(1, sqrt(max(0, n_mon) / 100));
        ef       = ifn(mon_weight_pct > 0, mon_weight_pct, 1);
        sis_raw  = auc_drop * ef * pct_mon * conf;
        dis_raw  = max(0, (pct_mon - pct_dev) * auc_drop * ef * (1 + max(0, mean_feature_psi)));
        business_impact_score = min(max(coalesce(mon_weight_pct, 0), 0), 1);
    run;

    proc sql noprint;
        select min(fb_delta_gini) format=best32., max(fb_delta_gini) format=best32., min(fb_delta_ks) format=best32., max(fb_delta_ks) format=best32.,
               min(fb_delta_auc) format=best32., max(fb_delta_auc) format=best32., min(abs_delta_br) format=best32., max(abs_delta_br) format=best32.,
               min(abs_delta_ece) format=best32., max(abs_delta_ece) format=best32., min(sis_raw) format=best32., max(sis_raw) format=best32.,
               min(dis_raw) format=best32., max(dis_raw) format=best32., min(mean_feature_psi) format=best32., max(mean_feature_psi) format=best32.,
               min(mean_shap_shift) format=best32., max(mean_shap_shift) format=best32.
          into :g_lo trimmed, :g_hi trimmed, :k_lo trimmed, :k_hi trimmed, :a_lo trimmed, :a_hi trimmed,
               :b_lo trimmed, :b_hi trimmed, :e_lo trimmed, :e_hi trimmed, :s_lo trimmed, :s_hi trimmed,
               :d_lo trimmed, :d_hi trimmed, :p_lo trimmed, :p_hi trimmed, :h_lo trimmed, :h_hi trimmed
          from _fs_a;
    quit;

    %if %upcase(&apply_bh) = Y %then %do;
        %seg_bh(in=_fs_a, pvar=gini_p, adjvar=gini_padj, out=_fs_b1);
        %seg_bh(in=_fs_a, pvar=ks_p,   adjvar=ks_padj,   out=_fs_b2);
        %seg_bh(in=_fs_a, pvar=auc_p,  adjvar=auc_padj,  out=_fs_b3);
        %seg_bh(in=_fs_a, pvar=br_p,   adjvar=br_padj,   out=_fs_b4);
        %seg_bh(in=_fs_a, pvar=ece_p,  adjvar=ece_padj,  out=_fs_b5);
        proc sort data=_fs_a; by cand_id; run;
        data _fs_a;
            merge _fs_a _fs_b1 _fs_b2 _fs_b3 _fs_b4 _fs_b5;
            by cand_id;
        run;
    %end;

    data &out;
        set _fs_a;
        length psi_interpretation $20;
        /* normalise: zeros if range < 1e-9, NaN stays NaN */
        if &g_hi - &g_lo < 1e-9 then _gs = 0; else _gs = (fb_delta_gini - &g_lo) / (&g_hi - &g_lo);
        if &k_hi - &k_lo < 1e-9 then _ks = 0; else _ks = (fb_delta_ks   - &k_lo) / (&k_hi - &k_lo);
        if &a_hi - &a_lo < 1e-9 then _as = 0; else _as = (fb_delta_auc  - &a_lo) / (&a_hi - &a_lo);
        if &b_hi - &b_lo < 1e-9 then _bs = 0; else _bs = (abs_delta_br  - &b_lo) / (&b_hi - &b_lo);
        if &e_hi - &e_lo < 1e-9 then _es = 0; else _es = (abs_delta_ece - &e_lo) / (&e_hi - &e_lo);
        deterioration_score = mean(_gs, _ks, _as, _bs, _es);

        %if %upcase(&apply_bh) = Y %then %do;
            min_p_adj = min(gini_padj, ks_padj, auc_padj, br_padj, ece_padj);
            confidence_score = mean(1 - min(max(coalesce(gini_padj, 1), 0), 1),
                                    1 - min(max(coalesce(ks_padj,   1), 0), 1),
                                    1 - min(max(coalesce(auc_padj,  1), 0), 1),
                                    1 - min(max(coalesce(br_padj,   1), 0), 1),
                                    1 - min(max(coalesce(ece_padj,  1), 0), 1));
            significant = (not missing(min_p_adj)) and (min_p_adj <= &alpha);
        %end;
        %else %do;
            min_p_adj = .; confidence_score = 0.5; significant = 0;
        %end;

        if psi < 0.1 then psi_interpretation = 'Stable';
        else if psi <= 0.25 then psi_interpretation = 'Moderate Drift';
        else psi_interpretation = 'Significant Drift';

        if &s_hi - &s_lo < 1e-9 then _n1 = 0; else _n1 = (sis_raw - &s_lo) / (&s_hi - &s_lo);
        if &d_hi - &d_lo < 1e-9 then _n2 = 0; else _n2 = (dis_raw - &d_lo) / (&d_hi - &d_lo);
        if &p_hi - &p_lo < 1e-9 then _n3 = 0; else _n3 = (mean_feature_psi - &p_lo) / (&p_hi - &p_lo);
        if &h_hi - &h_lo < 1e-9 then _n4 = 0; else _n4 = (mean_shap_shift - &h_lo) / (&h_hi - &h_lo);
        root_cause_score_raw = 0.35 * _n1 + 0.30 * _n2 + 0.20 * _n3 + 0.15 * _n4;
        final_score = root_cause_score_raw * 20;
        drop _gs _ks _as _bs _es _n1-_n4 auc_drop conf ef;
    run;

%mend seg_fb_score;

/* >>>>>>>>>>>>>>>> seg_feature_binning.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_feature_binning.sas
   SAS port of techniques/feature_binning.py (FeatureBinningTechnique.run).

   1  seg_fb_strength   keep legitimate features, rank by |AUC-0.5|, top max_features
   2  bins              numeric: missing bin + best-first supervised bins
                        categorical: per-category or bad-rate-ordered groups
                        (seg_fb_bins_num / seg_fb_bins_cat)
   3  gates             dev and mon count >= max(30, int(N*min_bin_pct)) and
                        dev and mon share <= max_segment_pct   (NO event-count gate,
                        unlike the other four techniques)
   4  metrics           shared engine (AUC/Gini/KS, bad rate, PSI, exposure,
                        in-segment feature PSI, SHAP) + FB calibration/ECE
   5  bootstrap         the bootstrap_top_n candidates with the largest mean |delta|
                        get n_iter bootstrap p-values (seg_fb_bootstrap)
   6  score             bootstrapped pool and remainder scored SEPARATELY
                        (seg_fb_score), then ranked together by final score
   7  de-dup + top_n    Jaccard de-dup over the whole ranked list, keep top_n
   Public table differences vs the other techniques: Feature, Bin_Type,
   calibration intercept/slope/ECE columns, Significant (not
   Statistically_Significant), Overall_Score, no portfolio view. Root_Cause_Feature
   is the binned feature itself and Root_Cause_PSI its population-share PSI.
   Defaults equal models/config.FeatureBinningConfig.
   NOT reproducible bit-for-bit: bootstrap RNG (SAS RAND vs numpy), logistic
   intercept/slope optimiser. Bins, candidate pool and point metrics ARE exact.
   ============================================================================ */
%macro seg_feature_binning(dev=, mon=, target_col=, score_col=, weight_col=, feature_cols=, shap_cols=,
                           max_features=30, max_bins=8, min_bin_pct=0.01, max_segment_pct=0.35,
                           overlap_jaccard_threshold=0.70, top_n=20, bootstrap_top_n=40,
                           n_iter=50, alpha=0.10, seed=42, rca_name_filter=Y, out_prefix=seg_fb);

    %global sg_fb_nbin;
    %local nf i f vt mind minm nboot;

    %seg_prep(dev=&dev, mon=&mon, target_col=&target_col, score_col=&score_col,
              weight_col=&weight_col, feature_cols=&feature_cols, shap_cols=&shap_cols,
              max_segment_pct=&max_segment_pct, rca_name_filter=&rca_name_filter);
    %let sg_premem = Y;

    /* ---- 1. features ---- */
    %seg_fb_strength(feature_cols=&feature_cols, max_features=&max_features);

    /* ---- 2. bins ---- */
    data _fb_bin;
        length bin_id 8 feat_idx 8 feature $64 btype $10 lower 8 upper 8 lo_inf 8 hi_inf 8 label $400;
        stop;
    run;
    data _fb_cat; length bin_id 8 value $200; stop; run;
    %let sg_fb_nbin = 0;
    %let nf = %sysfunc(countw(&sg_fb_sel, %str( )));
    %do i = 1 %to &nf;
        %let f  = %scan(&sg_fb_sel, &i, %str( ));
        %let vt = %seg_vartype(ds=_sg_dev, var=&f);
        %if &vt = N %then %seg_fb_bins_num(f=&f, i=&i, max_bins=&max_bins, min_bin_pct=&min_bin_pct);
        %else %seg_fb_bins_cat(f=&f, i=&i, max_bins=&max_bins, min_bin_pct=&min_bin_pct);
    %end;
    %put NOTE: seg_feature_binning - &sg_fb_nbin candidate bins over &nf features.;

    %seg_fb_membership(feature_cols=&sg_fb_sel);
    data _fb_cand0(keep=cand_id); set _fb_bin; cand_id = bin_id; run;

    /* ---- 3. gates (point_estimate_metrics) ---- */
    data _null_;
        call symputx('mind', max(30, int(&sg_ndev * &min_bin_pct)), 'L');
        call symputx('minm', max(30, int(&sg_nmon * &min_bin_pct)), 'L');
    run;
    %seg_membership(side=dev, cand=_fb_cand0, out=_fb_ml_dev, cols=_y);
    %seg_membership(side=mon, cand=_fb_cand0, out=_fb_ml_mon, cols=_y);
    proc sql;
        create table _fb_surv as
        select d.cand_id
        from (select cand_id, count(*) as n from _fb_ml_dev group by cand_id) d
             inner join (select cand_id, count(*) as n from _fb_ml_mon group by cand_id) m
             on d.cand_id = m.cand_id
        where d.n >= &mind and m.n >= &minm
          and d.n / &sg_ndev <= &max_segment_pct and m.n / &sg_nmon <= &max_segment_pct
        order by d.cand_id;
    quit;

    proc datasets lib=work nolist nowarn; delete _sg_pool _sg_memmon_all _sg_rules_all _sg_fpsi_all; quit;

    %if %seg_nobs(_fb_surv) = 0 %then %do;
        %put NOTE: seg_feature_binning - no bin passed the count gates.;
        %seg_publish(technique=Feature Binning, out_prefix=&out_prefix, top_n=&top_n);
        %let sg_premem = N;
        %return;
    %end;

    /* ---- 4. metrics ---- */
    %seg_evaluate_candidates(cand=_fb_surv, out=_fb_ev, shap_cols=&shap_cols);
    %seg_fb_calib(mem_dev=_sg_mem_dev, mem_mon=_sg_mem_mon, out=_fb_cal);

    proc sql;
        create table _fb_pt as
        select e.*, c.cal_dev_intercept, c.cal_mon_intercept, c.delta_intercept,
               c.cal_dev_slope, c.cal_mon_slope, c.delta_slope, c.ece_dev, c.ece_mon, c.delta_ece,
               b.feat_idx, b.feature, b.btype, b.label as Segment_Definition,
               b.lower as bin_lower, b.upper as bin_upper
        from _fb_ev e left join _fb_cal c on e.cand_id = c.cand_id
             inner join _fb_bin b on e.cand_id = b.bin_id
        order by e.cand_id;
    quit;

    /* ---- 5. bootstrap the strongest candidates ---- */
    data _fb_rough;
        set _fb_pt(keep=cand_id delta_gini delta_ks delta_auc delta_br delta_ece);
        rough = mean(abs(delta_gini), abs(delta_ks), abs(delta_auc), abs(delta_br), abs(delta_ece));
        if missing(rough) then rough = 0;
    run;
    proc sort data=_fb_rough; by descending rough cand_id; run;
    data _fb_boot(keep=cand_id) _fb_rest(keep=cand_id);
        set _fb_rough;
        if _n_ <= &bootstrap_top_n then output _fb_boot; else output _fb_rest;
    run;
    %let nboot = %seg_nobs(_fb_boot);

    %seg_fb_bootstrap(cand=_fb_boot, n_iter=&n_iter, seed=&seed, out=_fb_bs);

    proc sort data=_fb_boot; by cand_id; run;
    proc sort data=_fb_rest; by cand_id; run;
    data _fb_p1;
        merge _fb_pt _fb_boot(in=_b) _fb_bs;
        by cand_id;
        if _b;
    run;
    data _fb_p2;
        merge _fb_pt _fb_rest(in=_r);
        by cand_id;
        if _r;
        array pp [15] gini_ci_low gini_ci_high gini_p ks_ci_low ks_ci_high ks_p auc_ci_low auc_ci_high
                      auc_p br_ci_low br_ci_high br_p ece_ci_low ece_ci_high ece_p;
        do _i = 1 to 15; pp[_i] = .; end;
        drop _i;
    run;

    /* ---- 6. score the two pools separately, rank together ---- */
    %seg_fb_score(in=_fb_p1, out=_fb_s1, apply_bh=Y, alpha=&alpha);
    %if %seg_nobs(_fb_p2) > 0 %then %do;
        %seg_fb_score(in=_fb_p2, out=_fb_s2, apply_bh=N, alpha=&alpha);
        data _fb_scored; set _fb_s1 _fb_s2; run;
    %end;
    %else %do;
        data _fb_scored; set _fb_s1; run;
    %end;

    /* ---- 7. de-dup over the whole ranked list, top_n ---- */
    data _sg_memmon_all(keep=cand_id _rid); set _sg_mem_mon; run;
    %seg_rank_dedup(in=_fb_scored, mem_mon=_sg_memmon_all, out=_fb_dd, overlap=&overlap_jaccard_threshold,
                    pool_size=%seg_nobs(_fb_scored), dedup=Y,
                    sortby=%str(descending final_score descending deterioration_score cand_id));

    data _fb_top; set _fb_dd(obs=&top_n); Rank = dedup_rank; run;

    /* ---- public tables ---- */
    data &out_prefix._segments;
        length Technique $40 Rank 8 Feature $64 Segment_Definition $400 Bin_Type $10;
        set _fb_top;
        Technique = 'Feature Binning';
        Feature = feature;
        Bin_Type = btype;
        Dev_Count = n_dev; Mon_Count = n_mon; Dev_Pct = pct_dev; Mon_Pct = pct_mon;
        PSI = psi; PSI_Interpretation = psi_interpretation;
        Dev_AUC = auc_dev; Mon_AUC = auc_mon; Delta_AUC = delta_auc;
        Dev_Gini = gini_dev; Mon_Gini = gini_mon; Delta_Gini = delta_gini;
        Dev_KS = ks_dev; Mon_KS = ks_mon; Delta_KS = delta_ks;
        Dev_BR = br_dev; Mon_BR = br_mon; Delta_BR = delta_br;
        Dev_Calibration_Intercept = cal_dev_intercept; Mon_Calibration_Intercept = cal_mon_intercept;
        Delta_Calibration_Intercept = delta_intercept;
        Dev_Calibration_Slope = cal_dev_slope; Mon_Calibration_Slope = cal_mon_slope;
        Delta_Calibration_Slope = delta_slope;
        Dev_ECE = ece_dev; Mon_ECE = ece_mon; Delta_ECE = delta_ece;
        Dev_EAD = weight_dev; Mon_EAD = weight_mon;
        Exposure_Pct = mon_weight_pct; Dev_Exposure_Pct = dev_weight_pct; Exposure_Drift = exposure_drift;
        Mon_Default_Count = x_mon;
        Deterioration_Score = deterioration_score; Confidence_Score = confidence_score;
        Significant = significant; SIS_Raw = round(sis_raw, 0.000001); DIS_Raw = round(dis_raw, 0.000001);
        Business_Impact_Score = business_impact_score;
        Overall_Score = final_score;
        Root_Cause_Feature = feature; Root_Cause_PSI = psi;
        Root_Cause_Score = round(root_cause_score_raw, 0.000001);
        keep Technique Rank Feature Segment_Definition Bin_Type Dev_Count Mon_Count Dev_Pct Mon_Pct
             PSI PSI_Interpretation Dev_AUC Mon_AUC Delta_AUC Dev_Gini Mon_Gini Delta_Gini
             Dev_KS Mon_KS Delta_KS Dev_BR Mon_BR Delta_BR Dev_Calibration_Intercept
             Mon_Calibration_Intercept Delta_Calibration_Intercept Dev_Calibration_Slope
             Mon_Calibration_Slope Delta_Calibration_Slope Dev_ECE Mon_ECE Delta_ECE Dev_EAD Mon_EAD
             Exposure_Pct Dev_Exposure_Pct Exposure_Drift Mon_Default_Count Deterioration_Score
             Confidence_Score Significant SIS_Raw DIS_Raw Business_Impact_Score Overall_Score
             Root_Cause_Feature Root_Cause_PSI Root_Cause_Score cand_id
             gini_ci_low gini_ci_high gini_p ks_ci_low ks_ci_high ks_p auc_ci_low auc_ci_high auc_p
             br_ci_low br_ci_high br_p ece_ci_low ece_ci_high ece_p min_p_adj
             mean_feature_psi mean_shap_shift top_drift_feature;
    run;

    %seg_fix_case(ds=&out_prefix._segments, names=Feature Significant PSI Delta_AUC Delta_Gini Delta_KS
                  Delta_BR);

    proc sql;
        /* exact bin definitions: numeric (lower, upper], missing, or one row per category */
        create table &out_prefix._rules as
        select t.Rank, t.cand_id, b.feature,
               case b.btype when 'numeric' then 'N' when 'missing' then 'M' else 'C' end as ptype length=1,
               b.lower, b.upper, b.lo_inf, b.hi_inf, c.value, b.label
        from _fb_top t inner join _fb_bin b on t.cand_id = b.bin_id
             left join _fb_cat c on b.bin_id = c.bin_id
        order by t.Rank, c.value;

        create table &out_prefix._feature_psi as
        select t.Rank, f.cand_id, f.feature, f.psi
        from _fb_top t inner join _sg_fpsi f on t.cand_id = f.cand_id
        order by t.Rank, f.feat_idx;
    quit;

    data &out_prefix._pool; set _fb_scored; run;

    data &out_prefix._log;
        technique = 'Feature Binning';
        total_dev_n = &sg_ndev; total_mon_n = &sg_nmon;
        features_evaluated = &nf; candidate_bins = &sg_fb_nbin;
        candidates_evaluated = %seg_nobs(_fb_pt); bootstrapped = &nboot;
        candidates_returned = %seg_nobs(&out_prefix._segments);
        run_datetime = datetime(); format run_datetime datetime20.;
    run;

    %let sg_premem = N;

%mend seg_feature_binning;

/* >>>>>>>>>>>>>>>> seg_cross_technique.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_cross_technique.sas
   Port of core/cross_technique_analysis.build_cross_technique_top10 over the
   techniques that produced segments:
     1  take each technique's worst 10 by Severity_Score (Feature Binning's
        Overall_Score plays that role; its Significant flag is the significance
        flag)
     2  collapse the same population found by several techniques into ONE row:
        fingerprint = (Dev_Count, Mon_Count, PSI, Delta_BR, Delta_Gini) rounded
        to 6 dp; keep the row with the highest Severity_Score, list every
        technique in Discovered_By, show the SHORTEST Segment_Definition
     3  Normalized_Root_Cause_Score = min-max of Root_Cause_Score over that pool
        (all equal => 0)
     4  top 10 by normalised score => Overall_Rank
   Severity_Score is comparable only WITHIN a technique; Root_Cause_Score (and
   its normalisation) is the cross-technique metric.
   prefixes : space-separated list of segment-table prefixes (<p>_segments)
   Outputs  : &out_prefix._combined (all returned segments, common columns)
              &out_prefix._cross_top10
   NOT included here: the per-technique head-to-head table (Overall_Score_100)
   and the executive-summary text (core/segment_insights); the LLM narrative
   stays outside SAS.
   ============================================================================ */
%macro seg_cross_technique(prefixes=, out_prefix=seg, per_technique_n=10, top_n=10);

    %local n i p dsid hasos rc rc_lo rc_hi;
    %let n = %sysfunc(countw(&prefixes, %str( )));

    data _xt_all;
        length Technique $40 Segment_Definition $1000 Root_Cause_Feature $64
               Dev_Count Mon_Count Dev_Pct Mon_Pct PSI Delta_BR Delta_Gini Delta_KS
               Severity_Score Root_Cause_Score Statistically_Significant Rank 8;
        stop;
    run;

    %do i = 1 %to &n;
        %let p = %scan(&prefixes, &i, %str( ));
        %if %seg_nobs(&p._segments) > 0 %then %do;
            %let dsid  = %sysfunc(open(&p._segments));
            %let hasos = %sysfunc(varnum(&dsid, Overall_Score));
            %let rc    = %sysfunc(close(&dsid));
            data _xt_one;
                set &p._segments;
                %if &hasos > 0 %then %do;
                    Severity_Score = Overall_Score;
                    Statistically_Significant = Significant;
                %end;
                keep Technique Segment_Definition Root_Cause_Feature Dev_Count Mon_Count Dev_Pct Mon_Pct
                     PSI Delta_BR Delta_Gini Delta_KS Severity_Score Root_Cause_Score
                     Statistically_Significant Rank;
            run;
            proc append base=_xt_all data=_xt_one force; run;
        %end;
    %end;

    data &out_prefix._combined; set _xt_all; run;

    /* 1. per-technique worst N by Severity_Score */
    proc sort data=_xt_all out=_xt_s; by Technique descending Severity_Score Rank; run;
    data _xt_w;
        set _xt_s; by Technique;
        if first.Technique then _k = 0;
        _k + 1;
        if _k <= &per_technique_n;
        drop _k;
    run;

    /* 2. same population found by several techniques */
    data _xt_f;
        set _xt_w;
        length fp $200;
        if missing(Dev_Count) or missing(Mon_Count) then fp = cats('row', put(_n_, best12.));
        else fp = catx('|', Dev_Count, Mon_Count, put(round(PSI, 1e-6), best20.),
                       put(round(Delta_BR, 1e-6), best20.), put(round(Delta_Gini, 1e-6), best20.));
    run;

    proc sort data=_xt_f out=_xt_fs; by fp Technique; run;
    data _xt_agg(keep=fp Discovered_By short_def);
        length Discovered_By $200 short_def $1000 prev $40;
        do until(last.fp);
            set _xt_fs; by fp;
            if first.fp then do;
                Discovered_By = Technique; short_def = Segment_Definition; prev = Technique;
            end;
            else do;
                if Technique ne prev then Discovered_By = catx(', ', Discovered_By, Technique);
                prev = Technique;
                if length(strip(Segment_Definition)) < length(strip(short_def)) then short_def = Segment_Definition;
            end;
        end;
        output;
    run;

    proc sort data=_xt_f out=_xt_fb; by fp descending Severity_Score; run;
    data _xt_best; set _xt_fb; by fp; if first.fp; run;
    data _xt_pool;
        merge _xt_best(in=_a) _xt_agg;
        by fp;
        if _a;
        Segment_Definition = short_def;
        drop short_def fp;
    run;

    /* 3 + 4. normalise Root_Cause_Score over the merged pool, rank */
    proc sql noprint;
        select min(coalesce(Root_Cause_Score, 0)) format=best32., max(coalesce(Root_Cause_Score, 0)) format=best32.
          into :rc_lo trimmed, :rc_hi trimmed from _xt_pool;
    quit;
    data _xt_n;
        set _xt_pool;
        _rc = coalesce(Root_Cause_Score, 0);
        if &rc_hi - &rc_lo > 1e-9 then Normalized_Root_Cause_Score = (_rc - &rc_lo) / (&rc_hi - &rc_lo);
        else Normalized_Root_Cause_Score = 0;
        drop _rc;
    run;
    proc sort data=_xt_n; by descending Normalized_Root_Cause_Score descending Severity_Score; run;
    data &out_prefix._cross_top10;
        set _xt_n(obs=&top_n);
        Overall_Rank = _n_;
    run;

%mend seg_cross_technique;

/* >>>>>>>>>>>>>>>> csb_segmentation_calc_wrapper.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   csb_segmentation_calc_wrapper.sas
   Entry point for auto-segmentation, the segmentation counterpart of
   csb_dq_dr_calc_wrapper. This is the macro a Cirrus-triggered job calls:
   inputs are two table references + plain macro parameters, outputs are WORK
   (or caller-library) tables with fixed names - no other coupling.

   techniques : space-separated subset of
       AUTOSLICER  DRIFT_TREE  GRADIENT_BOOSTING  KMEANS  FEATURE_BINNING
   Feature lists (space separated, in schema order):
       feature_cols      every legitimate feature (also the root-cause PSI list)
       numeric_cols      numeric features   \ used by the tree / cluster techniques
       categorical_cols  character features /  (build_feature_schema equivalent)
   Output tables, for each technique T with prefix
       AUTOSLICER -> &out_prefix._autoslicer      DRIFT_TREE -> &out_prefix._drifttree
       GRADIENT_BOOSTING -> &out_prefix._gradboost KMEANS -> &out_prefix._kmeans
       FEATURE_BINNING -> &out_prefix._featbin
     <prefix>_segments _rules _portfolio _feature_psi _pool _log
     (+ _selected_params for AutoSlicer, _k_diagnostics/_centroids/_encoding for
      K-Means; Feature Binning has no _portfolio)
   Cross-technique (when >= 1 technique returned segments):
       &out_prefix._combined   &out_prefix._cross_top10
   Run bookkeeping: &out_prefix._run_log (technique, status, message, seconds)

   Technique parameters are prefixed: as_ (AutoSlicer), dt_ (Drift Tree), gb_
   (Gradient Boosting), km_ (K-Means), fb_ (Feature Binning); defaults equal
   models/config.py. as_*_list parameters trigger the AutoSlicer grid search.
   A failed technique does not stop the others (status ERROR in the run log).
   ============================================================================ */
%macro csb_segmentation_calc_wrapper(dev_dta=, mon_dta=,
        techniques=AUTOSLICER DRIFT_TREE GRADIENT_BOOSTING KMEANS FEATURE_BINNING,
        target_col=, score_col=, weight_col=, feature_cols=, numeric_cols=, categorical_cols=,
        shap_cols=, top_n=10, min_events_per_slice=30, min_abs_count=, min_support=,
        significance_alpha=0.05, max_segment_pct=0.35, overlap_jaccard_threshold=0.70,
        rca_name_filter=Y,
        as_max_combo_depth=6, as_beam_width=30, as_numeric_bins=4,
        as_depth_list=, as_beam_list=, as_bins_list=,
        dt_max_depth=3, dt_min_samples_leaf=0.05,
        gb_n_estimators=100, gb_max_depth=3, gb_learning_rate=0.1, gb_min_samples_leaf=0.05,
        gb_max_trees_scanned=,
        km_k_min=2, km_k_max=12, km_min_cluster_pct=0.03, km_seed=42, km_max_tree_depth=4,
        km_drift_aware=Y, km_drift_weight=0.4, km_n_init=10,
        fb_max_features=30, fb_max_bins=8, fb_min_bin_pct=0.01, fb_top_n=20,
        fb_bootstrap_top_n=40, fb_n_iter=50, fb_alpha=0.10, fb_seed=42,
        out_prefix=seg);

    %local i t n t0 status msg ok prefixes pfx;
    %let prefixes = ;

    data &out_prefix._run_log;
        length technique $30 status $20 message $200 seconds 8;
        stop;
    run;

    %let n = %sysfunc(countw(&techniques, %str( )));
    %do i = 1 %to &n;
        %let t  = %upcase(%scan(&techniques, &i, %str( )));
        %let t0 = %sysfunc(datetime());
        %let status = OK;
        %let msg = ;
        %let syscc = 0;

        %if &t = AUTOSLICER %then %do;
            %let pfx = &out_prefix._autoslicer;
            %seg_autoslicer_grid(dev=&dev_dta, mon=&mon_dta, target_col=&target_col,
                score_col=&score_col, weight_col=&weight_col, feature_cols=&feature_cols,
                shap_cols=&shap_cols, depth_list=&as_depth_list, beam_list=&as_beam_list,
                bins_list=&as_bins_list, max_combo_depth=&as_max_combo_depth,
                beam_width=&as_beam_width, numeric_bins=&as_numeric_bins, top_n=&top_n,
                min_events_per_slice=&min_events_per_slice, min_abs_count=&min_abs_count,
                min_support=&min_support, significance_alpha=&significance_alpha,
                max_segment_pct=&max_segment_pct,
                overlap_jaccard_threshold=&overlap_jaccard_threshold,
                rca_name_filter=&rca_name_filter, out_prefix=&pfx);
        %end;
        %else %if &t = DRIFT_TREE %then %do;
            %let pfx = &out_prefix._drifttree;
            %seg_drift_tree(dev=&dev_dta, mon=&mon_dta, target_col=&target_col, score_col=&score_col,
                weight_col=&weight_col, feature_cols=&feature_cols, numeric_cols=&numeric_cols,
                categorical_cols=&categorical_cols, shap_cols=&shap_cols,
                max_depth=&dt_max_depth, min_samples_leaf=&dt_min_samples_leaf, top_n=&top_n,
                min_events_per_slice=&min_events_per_slice, min_abs_count=&min_abs_count,
                min_support=&min_support, significance_alpha=&significance_alpha,
                max_segment_pct=&max_segment_pct, rca_name_filter=&rca_name_filter, out_prefix=&pfx);
        %end;
        %else %if &t = GRADIENT_BOOSTING %then %do;
            %let pfx = &out_prefix._gradboost;
            %seg_gradient_boosting(dev=&dev_dta, mon=&mon_dta, target_col=&target_col,
                score_col=&score_col, weight_col=&weight_col, numeric_cols=&numeric_cols,
                categorical_cols=&categorical_cols, shap_cols=&shap_cols,
                n_estimators=&gb_n_estimators, max_depth=&gb_max_depth,
                learning_rate=&gb_learning_rate, min_samples_leaf=&gb_min_samples_leaf,
                max_trees_scanned=&gb_max_trees_scanned, top_n=&top_n,
                min_events_per_slice=&min_events_per_slice, min_abs_count=&min_abs_count,
                min_support=&min_support, significance_alpha=&significance_alpha,
                max_segment_pct=&max_segment_pct,
                overlap_jaccard_threshold=&overlap_jaccard_threshold,
                rca_name_filter=&rca_name_filter, out_prefix=&pfx);
        %end;
        %else %if &t = KMEANS %then %do;
            %let pfx = &out_prefix._kmeans;
            %seg_kmeans(dev=&dev_dta, mon=&mon_dta, target_col=&target_col, score_col=&score_col,
                weight_col=&weight_col, feature_cols=&feature_cols, numeric_cols=&numeric_cols,
                categorical_cols=&categorical_cols, shap_cols=&shap_cols,
                k_min=&km_k_min, k_max=&km_k_max, min_cluster_pct=&km_min_cluster_pct,
                seed=&km_seed, max_tree_depth=&km_max_tree_depth, drift_aware=&km_drift_aware,
                drift_weight=&km_drift_weight, n_init=&km_n_init, top_n=&top_n,
                min_events_per_slice=&min_events_per_slice, min_abs_count=&min_abs_count,
                min_support=&min_support, significance_alpha=&significance_alpha,
                max_segment_pct=&max_segment_pct, rca_name_filter=&rca_name_filter, out_prefix=&pfx);
        %end;
        %else %if &t = FEATURE_BINNING %then %do;
            %let pfx = &out_prefix._featbin;
            %seg_feature_binning(dev=&dev_dta, mon=&mon_dta, target_col=&target_col,
                score_col=&score_col, weight_col=&weight_col, feature_cols=&feature_cols,
                shap_cols=&shap_cols, max_features=&fb_max_features, max_bins=&fb_max_bins,
                min_bin_pct=&fb_min_bin_pct, max_segment_pct=&max_segment_pct,
                overlap_jaccard_threshold=&overlap_jaccard_threshold, top_n=&fb_top_n,
                bootstrap_top_n=&fb_bootstrap_top_n, n_iter=&fb_n_iter, alpha=&fb_alpha,
                seed=&fb_seed, rca_name_filter=&rca_name_filter, out_prefix=&pfx);
        %end;
        %else %do;
            %let pfx = ;
            %let status = NOT_RUN;
            %let msg = Unknown technique name;
            %put WARNING: csb_segmentation_calc_wrapper - unknown technique &t..;
        %end;

        %if &status = OK %then %do;
            %if &syscc > 4 %then %do;
                %let status = ERROR;
                %let msg = See log (SYSCC=&syscc);
            %end;
            %else %if %length(&pfx) %then %let prefixes = &prefixes &pfx;
        %end;

        proc sql;
            insert into &out_prefix._run_log
            values("&t", "&status", "&msg", %sysevalf(%sysfunc(datetime()) - &t0));
        quit;
    %end;

    %if %length(&prefixes) %then %do;
        %seg_cross_technique(prefixes=&prefixes, out_prefix=&out_prefix);
    %end;

    %put NOTE: csb_segmentation_calc_wrapper complete - see &out_prefix._run_log;

%mend csb_segmentation_calc_wrapper;

/* >>>>>>>>>>>>>>>> seg_compare_to_golden.sas <<<<<<<<<<<<<<<< */
/* ============================================================================
   seg_compare_to_golden.sas
   Parity check: SAS AutoSlicer output vs the Python reference written by
   sas_macros/parity/export_autoslicer_golden.py.

   Pool rows are matched on Segment_Definition; rows whose label differs only
   by display rounding (e.g. 33 vs 33.01, see seg_fmtnum) are matched on the
   fingerprint (n_dev, n_mon, x_dev, x_mon). Then the max absolute difference
   per metric is reported against a tolerance:
     tight  (default 1e-6): everything except the columns below
     loose  (default 5e-2): ks_dev ks_mon delta_ks (tie handling) and
            score_shift_pvalue / ScoreShift_pvalue_adj (asymptotic vs exact p)
   Round-off note: golden SIS/DIS/Severity are rounded to 4-6 dp in Python, so
   the tight tolerance for those is 1e-4 (tol_rounded).
   Prints PASS/FAIL per metric plus match counts and top-N order agreement.
   ============================================================================ */
%macro seg_compare_to_golden(golden_pool=, golden_top=, sas_pool=, sas_top=,
                             tol=1e-6, tol_rounded=1e-4, tol_loose=5e-2);

    %local num loose rounded i v n tolv;
    %let num = n_dev n_mon pct_dev pct_mon x_dev x_mon psi br_dev br_mon delta_br br_pvalue
               auc_dev auc_mon delta_auc gini_dev gini_mon delta_gini ks_dev ks_mon delta_ks
               score_shift_pvalue weight_dev weight_mon dev_weight_pct mon_weight_pct
               exposure_drift calibration_drift mean_feature_psi top_drift_psi mean_shap_shift
               BadRate_pvalue_adj ScoreShift_pvalue_adj Business_Impact_Score SIS_Raw DIS_Raw
               root_cause_score Severity_Score Portfolio_Impact_Score;
    %let loose   = ks_dev ks_mon delta_ks score_shift_pvalue ScoreShift_pvalue_adj;
    %let rounded = Business_Impact_Score SIS_Raw DIS_Raw root_cause_score Severity_Score Portfolio_Impact_Score;
    %let n = %sysfunc(countw(&num, %str( )));

    /* golden_pool / golden_top: a FILEREF (e.g. filesrvc) or a quoted-able server path */
    %if %sysfunc(fileref(&golden_pool)) = 0 %then %do;
        proc import datafile=&golden_pool out=_gp dbms=csv replace; guessingrows=max; run;
    %end;
    %else %do;
        proc import datafile="&golden_pool" out=_gp dbms=csv replace; guessingrows=max; run;
    %end;
    %if %sysfunc(fileref(&golden_top)) = 0 %then %do;
        proc import datafile=&golden_top out=_gt dbms=csv replace; guessingrows=max; run;
    %end;
    %else %do;
        proc import datafile="&golden_top" out=_gt dbms=csv replace; guessingrows=max; run;
    %end;

    data _gpk;
        set _gp;
        length g_label $1000 g_feat $64;
        g_label = Segment_Definition;
        g_feat  = top_drift_feature;
        g_sig   = (upcase(strip(vvalue(Statistically_Significant))) in ('TRUE', '1'));
        %do i = 1 %to &n; %let v = %scan(&num, &i, %str( )); g_&v = &v; %end;
        keep g_label g_feat g_sig g_:;
    run;

    data _spk;
        set &sas_pool;
        length s_label $1000 s_feat $64;
        s_label = Segment_Definition;
        s_feat  = top_drift_feature;
        s_sig   = Statistically_Significant;
        %do i = 1 %to &n; %let v = %scan(&num, &i, %str( )); s_&v = &v; %end;
        keep s_label s_feat s_sig s_:;
    run;

    proc sql;
        create table _cmA as select * from _gpk g inner join _spk s on g.g_label = s.s_label;
        create table _cmB as
            select * from (select * from _gpk where g_label not in (select s_label from _spk)) g
            inner join (select * from _spk where s_label not in (select g_label from _gpk)) s
            on g.g_n_dev = s.s_n_dev and g.g_n_mon = s.s_n_mon and g.g_x_dev = s.s_x_dev and g.g_x_mon = s.s_x_mon;
        create table _cmall as select * from _cmA outer union corr select * from _cmB;
        select (select count(*) from _gpk)  as golden_rows,
               (select count(*) from _spk)  as sas_rows,
               (select count(*) from _cmA)  as matched_by_label,
               (select count(*) from _cmB)  as matched_by_fingerprint
        from _gpk(obs=1);
    quit;

    data _cmd;
        set _cmall;
        %do i = 1 %to &n;
            %let v = %scan(&num, &i, %str( ));
            if missing(g_&v) and missing(s_&v) then d_&v = 0;
            else if missing(g_&v) or missing(s_&v) then d_&v = 9999;
            else d_&v = abs(g_&v - s_&v);
        %end;
        d_sig  = (g_sig ne s_sig);
        d_feat = (g_feat ne s_feat);
    run;

    proc means data=_cmd noprint;
        var d_:;
        output out=_cmmax(drop=_type_ _freq_) max=;
    run;

    proc transpose data=_cmmax out=_cmsum(rename=(_name_=metric col1=max_abs_diff)); run;

    data _cmsum;
        set _cmsum;
        length verdict $8;
        metric = substr(metric, 3);
        if metric in ('sig', 'feat') then tolv = 0;
        else if findw("&loose", strip(metric), ' ') then tolv = &tol_loose;
        else if findw("&rounded", strip(metric), ' ') then tolv = &tol_rounded;
        else tolv = &tol;
        verdict = ifc(max_abs_diff <= tolv, 'PASS', 'FAIL');
    run;

    title "Parity vs Python - max |SAS - Python| per metric (loose: tie-handling / asymptotic p)";
    proc print data=_cmsum noobs; var metric max_abs_diff tolv verdict; run;

    /* top-N: same segment at each rank?  by label, and by population (dev/mon counts) which is
       immune to the rounding difference in display labels */
    data _tops;
        merge _gt(keep=Segment_Definition Rank Dev_Count Mon_Count
                  rename=(Segment_Definition=g_def Rank=r Dev_Count=g_dc Mon_Count=g_mc))
              &sas_top(keep=Segment_Definition Rank Dev_Count Mon_Count
                  rename=(Segment_Definition=s_def Rank=r Dev_Count=s_dc Mon_Count=s_mc));
        by r;
        same_label = (g_def = s_def);
        same_pop   = (g_dc = s_dc and g_mc = s_mc);
    run;
    proc sql;
        select sum(same_label) as top_same_label, sum(same_pop) as top_same_population,
               count(*) as top_positions_compared from _tops;
    quit;
    title "Top-N by rank: Python vs SAS";
    proc print data=_tops noobs; var r g_def s_def g_dc s_dc g_mc s_mc same_label same_pop; run;
    title;

%mend seg_compare_to_golden;

%put NOTE: All segmentation macros compiled from seg_all_macros_bundle.sas;